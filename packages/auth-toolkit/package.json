{
  "name": "auth-toolkit",
  "version": "0.0.0",
  "private": false,
  "description": "Curated better-auth building blocks: one shared Auth Worker (Cloudflare D1 + KV), a client subpath for React session hooks, and a server subpath for backend-to-backend verification",
  "keywords": [
    "better-auth",
    "auth",
    "cloudflare",
    "d1",
    "kv",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./database/d1": {
      "types": "./dist/infra/primary/sqlite/d1/database/index.d.ts",
      "default": "./dist/infra/primary/sqlite/d1/database/index.js"
    },
    "./database/memory": {
      "types": "./dist/infra/primary/sqlite/memory/index.d.ts",
      "default": "./dist/infra/primary/sqlite/memory/index.js"
    },
    "./secondary/cf-kv": {
      "types": "./dist/infra/secondary/cf-kv/session-store/index.d.ts",
      "default": "./dist/infra/secondary/cf-kv/session-store/index.js"
    },
    "./secondary/memory": {
      "types": "./dist/infra/secondary/memory/index.d.ts",
      "default": "./dist/infra/secondary/memory/index.js"
    },
    "./alchemy/d1": {
      "types": "./dist/infra/primary/sqlite/d1/resource/index.d.ts",
      "default": "./dist/infra/primary/sqlite/d1/resource/index.js"
    },
    "./alchemy/cf-kv": {
      "types": "./dist/infra/secondary/cf-kv/resource/index.d.ts",
      "default": "./dist/infra/secondary/cf-kv/resource/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json && cp -R src/infra/primary/sqlite/migration/migrations dist/infra/primary/sqlite/migration/",
    "db:generate": "auth generate --config ./auth.generate.ts --output ./src/infra/primary/sqlite/schema/schema.generated.ts --adapter drizzle --dialect sqlite -y && pnpm fmt && drizzle-kit generate",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.72",
    "better-sqlite3": "13.0.3",
    "effect": "4.0.0-rc.110",
    "react": "19.2.8"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "alchemy": "catalog:",
    "auth": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
