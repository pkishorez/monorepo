{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/components/blocks/hello.tsx",
    "src/cosmos.decorator.tsx",
    "src/css.d.ts",
    "src/styles"
  ],
  "layers": {
    "blocks": {
      "paths": ["src/components/blocks"],
      "description": "Feature-level components composed from UI primitives"
    },
    "ui": {
      "paths": ["src/components/ui"],
      "description": "Reusable presentational primitives built on hooks and utilities"
    },
    "form": {
      "paths": ["src/form"],
      "description": "Form components and field bindings composed from UI primitives"
    },
    "hooks": {
      "paths": ["src/hooks"],
      "description": "Reusable React hooks"
    },
    "lib": {
      "paths": ["src/lib"],
      "description": "Shared utilities and framework adapters"
    }
  },
  "modules": {
    "src/components/blocks/file-tree": { "shared": true },
    "src/components/blocks/json": { "shared": true },
    "src/components/blocks/laymos": {},
    "src/components/blocks/otel-trace-viewer": {},
    "src/components/blocks/sequence": {},
    "src/components/blocks/source-viewer": { "shared": true },
    "src/components/blocks/state-machine-visualizer": {},
    "src/components/blocks/swim-lane": {},
    "src/components/blocks/tanstack-sync-devtools": {},
    "src/components/ui/accordion.tsx": {},
    "src/components/ui/alert-dialog.tsx": {},
    "src/components/ui/alert.tsx": {},
    "src/components/ui/aspect-ratio.tsx": {},
    "src/components/ui/avatar.tsx": {},
    "src/components/ui/badge.tsx": {},
    "src/components/ui/breadcrumb.tsx": {},
    "src/components/ui/button-group.tsx": {},
    "src/components/ui/button.tsx": { "shared": true },
    "src/components/ui/calendar.tsx": {},
    "src/components/ui/card.tsx": {},
    "src/components/ui/carousel.tsx": {},
    "src/components/ui/chart.tsx": {},
    "src/components/ui/checkbox.tsx": {},
    "src/components/ui/collapsible.tsx": {},
    "src/components/ui/combobox.tsx": {},
    "src/components/ui/command.tsx": {},
    "src/components/ui/context-menu.tsx": {},
    "src/components/ui/dialog.tsx": { "shared": true },
    "src/components/ui/direction.tsx": {},
    "src/components/ui/drawer.tsx": {},
    "src/components/ui/dropdown-menu.tsx": { "shared": true },
    "src/components/ui/empty.tsx": {},
    "src/components/ui/field.tsx": {},
    "src/components/ui/file-tree.tsx": {},
    "src/components/ui/google-button.tsx": {},
    "src/components/ui/hover-card.tsx": {},
    "src/components/ui/input-group.tsx": { "shared": true },
    "src/components/ui/input-otp.tsx": {},
    "src/components/ui/input.tsx": { "shared": true },
    "src/components/ui/item.tsx": {},
    "src/components/ui/kbd.tsx": {},
    "src/components/ui/label.tsx": { "shared": true },
    "src/components/ui/menubar.tsx": {},
    "src/components/ui/message-scroller.tsx": {},
    "src/components/ui/message.tsx": {},
    "src/components/ui/native-select.tsx": {},
    "src/components/ui/navigation-menu.tsx": {},
    "src/components/ui/pagination.tsx": {},
    "src/components/ui/popover.tsx": {},
    "src/components/ui/progress.tsx": {},
    "src/components/ui/radio-group.tsx": {},
    "src/components/ui/resizable.tsx": {},
    "src/components/ui/scroll-area.tsx": { "shared": true },
    "src/components/ui/select.tsx": {},
    "src/components/ui/separator.tsx": { "shared": true },
    "src/components/ui/sheet.tsx": { "shared": true },
    "src/components/ui/sidebar.tsx": {},
    "src/components/ui/skeleton.tsx": { "shared": true },
    "src/components/ui/slider.tsx": {},
    "src/components/ui/sonner.tsx": {},
    "src/components/ui/spinner.tsx": {},
    "src/components/ui/switch.tsx": {},
    "src/components/ui/table.tsx": {},
    "src/components/ui/tabs.tsx": {},
    "src/components/ui/textarea.tsx": { "shared": true },
    "src/components/ui/toggle-group.tsx": {},
    "src/components/ui/toggle.tsx": { "shared": true },
    "src/components/ui/tooltip.tsx": { "shared": true },
    "src/form": {},
    "src/hooks/use-mobile.ts": {},
    "src/hooks/use-scroll.ts": {},
    "src/lib/lucide.ts": {},
    "src/lib/motion.ts": {},
    "src/lib/scrollStyles.ts": {},
    "src/lib/shadow-dom.tsx": {},
    "src/lib/utils.ts": { "shared": true }
  },
  "layerGraphs": {
    "frontend": {
      "description": "Frontend component architecture",
      "rules": {
        "blocks": ["ui"],
        "form": ["ui"],
        "ui": ["hooks", "lib"]
      }
    }
  }
}
