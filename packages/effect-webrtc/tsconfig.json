{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@kstackz/effect-webrtc": ["./src/effect-webrtc/index.ts"],
      "@kstackz/effect-webrtc/platform/browser": [
        "./src/platform/browser/index.ts"
      ],
      "@kstackz/effect-webrtc/platform/memory": [
        "./src/platform/memory/index.ts"
      ],
      "@kstackz/effect-webrtc/platform/werift": [
        "./src/platform/werift/index.ts"
      ],
      "@kstackz/effect-webrtc/signaling/memory": [
        "./src/signaling/memory/index.ts"
      ],
      "@kstackz/effect-webrtc/signaling/nostr": [
        "./src/signaling/nostr/index.ts"
      ],
      "@kstackz/effect-webrtc/signaling/durable": [
        "./src/signaling/durable/index.ts"
      ],
      "@kstackz/effect-webrtc/signaling/durable/rpc": [
        "./src/signaling/durable/rpc/index.ts"
      ],
      "@kstackz/effect-webrtc/signaling/durable/worker": [
        "./src/signaling/durable/worker/index.ts"
      ],
      "@kstackz/effect-webrtc/signaling/durable/alchemy": [
        "./src/signaling/durable/alchemy/index.ts"
      ]
    },
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "stories/**/*"],
  "exclude": ["node_modules"]
}
