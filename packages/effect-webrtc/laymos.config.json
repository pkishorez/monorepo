{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "fileModules": [
    "src/platform/browser-compatible.ts",
    "src/platform/platform.ts",
    "src/signaling/signaling.ts"
  ],
  "rules": {
    "src/effect-webrtc": [
      "src/negotiation",
      "src/peer-identity",
      "src/platform",
      "src/rpc",
      "src/signaling",
      "src/tracing"
    ],
    "src/platform": ["src/negotiation"],
    "src/platform/browser": ["src/platform/browser-compatible.ts"],
    "src/platform/browser-compatible.ts": ["src/platform/platform.ts"],
    "src/platform/memory": ["src/platform/platform.ts"],
    "src/platform/werift": ["src/platform/browser-compatible.ts"],
    "src/rpc": [
      "src/negotiation",
      "src/peer-identity",
      "src/platform",
      "src/tracing"
    ],
    "src/signaling": ["src/negotiation", "src/peer-identity"],
    "src/signaling/durable": ["src/signaling/signaling.ts"],
    "src/signaling/durable/alchemy": [
      "src/signaling/durable/rpc",
      "src/signaling/durable/worker"
    ],
    "src/signaling/durable/worker": ["src/signaling/durable/rpc"],
    "src/signaling/memory": ["src/signaling/signaling.ts"],
    "src/signaling/nostr": ["src/signaling/signaling.ts"],
    "src/tracing": ["src/negotiation", "src/peer-identity"]
  }
}
