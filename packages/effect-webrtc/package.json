{
  "name": "effect-webrtc",
  "version": "0.0.1",
  "private": false,
  "description": "Effect-native peer sessions and RPC over WebRTC data channels",
  "keywords": ["effect", "rpc", "webrtc", "peer-to-peer"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "packages/effect-webrtc"
  },
  "type": "module",
  "files": ["README.md", "LICENSE", "dist/"],
  "exports": {
    ".": {
      "types": "./dist/effect-webrtc/index.d.ts",
      "default": "./dist/effect-webrtc/index.js"
    },
    "./signaling": {
      "types": "./dist/signaling/signaling.d.ts",
      "default": "./dist/signaling/signaling.js"
    },
    "./signaling/memory": {
      "types": "./dist/signaling/memory/index.d.ts",
      "default": "./dist/signaling/memory/index.js"
    },
    "./signaling/nostr": {
      "types": "./dist/signaling/nostr/index.d.ts",
      "default": "./dist/signaling/nostr/index.js"
    },
    "./signaling/durable": {
      "types": "./dist/signaling/durable/index.d.ts",
      "default": "./dist/signaling/durable/index.js"
    },
    "./signaling/durable/rpc": {
      "types": "./dist/signaling/durable/rpc/index.d.ts",
      "default": "./dist/signaling/durable/rpc/index.js"
    },
    "./signaling/durable/worker": {
      "types": "./dist/signaling/durable/worker/index.d.ts",
      "default": "./dist/signaling/durable/worker/index.js"
    },
    "./signaling/durable/alchemy": {
      "types": "./dist/signaling/durable/alchemy/index.d.ts",
      "default": "./dist/signaling/durable/alchemy/index.js"
    },
    "./platform": {
      "types": "./dist/platform/platform.d.ts",
      "default": "./dist/platform/platform.js"
    },
    "./platform/memory": {
      "types": "./dist/platform/memory/index.d.ts",
      "default": "./dist/platform/memory/index.js"
    },
    "./platform/werift": {
      "types": "./dist/platform/werift/index.d.ts",
      "default": "./dist/platform/werift/index.js"
    },
    "./platform/browser": {
      "types": "./dist/platform/browser/index.d.ts",
      "default": "./dist/platform/browser/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "default": "./dist/rpc/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "stories": "laymos stories",
    "test": "vitest run"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  },
  "dependencies": {
    "@pkishorez/flow": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "auth-toolkit": "workspace:*",
    "nostr-tools": "catalog:",
    "rpc-toolkit": "workspace:*",
    "werift": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@typescript/native": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
