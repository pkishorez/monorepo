{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "storiesPath": "stories",
  "rules": {
    "src/core/binding": ["src/core/key"],
    "src/core/key-input": ["src/core/key"],
    "src/core/keymap": ["src/core/binding", "src/core/key"],
    "src/core/provider": [
      "src/core/binding",
      "src/core/key",
      "src/core/key-input",
      "src/core/keymap"
    ],
    "src/recognizers": ["src/core"],
    "src/surfaces": ["src/core"],
    "src/surfaces/store": ["src/surfaces/definition"]
  }
}
