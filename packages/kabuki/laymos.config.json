{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/start/tests/app", "src/start/tests/bare"],
  "rules": {
    "src/core/snapshot": ["src/core/actor"],
    "src/core/history": ["src/core/actor", "src/core/snapshot"],
    "src/core/runtime": [
      "src/core/actor",
      "src/core/snapshot",
      "src/core/history"
    ],
    "src/react": ["src/core"],
    "src/react/app": ["src/react/view"],
    "src/routing": ["src/core", "src/react"],
    "src/routing/router": [
      "src/routing/route",
      "src/routing/capabilities",
      "src/routing/page"
    ],
    "src/start/server": [
      "src/core",
      "src/react",
      "src/routing",
      "src/start/common",
      "src/start/platform"
    ],
    "src/start/client": [
      "src/core",
      "src/react",
      "src/routing",
      "src/start/common"
    ],
    "src/start/vite": ["src/start/common", "src/start/platform"],
    "src/start/common": ["src/core", "src/react", "src/routing"],
    "src/routing/capabilities": ["src/routing/route"],
    "src/routing/page": ["src/routing/route", "src/routing/capabilities"]
  },
  "exceptions": [
    {
      "from": "src/start/platform/cloudflare",
      "to": "src/start/platform",
      "because": "An adapter implements the port its platform declares: it imports the Platform, Host and Handler types it fills, and nothing else of its parent."
    },
    {
      "from": "src/start/platform/nitro",
      "to": "src/start/platform",
      "because": "An adapter implements the port its platform declares: it imports the Platform, Host and Handler types it fills, and nothing else of its parent."
    },
    {
      "from": "src/routing/router/adapter/browser",
      "to": "src/routing/router/adapter",
      "because": "An adapter implements the port its parent declares: it imports the Adapter it fills, and nothing else of its parent."
    },
    {
      "from": "src/routing/router/adapter/tanstack",
      "to": "src/routing/router/adapter",
      "because": "An adapter implements the port its parent declares: it imports the Adapter it fills, and nothing else of its parent."
    }
  ]
}
