{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "rules": {
    "src/core/snapshot": ["src/core/actor"],
    "src/core/history": ["src/core/actor", "src/core/snapshot"],
    "src/core/runtime": [
      "src/core/actor",
      "src/core/snapshot",
      "src/core/history"
    ],
    "src/react": ["src/core"],
    "src/routing": ["src/core", "src/react"],
    "src/routing/router": ["src/routing/route", "src/routing/adapter"],
    "src/routing/browser": ["src/routing/adapter"],
    "src/routing/tanstack": ["src/routing/adapter"]
  }
}
