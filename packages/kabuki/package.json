{
  "name": "@kestack/kabuki",
  "version": "0.0.2",
  "private": false,
  "description": "An app as one tree of Actors outside React: each Actor a small state machine driven by Messages, one immutable Snapshot for the whole app, Effect running the work, and React only drawing it.",
  "keywords": [
    "effect",
    "react",
    "elm",
    "state-machine",
    "actor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "packages/kabuki"
  },
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "default": "./dist/routing/index.js"
    },
    "./routing/adapter": {
      "types": "./dist/routing/adapter/index.d.ts",
      "default": "./dist/routing/adapter/index.js"
    },
    "./routing/adapter/browser": {
      "types": "./dist/routing/adapter/browser/index.d.ts",
      "default": "./dist/routing/adapter/browser/index.js"
    },
    "./routing/adapter/tanstack": {
      "types": "./dist/routing/adapter/tanstack/index.d.ts",
      "default": "./dist/routing/adapter/tanstack/index.js"
    },
    "./start": {
      "types": "./dist/start/common/common.d.ts",
      "default": "./dist/start/common/common.js"
    },
    "./start/server": {
      "types": "./dist/start/server/index.d.ts",
      "default": "./dist/start/server/index.js"
    },
    "./start/client": {
      "types": "./dist/start/client/index.d.ts",
      "default": "./dist/start/client/index.js"
    },
    "./start/platform": {
      "types": "./dist/start/platform/index.d.ts",
      "default": "./dist/start/platform/index.js"
    },
    "./start/platform/cloudflare": {
      "types": "./dist/start/platform/cloudflare/index.d.ts",
      "default": "./dist/start/platform/cloudflare/index.js"
    },
    "./start/platform/nitro": {
      "types": "./dist/start/platform/nitro/index.d.ts",
      "default": "./dist/start/platform/nitro/index.js"
    },
    "./start/vite": {
      "types": "./dist/start/vite/index.d.ts",
      "default": "./dist/start/vite/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && pnpm css && tsc -p tsconfig.build.json",
    "css": "node scripts/devtools-css.mts",
    "fmt": "vp fmt",
    "lint": "vp check && tsc --noEmit && laymos lint",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "motion": "13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "jsdom": "catalog:",
    "laymos": "workspace:*",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
