// Builds the devtools' own stylesheet: Tailwind over src/devtools alone,
// from src/devtools/devtools.css, minified into src/devtools/styles.gen.ts
// as a string the devtools put in their shadow root. Run by `pnpm build`,
// and `pnpm css` after changing a class.
import { readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { compile, optimize } from '@tailwindcss/node';
import { Scanner } from '@tailwindcss/oxide';

const dir = fileURLToPath(new URL('../src/devtools/', import.meta.url));
const input = `${dir}devtools.css`;

/*
 * `@property` is not read in a shadow root, so every `--tw-*` property it
 * would register is given its initial value on every element instead: the
 * fallback Tailwind writes for browsers without `@property`, unwrapped
 * from the `@supports` that guards it.
 */
const forShadowRoot = (css: string) =>
  css
    .replace(/@property\s+--[\w-]+\s*\{[^}]*\}/g, '')
    .replace(
      /@supports\s*\([^{]*?\)\s*\{(\s*\*\s*,[^{]*\{[^}]*\})\s*\}/g,
      '$1',
    );

export const devtoolsCss = async (): Promise<string> => {
  const compiler = await compile(readFileSync(input, 'utf8'), {
    base: dir,
    from: input,
    onDependency: () => {},
  });
  const scanner = new Scanner({ sources: compiler.sources });
  const built = compiler.build(scanner.scan());
  return forShadowRoot(optimize(built, { minify: true }).code);
};

export const devtoolsModule = (css: string) =>
  `// Generated by scripts/devtools-css.mts from devtools.css. Do not edit.\nexport const css = ${JSON.stringify(css)};\n`;

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  const css = await devtoolsCss();
  writeFileSync(`${dir}styles.gen.ts`, devtoolsModule(css));
  console.log(`devtools css: ${(css.length / 1024).toFixed(1)} kB`);
}
