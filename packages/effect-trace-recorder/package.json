{
  "name": "@pkishorez/effect-trace-recorder",
  "version": "0.0.1",
  "private": false,
  "description": "In-process span and log recorder for Effect programs, capturing OTel-shaped traces without an exporter",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "fmt": "vp fmt",
    "lint": "vp check src package.json tsconfig.json && pnpm lint:tsc",
    "lint:tsc": "tsc --noEmit",
    "test": "vp test src",
    "test:watch": "vp test src --watch"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.101"
  },
  "publishConfig": {
    "access": "public"
  }
}
