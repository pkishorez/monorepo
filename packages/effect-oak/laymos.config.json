{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "rules": {
    "src/core/tree": ["src/core/node"],
    "src/core/log": ["src/core/node"],
    "src/core/replay": ["src/core/node", "src/core/tree", "src/core/log"],
    "src/core/runtime": [
      "src/core/node",
      "src/core/tree",
      "src/core/log",
      "src/core/replay"
    ],
    "src/react": ["src/core"]
  }
}
