{
  "name": "@kstackz/use-gesture",
  "version": "0.0.0",
  "private": false,
  "description": "Touch gestures: a platform-free core that reads every finger of a touch from any touch source, and React bindings for the web, with every finger as motion values in nested zones that own touch.",
  "keywords": [
    "react",
    "gestures",
    "touch",
    "motion"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "packages/use-gesture"
  },
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "SKILL.md",
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "fmt": "vp fmt",
    "lint": "vp check && tsc --noEmit && tsc --noEmit -p tsconfig.core.json && laymos lint",
    "test": "vitest run"
  },
  "peerDependencies": {
    "motion": "13.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "laymos": "workspace:*",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
