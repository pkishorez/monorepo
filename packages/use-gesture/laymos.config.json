{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "storiesPath": "stories",
  "fileModules": ["src/index.ts"],
  "rules": {
    "src/core/provider": ["src/core/direction"],
    "src/core/swipe": ["src/core/direction"],
    "src/core/thumb-lock": ["src/core/direction", "src/core/provider"],
