{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/virtual.d.ts", "src/vite/tests"],
  "layers": {
    "shared": {
      "paths": ["src/shared"],
      "description": "The words of the problem: Build ID, cache names, manifest, Strategy rules, config, commands. Pure; no I/O.",
      "modules": {
        "src/shared/build": {
          "shared": true,
          "exposed": true
        },
        "src/shared/manifest": {
          "shared": true,
          "exposed": true
        },
        "src/shared/strategy": {
          "shared": true,
          "exposed": true
        },
        "src/shared/config": {
          "exposed": true
        },
        "src/shared/commands": {
          "exposed": true
        },
        "src/shared/worker-host": {
          "exposed": true
        }
      }
    },
    "browser": {
      "paths": ["src/browser"],
      "description": "Browser helpers every in-page layer builds on: scoped DOM listeners and SubscriptionRef as React state.",
      "modules": {
        "src/browser/dom-events.ts": {
          "exposed": true
        },
        "src/browser/subscription-ref.ts": {
          "exposed": true
        }
      }
    },
    "vite": {
      "paths": ["src/vite"],
      "description": "The pwa() Vite plugin: manifest, Precache list, Build ID, worker build, headers.",
      "moduleGraphs": {
        "vite": {
          "description": "pwa() wires three Vite plugins: build runs the production pipeline, client-module serves the Build ID it leaves to pages, dev serves the dev worker; build and dev share Precache selection and the worker bundle.",
          "path": "src/vite",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "vite.ts": {},
            "build": {},
            "client-module": {},
            "dev": {},
            "precache": {},
            "worker-bundle": {}
          },
          "rules": {
            "index.ts": ["vite.ts"],
            "vite.ts": ["build", "client-module", "dev"],
            "build": ["precache", "worker-bundle"],
            "client-module": ["build"],
            "dev": ["worker-bundle"]
          }
        }
      }
    },
    "worker": {
      "paths": ["src/worker"],
      "description": "Service worker runtime: lifecycle, Precache, requests (pages and Strategies), commands, messages.",
      "modules": {
        "src/worker": {
          "exposed": true
        }
      }
    },
    "client": {
      "paths": ["src/client"],
      "description": "Client-side Effect service for the core: registration, the one status stream, the activate command, Runtime Cache clearing.",
      "modules": {
        "src/client": {
          "exposed": true
        }
      }
    },
    "react": {
      "paths": ["src/react"],
      "description": "React bindings over the client service, pwaHead(), and the ready-made Update Prompt.",
      "modules": {
        "src/react": {
          "exposed": true
        }
      }
    },
    "extras": {
      "paths": ["src/extras"],
      "description": "Optional page features the core never needs: Install Prompt, online state, display mode, storage persistence. Each holds its service, hook and UI.",
      "moduleGraphs": {
        "extras": {
          "description": "Standalone extras behind one door; each builds its own page-wide service on first use.",
          "path": "src/extras",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "install": {},
            "online": {},
            "display-mode": {},
            "storage": {},
            "lazy-service": {}
          },
          "rules": {
            "index.ts": ["install", "online", "display-mode", "storage"],
            "install": ["display-mode", "lazy-service"],
            "online": ["lazy-service"],
            "display-mode": ["lazy-service"],
            "storage": ["lazy-service"]
          }
        }
      }
    },
    "rpc": {
      "paths": ["src/rpc"],
      "description": "Worker RPC: Effect RPC between the Worker Server and each Tab Client.",
      "moduleGraphs": {
        "rpc": {
          "description": "Worker Server and RPC client sharing one Build ID handshake.",
          "path": "src/rpc",
          "modules": {
            "worker": {
              "exposed": true
            },
            "client": {
              "exposed": true
            },
            "handshake": {}
          },
          "rules": {
            "worker": ["handshake"],
            "client": ["handshake"]
          }
        }
      }
    }
  },
  "layerGraphs": {
    "pwa-toolkit": {
      "description": "Every layer builds on shared; in the page, react stacks on client, and extras stand beside them on browser alone.",
      "rules": {
        "shared": [],
        "browser": [],
        "vite": ["shared"],
        "worker": ["shared"],
        "client": ["shared", "browser"],
        "react": ["client"],
        "extras": ["browser"],
        "rpc": ["shared"]
      }
    }
  }
}
