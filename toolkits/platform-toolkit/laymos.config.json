{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "fileModules": ["src/index.ts"],
  "rules": {
    "src/index.ts": [
      "src/app",
      "src/gate",
      "src/session",
      "src/apis",
      "src/host"
    ],
    "src/app": ["src/gate", "src/session", "src/apis", "src/host"],
    "src/gate": ["src/session", "src/host"],
    "src/session": ["src/apis"]
  }
}
