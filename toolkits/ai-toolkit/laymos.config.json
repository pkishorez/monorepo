{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [],
  "fileModules": [],
  "rules": {
    "src/projection": ["src/raw"],
    "src/harness": ["src/raw", "src/projection"],
    "src/harnesses": ["src/harness", "src/raw", "src/projection"],
    "src/records": ["src/raw"],
    "src/store": ["src/raw", "src/records"],
    "src/fake-harness": ["src/harness"],
    "src/engine": [
      "src/store",
      "src/harness",
      "src/raw",
      "src/records",
      "src/projection"
    ],
    "src/engine/project": ["src/engine/engine-raw"],
    "src/api/contract": ["src/projection", "src/records", "src/raw"],
    "src/api/live": [
      "src/api/contract",
      "src/engine",
      "src/store",
      "src/harness",
      "src/projection",
      "src/raw",
      "src/records"
    ],
    "src/client": ["src/api/contract", "src/projection", "src/records"],
    "src/cli": [
      "src/store",
      "src/engine",
      "src/api/contract",
      "src/api/live",
      "src/harnesses",
      "src/harness"
    ]
  }
}
