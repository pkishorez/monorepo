{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [],
  "fileModules": [],
  "rules": {
    "src/projection": ["src/raw"],
    "src/harness-wire": ["src/raw"],
    "src/harness": ["src/harness-wire", "src/raw", "src/projection"],
    "src/harnesses": ["src/harness", "src/raw", "src/projection"],
    "src/harnesses/claude/sdk-session": ["src/harnesses/claude/project"],
    "src/harnesses/codex/catalog": ["src/harnesses/codex/app-server"],
    "src/harnesses/codex/thread": [
      "src/harnesses/codex/app-server",
      "src/harnesses/codex/catalog"
    ],
    "src/harnesses/codex/fork": ["src/harnesses/codex/app-server"],
    "src/harnesses/codex/project": [
      "src/harnesses/codex/app-server",
      "src/harnesses/codex/thread"
    ],
    "src/harnesses/codex/titler": [
      "src/harnesses/codex/app-server",
      "src/harnesses/codex/catalog",
      "src/harnesses/codex/thread"
    ],
    "src/records": ["src/raw"],
    "src/store": ["src/raw", "src/records"],
    "src/fake-harness": ["src/harness"],
    "src/engine": [
      "src/store",
      "src/harness",
      "src/raw",
      "src/records",
      "src/projection"
    ],
    "src/engine/project": [
      "src/engine/engine-raw",
      "src/engine/attachments",
      "src/engine/live-agents"
    ],
    "src/engine/project/session/turn": ["src/engine/project/session/agent"],
    "src/engine/project/session/background-jobs": [
      "src/harness-wire",
      "src/engine/project/session/agent"
    ],
    "src/engine/project/session/agent-turns": [
      "src/engine/project/session/agent"
    ],
    "src/engine/attachments": ["src/engine/engine-raw"],
    "src/engine/fork": ["src/engine/engine-raw"],
    "src/engine/inquiry": ["src/engine/engine-raw", "src/engine/live-agents"],
    "src/api/contract": [
      "src/harness-wire",
      "src/projection",
      "src/records",
      "src/raw"
    ],
    "src/api/live": [
      "src/api/contract",
      "src/engine",
      "src/folders",
      "src/store",
      "src/harness",
      "src/projection",
      "src/raw",
      "src/records"
    ],
    "src/client": ["src/api/contract", "src/projection", "src/records"],
    "src/cli": [
      "src/store",
      "src/engine",
      "src/folders",
      "src/api/contract",
      "src/api/live",
      "src/harnesses",
      "src/harness"
    ]
  }
}
