{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/**/*.test.ts"],
  "fileModules": ["src/runtime/constants.ts"],
  "rules": {
    "src/runtime/table": ["src/runtime/protocol"],
    "src/runtime/transcript": [
      "src/runtime/protocol",
      "src/runtime/table",
      "src/runtime/constants.ts"
    ],
    "src/runtime/harnesses": [
      "src/runtime/protocol",
      "src/runtime/interaction-mailbox",
      "src/runtime/constants.ts"
    ],
    "src/runtime/host": [
      "src/runtime/protocol",
      "src/runtime/table",
      "src/runtime/transcript",
      "src/runtime/interaction-mailbox",
      "src/runtime/harnesses",
      "src/runtime/constants.ts"
    ],
    "src/rpc": ["src/runtime"],
    "src/rpc/live": ["src/rpc/contract"],
    "src/playground": ["src/runtime", "src/rpc"],
    "src/playground/live": ["src/playground/contract"],
    "src/playground/sync": ["src/playground/contract"],
    "src/client": ["src/runtime"],
    "src/cli": ["src/runtime", "src/rpc", "src/playground"]
  }
}
