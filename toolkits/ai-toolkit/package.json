{
  "name": "@kestack/ai-toolkit",
  "version": "0.0.2",
  "description": "Effect-native engine that runs Claude Code and Codex sessions in local folders, keeps every Raw record, and serves one projected Message form over WebSocket",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/ai-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./api": {
      "types": "./dist/api/contract/index.d.ts",
      "default": "./dist/api/contract/index.js"
    },
    "./client": {
      "types": "./dist/api/client/index.d.ts",
      "default": "./dist/api/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.e2e.test.ts\"",
    "test:e2e": "AI_TOOLKIT_E2E=1 vitest run .e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@effect/platform-node": "catalog:",
    "@openai/codex": "catalog:",
    "sherpa-onnx-node": "catalog:"
  },
  "peerDependencies": {
    "@kestack/kabuki": "workspace:*",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@tanstack/db": "0.15.2",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@kestack/kabuki": "workspace:*",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@tanstack/db": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
