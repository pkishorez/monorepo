{
  "name": "@kestack/ai-toolkit",
  "version": "0.0.3",
  "description": "Effect-native Coding Harnesses as plain Effects: Claude Code and Codex Agents in a folder, their Turns, Forks, Asks and One-shot Prompts, and the Messages projected from their Raw records; and Speech to Text on the computer",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/ai-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./harness/fake": {
      "types": "./dist/harness/fake/index.d.ts",
      "default": "./dist/harness/fake/index.js"
    },
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "default": "./dist/speech/index.js"
    },
    "./speech/fake": {
      "types": "./dist/speech/fake/index.d.ts",
      "default": "./dist/speech/fake/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.e2e.test.ts\"",
    "test:e2e": "AI_TOOLKIT_E2E=1 vitest run .e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@openai/codex": "catalog:",
    "sherpa-onnx-node": "catalog:"
  },
  "peerDependencies": {
    "@kestack/kabuki": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@kestack/kabuki": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
