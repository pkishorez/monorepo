{
  "name": "@kstackz/ai-toolkit",
  "version": "0.0.0",
  "description": "Effect-native runtime for stateful coding-agent harnesses whose Messages live in a StdTable",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/ai-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "ai-toolkit": "bin/ai-toolkit.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/message/index.d.ts",
      "default": "./dist/client/message/index.js"
    },
    "./playground": {
      "types": "./dist/playground/index.d.ts",
      "default": "./dist/playground/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/contract/index.d.ts",
      "default": "./dist/rpc/contract/index.js"
    },
    "./rpc/live": {
      "types": "./dist/rpc/live/index.d.ts",
      "default": "./dist/rpc/live/index.js"
    },
    "./table": {
      "types": "./dist/runtime/table/index.d.ts",
      "default": "./dist/runtime/table/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "serve": "pnpm build && portless run --force node bin/ai-toolkit.mjs serve",
    "test": "vitest run --exclude \"**/*.e2e.test.ts\"",
    "test:e2e": "AI_TOOLKIT_E2E=1 vitest run src/smoke.e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@effect/platform-node": "catalog:",
    "@openai/codex": "catalog:"
  },
  "peerDependencies": {
    "@kstackz/std-toolkit": "workspace:*",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@kstackz/std-toolkit": "workspace:*",
    "@tanstack/ai": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
