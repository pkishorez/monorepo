{
  "name": "@kestack/ai-toolkit-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Coding agent harnesses as Effect Services, each true to its own harness: Claude Code, Codex, OpenCode, Antigravity and any ACP agent, with one live instance per session and a fake for each",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./harness/claude": {
      "types": "./dist/harness/claude/contract/index.d.ts",
      "default": "./dist/harness/claude/contract/index.js"
    },
    "./harness/claude/real": {
      "types": "./dist/harness/claude/real/index.d.ts",
      "default": "./dist/harness/claude/real/index.js"
    },
    "./harness/claude/fake": {
      "types": "./dist/harness/claude/fake/index.d.ts",
      "default": "./dist/harness/claude/fake/index.js"
    },
    "./harness/codex": {
      "types": "./dist/harness/codex/contract/index.d.ts",
      "default": "./dist/harness/codex/contract/index.js"
    },
    "./harness/codex/real": {
      "types": "./dist/harness/codex/real/index.d.ts",
      "default": "./dist/harness/codex/real/index.js"
    },
    "./harness/codex/fake": {
      "types": "./dist/harness/codex/fake/index.d.ts",
      "default": "./dist/harness/codex/fake/index.js"
    },
    "./harness/opencode": {
      "types": "./dist/harness/opencode/contract/index.d.ts",
      "default": "./dist/harness/opencode/contract/index.js"
    },
    "./harness/opencode/real": {
      "types": "./dist/harness/opencode/real/index.d.ts",
      "default": "./dist/harness/opencode/real/index.js"
    },
    "./harness/opencode/fake": {
      "types": "./dist/harness/opencode/fake/index.d.ts",
      "default": "./dist/harness/opencode/fake/index.js"
    },
    "./harness/antigravity": {
      "types": "./dist/harness/antigravity/contract/index.d.ts",
      "default": "./dist/harness/antigravity/contract/index.js"
    },
    "./harness/antigravity/real": {
      "types": "./dist/harness/antigravity/real/index.d.ts",
      "default": "./dist/harness/antigravity/real/index.js"
    },
    "./harness/antigravity/fake": {
      "types": "./dist/harness/antigravity/fake/index.d.ts",
      "default": "./dist/harness/antigravity/fake/index.js"
    },
    "./harness/acp": {
      "types": "./dist/harness/acp/contract/index.d.ts",
      "default": "./dist/harness/acp/contract/index.js"
    },
    "./harness/acp/real": {
      "types": "./dist/harness/acp/real/index.d.ts",
      "default": "./dist/harness/acp/real/index.js"
    },
    "./harness/acp/fake": {
      "types": "./dist/harness/acp/fake/index.d.ts",
      "default": "./dist/harness/acp/fake/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "fmt": "vp fmt",
    "lint": "vp check && tsc --noEmit && node ../../devtools/monoverse/src/cli/main.ts lint",
    "test": "vitest run --exclude \"**/*.e2e.test.ts\"",
    "test:e2e": "AI_TOOLKIT_V2_E2E=1 vitest run .e2e.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@effect/platform-node": "catalog:",
    "@opencode/sdk": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.5"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@kestack/monoverse": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
