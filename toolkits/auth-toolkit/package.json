{
  "name": "auth-toolkit",
  "version": "0.0.4",
  "private": false,
  "description": "Curated better-auth building blocks: one shared Auth Worker (Cloudflare D1), a client subpath for React session hooks, a cli subpath for Device Login, and a server subpath for backend-to-backend verification",
  "keywords": [
    "better-auth",
    "auth",
    "cloudflare",
    "d1",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/auth-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/verification/session/index.d.ts",
      "default": "./dist/server/verification/session/index.js"
    },
    "./server/access-token": {
      "types": "./dist/server/verification/access-token/index.d.ts",
      "default": "./dist/server/verification/access-token/index.js"
    },
    "./server/mcp": {
      "types": "./dist/server/mcp/index.d.ts",
      "default": "./dist/server/mcp/index.js"
    },
    "./rpc": {
      "types": "./dist/server/effect/rpc/authz.d.ts",
      "default": "./dist/server/effect/rpc/authz.js"
    },
    "./rpc/server": {
      "types": "./dist/server/effect/rpc/index.d.ts",
      "default": "./dist/server/effect/rpc/index.js"
    },
    "./http-api": {
      "types": "./dist/server/effect/http-api/authz.d.ts",
      "default": "./dist/server/effect/http-api/authz.js"
    },
    "./http-api/server": {
      "types": "./dist/server/effect/http-api/index.d.ts",
      "default": "./dist/server/effect/http-api/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/app/worker.js"
    },
    "./database/d1": {
      "types": "./dist/infra/primary/sqlite/d1/database/index.d.ts",
      "default": "./dist/infra/primary/sqlite/d1/database/index.js"
    },
    "./database/memory": {
      "types": "./dist/infra/primary/sqlite/memory/index.d.ts",
      "default": "./dist/infra/primary/sqlite/memory/index.js"
    },
    "./alchemy/d1": {
      "types": "./dist/infra/primary/sqlite/d1/resource/index.d.ts",
      "default": "./dist/infra/primary/sqlite/d1/resource/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && vp build --config vite.app.config.ts && node scripts/bundle-app.mts && tsc -p tsconfig.build.json && cp -R src/infra/primary/sqlite/migration/migrations dist/infra/primary/sqlite/migration/",
    "db:generate": "auth generate --config ./auth.generate.ts --output ./src/infra/primary/sqlite/schema/schema.generated.ts -y && pnpm fmt && drizzle-kit generate",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "stories": "laymos stories",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/infra": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "kui-toolkit": "workspace:*",
    "next-themes": "catalog:",
    "rpc-toolkit": "workspace:*",
    "use-sync-external-store": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.76",
    "better-sqlite3": "13.0.3",
    "effect": "4.0.0-rc.112",
    "react": "19.2.8"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@typescript/native": "catalog:",
    "alchemy": "catalog:",
    "auth": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:",
    "laymos": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
