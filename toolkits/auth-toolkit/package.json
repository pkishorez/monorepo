{
  "name": "@kstackz/auth-toolkit",
  "version": "0.0.0",
  "private": false,
  "description": "Curated better-auth building blocks: one shared Auth Worker (Cloudflare D1) with its own pages, server doors for Consumer Backends, and browser, Expo and CLI clients",
  "keywords": [
    "better-auth",
    "auth",
    "cloudflare",
    "d1",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/auth-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    "./worker": {
      "types": "./dist/auth-worker/worker/index.d.ts",
      "default": "./dist/auth-worker/app/worker.js"
    },
    "./worker/database/d1": {
      "types": "./dist/auth-worker/database/sqlite/d1/database/index.d.ts",
      "default": "./dist/auth-worker/database/sqlite/d1/database/index.js"
    },
    "./worker/database/memory": {
      "types": "./dist/auth-worker/database/sqlite/memory/index.d.ts",
      "default": "./dist/auth-worker/database/sqlite/memory/index.js"
    },
    "./worker/alchemy/d1": {
      "types": "./dist/auth-worker/database/sqlite/d1/resource/index.d.ts",
      "default": "./dist/auth-worker/database/sqlite/d1/resource/index.js"
    },
    "./server/session": {
      "types": "./dist/server/vanilla/session/index.d.ts",
      "default": "./dist/server/vanilla/session/index.js"
    },
    "./server/access-token": {
      "types": "./dist/server/vanilla/access-token/index.d.ts",
      "default": "./dist/server/vanilla/access-token/index.js"
    },
    "./server/mcp": {
      "types": "./dist/server/vanilla/mcp/index.d.ts",
      "default": "./dist/server/vanilla/mcp/index.js"
    },
    "./server/rpc": {
      "types": "./dist/server/effect/rpc/server/index.d.ts",
      "default": "./dist/server/effect/rpc/server/index.js"
    },
    "./server/resolver-live": {
      "types": "./dist/server/effect/resolver-live/index.d.ts",
      "default": "./dist/server/effect/resolver-live/index.js"
    },
    "./server/http-api": {
      "types": "./dist/server/effect/http-api/server/index.d.ts",
      "default": "./dist/server/effect/http-api/server/index.js"
    },
    "./rpc": {
      "types": "./dist/server/effect/rpc/declaration/index.d.ts",
      "default": "./dist/server/effect/rpc/declaration/index.js"
    },
    "./http-api": {
      "types": "./dist/server/effect/http-api/declaration/index.d.ts",
      "default": "./dist/server/effect/http-api/declaration/index.js"
    },
    "./clients/auth": {
      "types": "./dist/clients/auth/index.d.ts",
      "default": "./dist/clients/auth/index.js"
    },
    "./clients/auth/expo": {
      "types": "./dist/clients/auth/expo/index.d.ts",
      "default": "./dist/clients/auth/expo/index.js"
    },
    "./clients/cli": {
      "types": "./dist/clients/cli/index.d.ts",
      "default": "./dist/clients/cli/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && vp build --config vite.app.config.ts && node scripts/bundle-app.mts && tsc -p tsconfig.build.json && cp -R src/auth-worker/database/sqlite/migration/migrations dist/auth-worker/database/sqlite/migration/",
    "db:generate": "auth generate --config ./auth.generate.ts --output ./src/auth-worker/database/sqlite/schema/schema.generated.ts -y && pnpm fmt && drizzle-kit generate",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "stories": "laymos stories",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/infra": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "use-sync-external-store": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "alchemy": "2.0.0-beta.80",
    "better-sqlite3": "13.0.3",
    "effect": "^4.0.0",
    "expo-auth-session": "57.0.13",
    "expo-secure-store": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "peerDependenciesMeta": {
    "@kstackz/rpc-toolkit": {
      "optional": true
    },
    "@kstackz/std-toolkit": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "expo-auth-session": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@kstackz/ui-toolkit": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "auth": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "expo": "catalog:",
    "expo-auth-session": "catalog:",
    "expo-secure-store": "catalog:",
    "jose": "catalog:",
    "laymos": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
