{
  "name": "@kestack/auth-toolkit",
  "version": "0.0.4",
  "private": false,
  "description": "One sign-in service on Cloudflare, the guard both sides of an Effect API import, and the Layers a web app or a device signs in with",
  "keywords": [
    "better-auth",
    "auth",
    "cloudflare",
    "d1",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/auth-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/guard/authz/index.d.ts",
      "default": "./dist/guard/authz/index.js"
    },
    "./worker": {
      "types": "./dist/worker/service/index.d.ts",
      "default": "./dist/worker/app/worker.js"
    },
    "./worker/memory": {
      "types": "./dist/worker/database/memory/index.d.ts",
      "default": "./dist/worker/database/memory/index.js"
    },
    "./worker/alchemy": {
      "types": "./dist/worker/database/d1/resource/index.d.ts",
      "default": "./dist/worker/database/d1/resource/index.js"
    },
    "./server": {
      "types": "./dist/guard/server/index.d.ts",
      "kestack-fake-auth": "./dist/guard/fake/doors/server.js",
      "default": "./dist/guard/server/index.js"
    },
    "./client": {
      "types": "./dist/guard/client/accounts/index.d.ts",
      "default": "./dist/guard/client/accounts/index.js"
    },
    "./client/browser": {
      "types": "./dist/guard/client/browser/index.d.ts",
      "kestack-fake-auth": "./dist/guard/fake/doors/browser.js",
      "default": "./dist/guard/client/browser/index.js"
    },
    "./client/device": {
      "types": "./dist/guard/client/device/index.d.ts",
      "kestack-fake-auth": "./dist/guard/fake/doors/device.js",
      "default": "./dist/guard/client/device/index.js"
    },
    "./fake": {
      "types": "./dist/guard/fake/index.d.ts",
      "default": "./dist/guard/fake/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && vp build --config vite.app.config.ts && node scripts/bundle-app.mts && tsc -p tsconfig.build.json && cp -R src/worker/database/migration/migrations dist/worker/database/migration/",
    "db:generate": "auth generate --config ./auth.generate.ts --output ./src/worker/database/schema/schema.generated.ts -y && pnpm fmt && drizzle-kit generate",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/infra": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "alchemy": "2.0.0-beta.84",
    "better-sqlite3": "13.0.3",
    "effect": "^4.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "@kestack/rpc-toolkit": {
      "optional": true
    },
    "@kestack/std-toolkit": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/sql": "catalog:",
    "@base-ui/react": "catalog:",
    "@effect/platform-node": "catalog:",
    "@kestack/kabuki": "workspace:*",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "auth": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:",
    "laymos": "workspace:*",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
