{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "paths": {
      "@kestack/auth-toolkit": ["./src/auth/index.ts"],
      "@kestack/auth-toolkit/server/rpc": ["./src/server/rpc/index.ts"],
      "@kestack/auth-toolkit/server/http": ["./src/server/http/index.ts"],
      "@kestack/auth-toolkit/client": ["./src/client/accounts/index.ts"],
      "@kestack/auth-toolkit/client/browser": ["./src/client/browser/index.ts"],
      "@kestack/auth-toolkit/client/device": ["./src/client/device/index.ts"],
      "@kestack/auth-toolkit/fake": ["./src/fake/index.ts"]
    },
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/worker/app"]
}
