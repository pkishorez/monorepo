{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "paths": {
      "@kstackz/auth-toolkit/cli": ["./src/cli/index.ts"],
      "@kstackz/auth-toolkit/http-api": [
        "./src/server/effect/http-api/authz.ts"
      ],
      "@kstackz/auth-toolkit/http-api/server": [
        "./src/server/effect/http-api/index.ts"
      ],
      "@kstackz/auth-toolkit/rpc": ["./src/server/effect/rpc/authz.ts"],
      "@kstackz/auth-toolkit/rpc/server": ["./src/server/effect/rpc/index.ts"],
      "@kstackz/auth-toolkit/server": [
        "./src/server/verification/session/index.ts"
      ],
      "@kstackz/auth-toolkit/server/access-token": [
        "./src/server/verification/access-token/index.ts"
      ],
      "@kstackz/auth-toolkit/server/mcp": ["./src/server/mcp/index.ts"]
    },
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "stories/**/*"],
  "exclude": ["node_modules", "src/app", "src/ui"]
}
