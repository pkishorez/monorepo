{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "paths": {
      "@kstackz/auth-toolkit/server/session": [
        "./src/server/vanilla/session/index.ts"
      ],
      "@kstackz/auth-toolkit/server/access-token": [
        "./src/server/vanilla/access-token/index.ts"
      ],
      "@kstackz/auth-toolkit/server/mcp": ["./src/server/vanilla/mcp/index.ts"],
      "@kstackz/auth-toolkit/server/rpc": [
        "./src/server/effect/rpc/server/index.ts"
      ],
      "@kstackz/auth-toolkit/server/http-api": [
        "./src/server/effect/http-api/server/index.ts"
      ],
      "@kstackz/auth-toolkit/rpc": [
        "./src/server/effect/rpc/declaration/index.ts"
      ],
      "@kstackz/auth-toolkit/http-api": [
        "./src/server/effect/http-api/declaration/index.ts"
      ],
      "@kstackz/auth-toolkit/clients/accounts": [
        "./src/clients/accounts/index.ts"
      ],
      "@kstackz/auth-toolkit/clients/cli": ["./src/clients/cli/index.ts"]
    },
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "stories/**/*"],
  "exclude": ["node_modules", "src/auth-worker/app", "src/auth-worker/pages"]
}
