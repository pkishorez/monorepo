{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "paths": {
      "@kestack/auth-toolkit": ["./src/guard/authz/index.ts"],
      "@kestack/auth-toolkit/server": ["./src/guard/server/index.ts"],
      "@kestack/auth-toolkit/client": ["./src/guard/client/accounts/index.ts"],
      "@kestack/auth-toolkit/client/browser": [
        "./src/guard/client/browser/index.ts"
      ],
      "@kestack/auth-toolkit/client/device": [
        "./src/guard/client/device/index.ts"
      ],
      "@kestack/auth-toolkit/fake": ["./src/guard/fake/index.ts"]
    },
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/worker/app"]
}
