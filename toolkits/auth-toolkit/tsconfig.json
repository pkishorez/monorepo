{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "paths": {
      "@kstackz/auth-toolkit/guard": ["./src/guard/index.ts"],
      "@kstackz/auth-toolkit/server": ["./src/server/index.ts"],
      "@kstackz/auth-toolkit/server/cloud": ["./src/server/cloud/index.ts"],
      "@kstackz/auth-toolkit/client": ["./src/client/index.ts"],
      "@kstackz/auth-toolkit/client/cli": [
        "./src/client/sign-in/device-code/index.ts"
      ]
    },
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "src/worker/app",
    "src/worker/pages",
    "src/worker/ui"
  ]
}
