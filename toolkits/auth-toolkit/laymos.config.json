{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/worker/database/migration/migrations",
    "src/worker/app/styles.css"
  ],
  "rules": {
    "src/guard": ["src/contract"],
    "src/guard/client": ["src/guard/authz/middleware"],
    "src/guard/client/engine": ["src/guard/client/accounts"],
    "src/guard/client/auth-worker-api": ["src/guard/client/accounts"],
    "src/guard/client/browser": [
      "src/guard/client/accounts",
      "src/guard/client/engine",
      "src/guard/client/auth-worker-api"
    ],
    "src/guard/client/device": [
      "src/guard/client/accounts",
      "src/guard/client/engine",
      "src/guard/client/auth-worker-api"
    ],
    "src/guard/server": ["src/guard/authz/middleware"],
    "src/guard/server/verification": ["src/guard/server/guard-layer"],
    "src/guard/fake": [
      "src/guard/authz/middleware",
      "src/guard/client/accounts",
      "src/guard/client/engine",
      "src/guard/server/guard-layer",
      "src/guard/client/browser",
      "src/guard/client/device",
      "src/guard/server"
    ],
    "src/worker/database/d1/database": ["src/worker/database/schema"],
    "src/worker/database/d1/resource": ["src/worker/database/migration"],
    "src/worker/database/memory": [
      "src/worker/database/schema",
      "src/worker/database/migration"
    ],
    "src/worker/service": ["src/contract", "src/worker/database/d1/database"],
    "src/worker/app/api": ["src/contract"],
    "src/worker/app/actor-app": ["src/worker/app/api", "src/worker/app/ui"]
  }
}
