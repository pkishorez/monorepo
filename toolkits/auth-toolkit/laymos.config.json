{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/worker/database/sqlite/migration/migrations",
    "src/worker/app/styles.css"
  ],
  "fileModules": [
    "src/worker/app/app.tsx",
    "src/worker/app/document.tsx",
    "src/worker/app/loaders.server.ts"
  ],
  "rules": {
    "src/client": ["src/contract", "src/guard"],
    "src/client/engine": ["src/client/accounts"],
    "src/client/auth-worker": ["src/client/accounts"],
    "src/client/browser": [
      "src/client/accounts",
      "src/client/engine",
      "src/client/auth-worker"
    ],
    "src/client/device": [
      "src/client/accounts",
      "src/client/engine",
      "src/client/auth-worker"
    ],
    "src/guard": ["src/contract"],
    "src/auth": ["src/guard"],
    "src/server": ["src/contract", "src/guard", "src/guard-layer"],
    "src/guard-layer": ["src/guard"],
    "src/fake": [
      "src/contract",
      "src/guard",
      "src/client/accounts",
      "src/client/engine",
      "src/guard-layer"
    ],
    "src/worker/database/sqlite/d1/database": [
      "src/worker/database/sqlite/schema"
    ],
    "src/worker/database/sqlite/d1/resource": [
      "src/worker/database/sqlite/migration"
    ],
    "src/worker/database/sqlite/memory": [
      "src/worker/database/sqlite/schema",
      "src/worker/database/sqlite/migration"
    ],
    "src/worker/worker": [
      "src/contract",
      "src/worker/database/sqlite/d1/database"
    ],
    "src/worker/app/api": ["src/contract"],
    "src/worker/app/pages": ["src/worker/app/api"],
    "src/worker/app/views": [
      "src/worker/app/api",
      "src/worker/app/pages",
      "src/worker/app/ui"
    ],
    "src/worker/app/app.tsx": [
      "src/worker/app/api",
      "src/worker/app/pages",
      "src/worker/app/views",
      "src/worker/app/document.tsx"
    ],
    "src/worker/app/loaders.server.ts": [
      "src/worker/app/api",
      "src/worker/app/pages"
    ]
  }
}
