{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@kstackz/std-toolkit/alchemy": ["./src/alchemy/index.ts"],
      "@kstackz/std-toolkit/core": ["./src/core/index.ts"],
      "@kstackz/std-toolkit/eschema": ["./src/eschema/index.ts"],
      "@kstackz/std-toolkit/snapshot": ["./src/snapshot/index.ts"],
      "@kstackz/std-toolkit/snapshot/vitest": [
        "./src/snapshot/vitest/index.ts"
      ],
      "@kstackz/std-toolkit/studio-rpc": ["./src/studio-rpc/index.ts"],
      "@kstackz/std-toolkit/sync": ["./src/sync/index.ts"],
      "@kstackz/std-toolkit/sync/paced": ["./src/sync/paced/index.ts"],
      "@kstackz/std-toolkit/sync/idb": ["./src/sync/store/idb/index.ts"],
      "@kstackz/std-toolkit/sync/memory": ["./src/sync/store/memory/index.ts"],
      "@kstackz/std-toolkit/sync/sqlite": ["./src/sync/store/sqlite/index.ts"],
      "@kstackz/std-toolkit/db": ["./src/db/index.ts"],
      "@kstackz/std-toolkit/db/dynamodb": ["./src/db/dynamodb/index.ts"],
      "@kstackz/std-toolkit/db/idb": ["./src/db/idb/index.ts"],
      "@kstackz/std-toolkit/db/memory": ["./src/db/memory/index.ts"],
      "@kstackz/std-toolkit/db/sqlite": ["./src/db/sqlite/index.ts"],
      "@kstackz/std-toolkit/db/sqlite/better-sqlite3": [
        "./src/db/sqlite/drivers/better-sqlite3/index.ts"
      ],
      "@kstackz/std-toolkit/db/sqlite/bun": [
        "./src/db/sqlite/drivers/bun/index.ts"
      ],
      "@kstackz/std-toolkit/db/sqlite/d1": [
        "./src/db/sqlite/drivers/d1/index.ts"
      ],
      "@kstackz/std-toolkit/db/sqlite/durable-object": [
        "./src/db/sqlite/drivers/durable-object/index.ts"
      ],
      "@kstackz/std-toolkit/db/sqlite/node": [
        "./src/db/sqlite/drivers/node/index.ts"
      ]
    },
    "rootDir": ".",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "laymos/**/*", "stories/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "src/db/sqlite/sql/adapters/bun",
    "src/db/sqlite/sql/adapters/__tests__/bun.bun.test.ts",
    "src/db/sqlite/sql/adapters/__tests__/compat.bun.test.ts",
    "src/db/sqlite/sql/adapters/__tests__/compat-read-better-sqlite3.ts",
    "src/db/sqlite/sql/adapters/__tests__/compat-seed-better-sqlite3.ts"
  ]
}
