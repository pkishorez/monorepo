{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@kestack/std-toolkit/schema": ["./src/schema/index.ts"],
      "@kestack/std-toolkit/schema/snapshot": [
        "./src/schema/snapshot/index.ts"
      ],
      "@kestack/std-toolkit/schema/testing": [
        "./src/schema/eschema/testing/index.ts"
      ],
      "@kestack/std-toolkit/db": ["./src/db/index.ts"],
      "@kestack/std-toolkit/db/testing": ["./src/db/testing/index.ts"],
      "@kestack/std-toolkit/db/dynamodb": [
        "./src/db/adapters/dynamodb/index.ts"
      ],
      "@kestack/std-toolkit/db/idb": ["./src/db/adapters/idb/index.ts"],
      "@kestack/std-toolkit/db/memory": ["./src/db/adapters/memory/index.ts"],
      "@kestack/std-toolkit/db/sqlite": ["./src/db/adapters/sqlite/index.ts"],
      "@kestack/std-toolkit/db/sqlite/better-sqlite3": [
        "./src/db/adapters/sqlite/drivers/better-sqlite3/index.ts"
      ],
      "@kestack/std-toolkit/db/sqlite/bun": [
        "./src/db/adapters/sqlite/drivers/bun/index.ts"
      ],
      "@kestack/std-toolkit/db/sqlite/d1": [
        "./src/db/adapters/sqlite/drivers/d1/index.ts"
      ],
      "@kestack/std-toolkit/db/sqlite/durable-object": [
        "./src/db/adapters/sqlite/drivers/durable-object/index.ts"
      ],
      "@kestack/std-toolkit/db/sqlite/node": [
        "./src/db/adapters/sqlite/drivers/node/index.ts"
      ],
      "@kestack/std-toolkit/sync": ["./src/sync/index.ts"],
      "@kestack/std-toolkit/sync/paced": ["./src/sync/paced/index.ts"],
      "@kestack/std-toolkit/sync/idb": ["./src/sync/store/idb/index.ts"],
      "@kestack/std-toolkit/sync/memory": ["./src/sync/store/memory/index.ts"],
      "@kestack/std-toolkit/replica": ["./src/replica/index.ts"],
      "@kestack/std-toolkit/replica/idb": ["./src/replica/store/idb/index.ts"],
      "@kestack/std-toolkit/replica/memory": [
        "./src/replica/store/memory/index.ts"
      ],
      "@kestack/std-toolkit/deploy": ["./src/deploy/index.ts"]
    },
    "rootDir": ".",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "laymos/**/*", "stories/**/*"],
  "exclude": ["dist", "node_modules"]
}
