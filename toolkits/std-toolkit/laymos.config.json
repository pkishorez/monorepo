        "sqlite.statement": ["sqlite.item-schema"],
        "sqlite.item-schema": ["std-table.contract", "std-table.definition"],
        "sqlite.database": ["sqlite.item-schema"],
        "sqlite.drivers": ["sqlite.database"]
      }
    },
    "eschema": {
      "description": "ESchema entrypoint, constructs, composition, and domain",
      "rules": {
        "eschema.public": ["eschema.composition", "eschema.constructs"],
        "eschema.constructs": ["eschema.domain"],
        "eschema.composition": ["eschema.domain"]
      }
    },
    "snapshot": {
      "description": "Snapshot facade, capture, restore, domain, the Vitest binding, and two-way ESchema integration",
      "rules": {
        "snapshot.public": ["snapshot.facade"],
        "snapshot.facade": [
          "eschema.constructs",
          "eschema.domain",
          "snapshot.capture",
          "snapshot.restore"
        ],
        "snapshot.capture": ["eschema.domain", "snapshot.domain"],
        "snapshot.restore": ["snapshot.domain"],
        "snapshot.domain": ["eschema.public"],
        "snapshot.vitest": ["snapshot.public"]
      }
    },
    "core": {
      "description": "Core utilities and their schema dependency",
      "rules": {
        "core.public": ["core.impl"],
        "core.impl": ["eschema.public", "eschema.domain"]
      }
    },
    "sync": {
      "description": "Sync read top-down as its story: the Std Sync holds Collections; a Collection runs Strategy Sessions and writes through the Outbox; every loop is a Worker; the Platform is the environment; the domain is the words",
      "rules": {
        "sync.std-sync": ["memory.public", "sync.collection", "sync.outbox"],
        "sync.collection": [
          "sync.strategy",
          "sync.outbox",
          "sync.flow",
          "sync.platform"
        ],
        "sync.strategy": ["sync.flow", "sync.platform"],
        "sync.outbox": ["sync.flow", "sync.platform"],
        "sync.flow": ["sync.platform"],
        "sync.platform": ["idb.public", "db.public", "sync.domain"],
        "sync.domain": ["core.public", "db.public", "eschema.public"]
      }
    },
    "alchemy": {
      "description": "Alchemy deploy targets for a StdTable: each target makes the table exist and guards its snapshot",
      "rules": {
        "alchemy.public": ["alchemy.targets", "alchemy.snapshot-guard"],
        "alchemy.targets": [
          "alchemy.snapshot-guard",
          "db.public",
          "dynamodb.public",
          "sqlite.public",
          "sqlite.drivers"
        ],
        "alchemy.snapshot-guard": ["db.public", "snapshot.public"]
      }
    }
  }
}
