{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/alchemy/__tests__",
    "src/core/__tests__",
    "src/db/__tests__",
    "src/db/dynamodb/__tests__",
    "src/db/dynamodb/expression/__tests__",
    "src/db/dynamodb/table/__tests__",
    "src/db/idb/__tests__",
    "src/db/memory/__tests__",
    "src/db/sqlite/__tests__",
    "src/db/std-table/__tests__",
    "src/db/std-table/definition/__tests__",
    "src/db/std-table/entity/__tests__",
    "src/db/std-table/key/__tests__",
    "src/eschema/__tests__",
    "src/eschema/play.ts",
    "src/eschema/tutorial",
    "src/snapshot/__tests__",
    "src/snapshot/vitest/__tests__",
    "src/studio-rpc/__tests__",
    "src/sync/__tests__",
    "src/sync/domain/collection-item/__tests__",
    "src/sync/domain/identity/__tests__",
    "src/sync/paced/__tests__",
    "src/sync/store/idb/__tests__",
    "src/sync/session/__tests__",
    "src/sync/strategy/__tests__"
  ],
  "storiesPath": "stories",
  "fileModules": ["src/core/error.ts", "src/core/ulid.ts"],
  "rules": {
    "src/core/broadcaster": ["src/core/entity"],
    "src/eschema/domain/encoded": [
      "src/eschema/domain/eschema-error",
      "src/eschema/domain/schema-model"
    ],
    "src/eschema/domain/entity-schema": [
      "src/eschema/domain/encoded",
      "src/eschema/domain/eschema-error",
      "src/eschema/domain/introspection",
      "src/eschema/domain/schema-model",
      "src/core"
    ],
    "src/eschema/domain/object-schema-runtime": [
      "src/eschema/domain/encoded",
      "src/eschema/domain/eschema-error",
      "src/eschema/domain/introspection",
      "src/eschema/domain/schema-model",
      "src/eschema/domain/snapshot-type"
    ],
    "src/eschema/domain/snapshot-type": ["src/eschema/domain/introspection"],
    "src/eschema/domain/versioned-schema": [
      "src/eschema/domain/encoded",
      "src/eschema/domain/eschema-error",
      "src/eschema/domain/introspection",
      "src/eschema/domain/schema-model"
    ],
    "src/eschema/eschema": ["src/eschema/domain"],
    "src/eschema/entity-eschema": ["src/eschema/domain"],
    "src/eschema/value-eschema": ["src/eschema/domain"],
    "src/snapshot/domain": ["src/eschema"],
    "src/snapshot/capture": ["src/snapshot/domain"],
    "src/snapshot/capture/eschema-capture": [
      "src/eschema/domain/introspection",
      "src/eschema/domain/snapshot-type"
    ],
    "src/snapshot/capture/table-capture": [
      "src/eschema",
      "src/snapshot/capture/eschema-capture"
    ],
    "src/snapshot/snapshot": [
      "src/snapshot/capture/table-capture",
      "src/snapshot/domain"
    ],
    "src/snapshot/snapshot/snapshot-decoder": ["src/eschema/domain/encoded"],
    "src/snapshot/snapshot/snapshot-diff": [
      "src/eschema",
      "src/snapshot/snapshot/snapshot-decoder"
    ],
    "src/snapshot/snapshot/snapshot-renderer": ["src/eschema"],
    "src/db/std-table/definition": ["src/eschema"],
    "src/db/std-table/key": ["src/db/std-table/contract"],
    "src/db/std-table/entity": [
      "src/db/std-table/contract",
      "src/db/std-table/definition",
      "src/db/std-table/error",
      "src/db/std-table/key",
      "src/eschema",
      "src/core"
    ],
    "src/db/std-table/table": [
      "src/db/std-table/contract",
      "src/db/std-table/definition",
      "src/db/std-table/entity",
      "src/db/std-table/error",
      "src/db/std-table/key",
      "src/eschema",
      "src/core"
    ],
    "src/db/dynamodb": [
      "src/db/std-table/contract",
      "src/db/std-table/definition"
    ],
    "src/db/dynamodb/expression": ["src/db/dynamodb/attribute-value"],
    "src/db/dynamodb/item-schema": ["src/db/dynamodb/attribute-value"],
    "src/db/dynamodb/setup": ["src/db/dynamodb/client"],
    "src/db/dynamodb/table": [
      "src/db/dynamodb/client",
      "src/db/dynamodb/expression",
      "src/db/dynamodb/item-schema"
    ],
    "src/db/idb": ["src/db/std-table/contract", "src/db/std-table/definition"],
    "src/db/idb/database": ["src/db/idb/upgrade"],
    "src/db/idb/table": ["src/db/idb/database", "src/db/idb/item-schema"],
    "src/db/memory": [
      "src/db/std-table/contract",
      "src/db/std-table/definition"
    ],
    "src/db/sqlite": [
      "src/db/std-table/contract",
      "src/db/std-table/definition"
    ],
    "src/db/sqlite/database": ["src/db/sqlite/item-schema"],
    "src/db/sqlite/drivers": ["src/db/sqlite/database"],
    "src/db/sqlite/setup": [
      "src/db/sqlite/database",
      "src/db/sqlite/statement"
    ],
    "src/db/sqlite/statement": ["src/db/sqlite/item-schema"],
    "src/db/sqlite/table": [
      "src/db/sqlite/database",
      "src/db/sqlite/item-schema",
      "src/db/sqlite/statement"
    ],
    "src/studio-rpc": [
      "src/core",
      "src/db/std-table/contract",
      "src/db/std-table/definition",
      "src/db/std-table/entity",
      "src/db/std-table/error",
      "src/db/std-table/table",
      "src/snapshot"
    ],
    "src/alchemy/snapshot-guard": ["src/snapshot"],
    "src/alchemy/d1": [
      "src/alchemy/snapshot-guard",
      "src/db/sqlite",
      "src/snapshot"
    ],
    "src/alchemy/dynamodb": ["src/alchemy/snapshot-guard", "src/db"],
    "src/sync/domain/collection-item": ["src/eschema", "src/core"],
    "src/sync/domain/stored-entity": ["src/db", "src/eschema"],
    "src/sync/store": ["src/sync/domain/stored-entity"],
    "src/sync/store/contract": ["src/db"],
    "src/sync/store/idb": [
      "src/db/idb",
      "src/sync/domain/identity",
      "src/sync/store/contract"
    ],
    "src/sync/store/memory": ["src/db/memory", "src/sync/store/contract"],
    "src/sync/store/store-runtime": ["src/db", "src/sync/store/contract"],
    "src/sync/session": ["src/sync/store/contract", "src/sync/strategy"],
    "src/sync/collection": [
      "src/db",
      "src/eschema",
      "src/sync/domain",
      "src/sync/session",
      "src/sync/store/contract",
      "src/sync/store/effect-runner",
      "src/sync/store/store-runtime",
      "src/sync/strategy",
      "src/core"
    ],
    "src/sync/std-sync": [
      "src/eschema",
      "src/sync/collection",
      "src/sync/domain/collection-item",
      "src/sync/domain/identity",
      "src/sync/domain/sync-event",
      "src/sync/store/contract",
      "src/sync/store/effect-runner",
      "src/sync/store/memory",
      "src/sync/store/store-runtime"
    ],
    "src/eschema/domain/schema-model": ["src/core"],
    "src/sync/domain/entity-validation": ["src/core"],
    "src/sync/strategy": ["src/core"]
  },
  "exceptions": [
    {
      "from": "src/snapshot/vitest",
      "to": "src/snapshot",
      "because": "the Vitest binding wraps the snapshot facade it sits in, and ships as its own entry point"
    }
  ]
}
