  "layerGraphs": {
    "studio-rpc": {
      "description": "Studio RPC composes the semantic table surface and snapshot contract",
      "rules": {
        "studio-rpc": ["std-table.table", "snapshot.public"]
      }
    },
    "std-table": {
      "description": "The logical table: public entrypoint, aggregate, entity surface, model, and port",
      "rules": {
        "db.public": ["std-table.table"],
        "std-table.table": ["std-table.entity", "core.public"],
        "std-table.entity": [
          "core.public",
          "std-table.definition",
          "std-table.error",
          "std-table.key"
        ],
        "std-table.definition": ["eschema.public"],
        "std-table.key": ["std-table.contract"],
        "std-table.error": ["std-table.contract"]
      }
    },
    "dynamodb": {
      "description": "DynamoDB adapter: public door down through store, topology, language, mapping, encoding, and connection",
      "rules": {
        "dynamodb.public": ["dynamodb.table", "dynamodb.setup"],
        "dynamodb.table": [
          "dynamodb.client",
          "dynamodb.expression",
          "dynamodb.item-schema"
        ],
        "dynamodb.setup": ["dynamodb.client", "std-table.definition"],
        "dynamodb.expression": ["dynamodb.attribute-value"],
        "dynamodb.item-schema": [
          "dynamodb.attribute-value",
          "std-table.contract",
          "std-table.definition"
        ]
      }
    },
    "idb": {
      "description": "IndexedDB adapter: public door down through store, mapping, connection, and open-time upgrade",
      "rules": {
        "idb.public": ["idb.table"],
        "idb.table": ["idb.database", "idb.item-schema"],
        "idb.item-schema": ["std-table.contract", "std-table.definition"],
        "idb.database": ["idb.upgrade"],
        "idb.upgrade": ["std-table.definition"]
      }
    },
    "memory": {
      "description": "Memory adapter: public door over an in-memory store",
      "rules": {
        "memory.public": ["memory.table"],
        "memory.table": ["std-table.contract", "std-table.definition"]
      }
    },
    "sqlite": {
      "description": "SQLite adapter: public door down through store, topology, language, mapping, connection, and drivers",
      "rules": {
        "sqlite.public": ["sqlite.setup", "sqlite.table", "std-table.key"],
        "sqlite.table": ["sqlite.database", "sqlite.statement"],
        "sqlite.setup": ["sqlite.database", "sqlite.statement"],
        "sqlite.statement": ["sqlite.item-schema"],
        "sqlite.item-schema": ["std-table.contract", "std-table.definition"],
        "sqlite.database": ["sqlite.item-schema"],
        "sqlite.drivers": ["sqlite.database"]
      }
    },
    "eschema": {
      "description": "ESchema entrypoint, constructs, composition, and domain",
      "rules": {
        "eschema.public": ["eschema.constructs"],
        "eschema.constructs": ["eschema.domain"],
        "eschema.domain": ["core.public"]
      }
    },
    "snapshot": {
      "description": "Snapshot facade, capture, domain, the Vitest binding, and ESchema integration",
      "rules": {
        "snapshot.public": ["snapshot.facade"],
        "snapshot.facade": [
          "eschema.constructs",
          "eschema.domain",
          "snapshot.capture"
        ],
        "snapshot.capture": ["eschema.domain", "snapshot.domain"],
        "snapshot.domain": ["eschema.public"],
        "snapshot.vitest": ["snapshot.public"]
      }
    },
    "core": {
      "description": "Core utilities",
      "rules": {
        "core.public": ["core.impl"]
      }
    },
    "sync": {
      "description": "Sync read top-down as its story: the Std Sync holds Collections; a Collection runs a Session per scope; a Session runs a Strategy under Leadership; the Sync Store is where it is kept; the domain is the words",
      "rules": {
        "sync.std-sync": ["sync.collection", "memory.public"],
        "sync.collection": ["sync.session"],
        "sync.session": ["sync.strategy", "sync.store"],
        "sync.strategy": ["core.public", "eschema.public"],
        "sync.store": [
          "idb.public",
          "sqlite.public",
          "sqlite.drivers",
          "memory.public",
          "db.public",
          "sync.domain"
        ],
        "sync.domain": ["core.public", "db.public", "eschema.public"]
      }
    },
    "alchemy": {
      "description": "Alchemy deploy targets for a StdTable: each target makes the table exist and guards its snapshot",
      "rules": {
        "alchemy.public": ["alchemy.targets", "alchemy.snapshot-guard"],
        "alchemy.targets": [
          "alchemy.snapshot-guard",
          "db.public",
          "dynamodb.public",
          "sqlite.public",
          "sqlite.drivers"
        ],
        "alchemy.snapshot-guard": ["db.public", "snapshot.public"]
      }
    }
  }
}
