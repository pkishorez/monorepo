{
  "name": "@kestack/std-toolkit",
  "version": "0.0.6",
  "private": false,
  "description": "Single-table design toolkit: database-agnostic sync over single-table item collections, with schema evolution, portable database adapters, and TanStack DB integration",
  "keywords": [
    "dynamodb",
    "effect",
    "in-memory",
    "indexeddb",
    "schema",
    "single table design",
    "sqlite",
    "sync",
    "tanstack",
    "kabuki"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/std-toolkit"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/snapshot": {
      "types": "./dist/schema/snapshot/index.d.ts",
      "default": "./dist/schema/snapshot/index.js"
    },
    "./schema/testing": {
      "types": "./dist/schema/eschema/testing/index.d.ts",
      "default": "./dist/schema/eschema/testing/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/testing": {
      "types": "./dist/db/testing/index.d.ts",
      "default": "./dist/db/testing/index.js"
    },
    "./db/dynamodb": {
      "types": "./dist/db/adapters/dynamodb/index.d.ts",
      "default": "./dist/db/adapters/dynamodb/index.js"
    },
    "./db/idb": {
      "types": "./dist/db/adapters/idb/index.d.ts",
      "default": "./dist/db/adapters/idb/index.js"
    },
    "./db/memory": {
      "types": "./dist/db/adapters/memory/index.d.ts",
      "default": "./dist/db/adapters/memory/index.js"
    },
    "./db/sqlite": {
      "types": "./dist/db/adapters/sqlite/index.d.ts",
      "default": "./dist/db/adapters/sqlite/index.js"
    },
    "./db/sqlite/better-sqlite3": {
      "types": "./dist/db/adapters/sqlite/drivers/better-sqlite3/index.d.ts",
      "default": "./dist/db/adapters/sqlite/drivers/better-sqlite3/index.js"
    },
    "./db/sqlite/bun": {
      "types": "./dist/db/adapters/sqlite/drivers/bun/index.d.ts",
      "default": "./dist/db/adapters/sqlite/drivers/bun/index.js"
    },
    "./db/sqlite/d1": {
      "types": "./dist/db/adapters/sqlite/drivers/d1/index.d.ts",
      "default": "./dist/db/adapters/sqlite/drivers/d1/index.js"
    },
    "./db/sqlite/durable-object": {
      "types": "./dist/db/adapters/sqlite/drivers/durable-object/index.d.ts",
      "default": "./dist/db/adapters/sqlite/drivers/durable-object/index.js"
    },
    "./db/sqlite/node": {
      "types": "./dist/db/adapters/sqlite/drivers/node/index.d.ts",
      "default": "./dist/db/adapters/sqlite/drivers/node/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./dist/sync/index.js"
    },
    "./sync/paced": {
      "types": "./dist/sync/paced/index.d.ts",
      "default": "./dist/sync/paced/index.js"
    },
    "./sync/idb": {
      "types": "./dist/sync/store/idb/index.d.ts",
      "default": "./dist/sync/store/idb/index.js"
    },
    "./sync/memory": {
      "types": "./dist/sync/store/memory/index.d.ts",
      "default": "./dist/sync/store/memory/index.js"
    },
    "./replica": {
      "types": "./dist/replica/index.d.ts",
      "default": "./dist/replica/index.js"
    },
    "./replica/idb": {
      "types": "./dist/replica/store/idb/index.d.ts",
      "default": "./dist/replica/store/idb/index.js"
    },
    "./replica/memory": {
      "types": "./dist/replica/store/memory/index.d.ts",
      "default": "./dist/replica/store/memory/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "default": "./dist/deploy/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dynamodb:generate": "bun scripts/dynamodb/generate.ts",
    "dynamodb:local": "docker run --rm -p 8090:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -sharedDb -inMemory",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && pnpm lint:laymos",
    "stories": "laymos stories",
    "lint:laymos": "laymos lint",
    "lint:tsc": "tsc",
    "test": "DYNAMODB_LOCAL_ENDPOINT=http://localhost:8090 REQUIRE_DYNAMODB_LOCAL=true vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@standard-schema/spec": "catalog:",
    "aws4fetch": "catalog:",
    "idb": "catalog:",
    "type-fest": "catalog:",
    "ulidx": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/aws": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@kestack/kabuki": "workspace:*",
    "@tanstack/db": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "alchemy": "catalog:",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "fake-indexeddb": "catalog:",
    "laymos": "workspace:*",
    "miniflare": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/aws": "2.0.0-beta.84",
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@kestack/kabuki": "workspace:*",
    "@tanstack/db": "0.15.2",
    "@tanstack/react-db": "0.5.12",
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.0",
    "react": "^19.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/aws": {
      "optional": true
    },
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "@kestack/kabuki": {
      "optional": true
    },
    "@tanstack/db": {
      "optional": true
    },
    "@tanstack/react-db": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
