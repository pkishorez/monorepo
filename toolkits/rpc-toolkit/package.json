{
  "name": "@kstackz/rpc-toolkit",
  "version": "0.0.0",
  "private": false,
  "description": "Effect RPC and HttpApi with Middleware both sides agree on, three Transports with a fixed protocol, and Cloudflare deploy declarations",
  "keywords": [
    "effect",
    "rpc",
    "httpapi",
    "middleware",
    "annotations"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/rpc-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "default": "./dist/rpc/index.js"
    },
    "./http-api": {
      "types": "./dist/http-api/index.d.ts",
      "default": "./dist/http-api/index.js"
    },
    "./alchemy": {
      "types": "./dist/alchemy/index.d.ts",
      "default": "./dist/alchemy/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@kstackz/std-toolkit": "workspace:*",
    "effect": "^4.0.0",
    "alchemy": "2.0.0-beta.80"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@kstackz/std-toolkit": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  }
}
