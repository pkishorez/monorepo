{
  "name": "rpc-toolkit",
  "version": "0.0.1",
  "private": false,
  "description": "Effect RPC and HttpApi Cannotations, WebSocket clients, and Cloudflare runtime and deployment integrations",
  "keywords": [
    "effect",
    "rpc",
    "httpapi",
    "middleware",
    "annotations"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "toolkits/rpc-toolkit"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "dist/"
  ],
  "exports": {
    "./rpc/cannotation": {
      "types": "./dist/rpc/cannotation/index.d.ts",
      "default": "./dist/rpc/cannotation/index.js"
    },
    "./http/cannotation": {
      "types": "./dist/http/cannotation/index.d.ts",
      "default": "./dist/http/cannotation/index.js"
    },
    "./rpc/invocation": {
      "types": "./dist/rpc/invocation/index.d.ts",
      "default": "./dist/rpc/invocation/index.js"
    },
    "./rpc/websocket-client": {
      "types": "./dist/rpc/websocket-client/index.d.ts",
      "default": "./dist/rpc/websocket-client/index.js"
    },
    "./rpc/cloudflare/hibernating-rpc": {
      "types": "./dist/rpc/cloudflare/hibernating-rpc/index.d.ts",
      "default": "./dist/rpc/cloudflare/hibernating-rpc/index.js"
    },
    "./rpc/cloudflare/alchemy/rpc-worker": {
      "types": "./dist/rpc/cloudflare/alchemy/rpc-worker/index.d.ts",
      "default": "./dist/rpc/cloudflare/alchemy/rpc-worker/index.js"
    },
    "./rpc/cloudflare/alchemy/durable-rpc-worker": {
      "types": "./dist/rpc/cloudflare/alchemy/durable-rpc-worker/index.d.ts",
      "default": "./dist/rpc/cloudflare/alchemy/durable-rpc-worker/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.110",
    "alchemy": "2.0.0-beta.72"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:",
    "alchemy": "catalog:"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  }
}
