{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "layers": {
    "theme": {
      "paths": ["src/theme"],
      "description": "web-toolkit's design tokens for Uniwind (theme.css), the Inter faces, the light/dark switch and cn(). Knows nothing above it.",
      "modules": {
        "src/theme": {
          "exposed": true
        }
      }
    },
    "feedback": {
      "paths": ["src/feedback"],
      "description": "What a gesture feels like: haptics through expo-haptics.",
      "modules": {
        "src/feedback": {
          "exposed": true
        }
      }
    },
    "input": {
      "paths": ["src/input"],
      "description": "Touch input: a GestureSurface tracks every finger by id through one Gesture Handler manual gesture and feeds them to @kstackz/use-gesture's platform-free core; GestureZones nest inside it, so the innermost zone that wants a swipe takes it; a NativeScroll keeps the swipes it can scroll; useGesture hears the surface with a core listener and may claim the touch; useWorkletGesture hears it on the UI thread, in the frame a finger moves, through a core provider of its own there. In development a script can touch a surface by hand. Knows nothing of what a gesture means.",
      "moduleGraphs": {
        "input": {
          "description": "input.tsx is the surface, the zones, the Native Scroll and the hook; zones is the Zone Tree, from where fingers land in each zone; feed turns Gesture Handler touch events into core samples; ui-thread is each surface's core provider on the UI thread, fed straight from Gesture Handler's callbacks; native-scroll is a scroll view's listener; dev-touches lets a script hand in samples in development.",
          "path": "src/input",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "input.tsx": {},
            "zones.ts": {},
            "feed.ts": {},
            "native-scroll.ts": {},
            "ui-thread.ts": {},
            "dev-touches.ts": {}
          },
          "rules": {
            "index.ts": ["input.tsx"],
            "input.tsx": [
              "zones.ts",
              "feed.ts",
              "native-scroll.ts",
              "ui-thread.ts",
              "dev-touches.ts"
            ],
            "feed.ts": ["zones.ts"],
            "dev-touches.ts": ["zones.ts"]
          }
        }
      }
    },
    "components": {
      "paths": ["src/components"],
      "description": "Owned Panel UI copies, restyled through the theme's tokens. Exposed components are the package's ./components/*; parts/ is their private interior. glyph.tsx (an app's Hugeicons in the theme's colours), portal-scope.tsx (a portal host inside the app's providers), choice.tsx (a row of pills to pick one) and meter.tsx (a thin bar of how full) are the toolkit's own.",
      "moduleGraphs": {
        "panel": {
          "description": "Panel UI as copied: each exposed component is a door; text, icons and the parts/ internals (portal, scrim, pressable, direction, keyboard and platform bridges) are what they share, each edge declared.",
          "path": "src/components",
          "modules": {
            "bottom-sheet.tsx": {
              "exposed": true
            },
            "button.tsx": {
              "exposed": true
            },
            "card.tsx": {
              "exposed": true
            },
            "choice.tsx": {
              "exposed": true
            },
            "dialog.tsx": {
              "exposed": true
            },
            "drawer.tsx": {
              "exposed": true
            },
            "empty-state.tsx": {
              "exposed": true
            },
            "field.tsx": {
              "exposed": true
            },
            "glyph.tsx": {
              "exposed": true
            },
            "icons.tsx": {
              "exposed": true
            },
            "input.tsx": {
              "exposed": true
            },
            "item.tsx": {
              "exposed": true
            },
            "label.tsx": {
              "exposed": true
            },
            "meter.tsx": {
              "exposed": true
            },
            "panel-ui-provider.tsx": {
              "exposed": true
            },
            "portal-scope.tsx": {
              "exposed": true
            },
            "separator.tsx": {
              "exposed": true
            },
            "spinner.tsx": {
              "exposed": true
            },
            "swipe.tsx": {
              "exposed": true
            },
            "switch.tsx": {
              "exposed": true
            },
            "tabs.tsx": {
              "exposed": true
            },
            "text.tsx": {
              "exposed": true
            },
            "toast.tsx": {
              "exposed": true
            },
            "typography.tsx": {
              "exposed": true
            },
            "parts/animated-pressable.tsx": {},
            "parts/focus-restoration-store.ts": {},
            "parts/haptics.ts": {},
            "parts/input-content-padding.ts": {},
            "parts/keyboard-avoider.tsx": {},
            "parts/modal-isolation-store.ts": {},
            "parts/native-host.tsx": {},
            "parts/native.ts": {},
            "parts/portal.tsx": {},
            "parts/scrim.tsx": {},
            "parts/toast-store.ts": {},
            "parts/use-back-handler.ts": {},
            "parts/use-direction.ts": {},
            "parts/use-keyboard-avoidance.ts": {}
          },
          "rules": {
            "bottom-sheet.tsx": [
              "icons.tsx",
              "parts/haptics.ts",
              "parts/native.ts",
              "parts/portal.tsx",
              "parts/scrim.tsx",
              "parts/use-back-handler.ts",
              "text.tsx"
            ],
            "button.tsx": [
              "icons.tsx",
              "parts/animated-pressable.tsx",
              "parts/native.ts",
              "spinner.tsx",
              "text.tsx"
            ],
            "card.tsx": ["text.tsx"],
            "choice.tsx": ["icons.tsx", "text.tsx"],
            "dialog.tsx": [
              "parts/portal.tsx",
              "parts/scrim.tsx",
              "parts/use-back-handler.ts",
              "text.tsx"
            ],
            "drawer.tsx": [
              "icons.tsx",
              "parts/portal.tsx",
              "parts/scrim.tsx",
              "parts/use-back-handler.ts",
              "parts/use-direction.ts",
              "text.tsx"
            ],
            "empty-state.tsx": ["text.tsx"],
            "field.tsx": ["label.tsx", "separator.tsx", "text.tsx"],
            "glyph.tsx": ["icons.tsx"],
            "icons.tsx": ["parts/use-direction.ts"],
            "input.tsx": [
              "icons.tsx",
              "label.tsx",
              "parts/input-content-padding.ts",
              "parts/keyboard-avoider.tsx",
              "parts/use-keyboard-avoidance.ts",
              "text.tsx"
            ],
            "item.tsx": ["parts/animated-pressable.tsx", "text.tsx"],
            "label.tsx": ["text.tsx"],
            "panel-ui-provider.tsx": ["parts/portal.tsx", "toast.tsx"],
            "portal-scope.tsx": ["parts/portal.tsx"],
            "separator.tsx": ["text.tsx"],
            "swipe.tsx": [
              "icons.tsx",
              "parts/animated-pressable.tsx",
              "parts/haptics.ts",
              "parts/use-direction.ts",
              "text.tsx"
            ],
            "switch.tsx": [
              "field.tsx",
              "parts/haptics.ts",
              "parts/native.ts",
              "parts/use-direction.ts"
            ],
            "tabs.tsx": ["parts/use-direction.ts", "text.tsx"],
            "text.tsx": ["parts/use-direction.ts"],
            "toast.tsx": [
              "button.tsx",
              "icons.tsx",
              "parts/portal.tsx",
              "parts/toast-store.ts",
              "text.tsx"
            ],
            "typography.tsx": ["text.tsx"],
            "parts/keyboard-avoider.tsx": [
              "parts/use-keyboard-avoidance.ts",
              "text.tsx"
            ],
            "parts/native.ts": ["parts/native-host.tsx"],
            "parts/portal.tsx": [
              "parts/focus-restoration-store.ts",
              "parts/modal-isolation-store.ts"
            ]
          }
        }
      }
    },
    "recipes": {
      "paths": ["src/recipes"],
      "description": "Whole interactions built from components, input and feedback: the Thumb Lock's Thumb Picker, the Sidebar that pushes the page aside, with its swipe from anywhere, the Local Sign-In dialog, the sheet for a short form, the row swiped to delete, pages turned by a sideways swipe in a Gesture Zone of their own, and the Key Bar's message at the foot. A recipe with parts is a module graph of its own.",
      "modules": {
        "src/recipes/sheet": {
          "exposed": true
        },
        "src/recipes/key-bar": {
          "exposed": true
        },
        "src/recipes/local-sign-in": {
          "exposed": true
        },
        "src/recipes/swipe-row": {
          "exposed": true
        },
        "src/recipes/pages": {
          "exposed": true
        }
      },
      "moduleGraphs": {
        "thumb-picker": {
          "description": "thumb-picker.tsx runs use-gesture's Thumb Lock and a picking on the UI thread through the surface and writes what the menu shows; picking walks the tree with no UI; view is what the menu shows, as data the UI thread writes; menu draws the scrim, every list up front and the shake, moved by that view; list draws one list's rows, plain and marked; motion holds the springs and reduced motion; choice is the tree's shape.",
          "path": "src/recipes/thumb-picker",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "thumb-picker.tsx": {},
            "picking.ts": {},
            "view.ts": {},
            "menu.tsx": {},
            "list.tsx": {},
            "motion.ts": {},
            "choice.ts": {}
          },
          "rules": {
            "index.ts": ["thumb-picker.tsx"],
            "thumb-picker.tsx": [
              "choice.ts",
              "menu.tsx",
              "picking.ts",
              "view.ts"
            ],
            "picking.ts": ["view.ts"],
            "view.ts": ["choice.ts"],
            "menu.tsx": ["choice.ts", "list.tsx", "motion.ts", "view.ts"],
            "list.tsx": ["choice.ts"]
          }
        },
        "sidebar": {
          "description": "sidebar.tsx holds whether it is open and how far, and hears its swipe; push draws the page pushed aside with the Sidebar under it and the drag that shuts it; motion holds the width, the spring and when a drag shuts; swipe is the swipe that opens it from anywhere, as a core listener.",
          "path": "src/recipes/sidebar",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "sidebar.tsx": {},
            "push.tsx": {},
            "motion.ts": {},
            "swipe.ts": {}
          },
          "rules": {
            "index.ts": ["sidebar.tsx"],
            "sidebar.tsx": ["motion.ts", "push.tsx", "swipe.ts"],
            "push.tsx": ["motion.ts"]
          }
        }
      }
    },
    "platform": {
      "paths": ["src/platform"],
      "description": "The phone as an app's platform, for auth-toolkit's createApp: tables and copies in expo-sqlite, cloud sign-in in the system sheet, and the Gate's memory in secure storage, with the network, the foreground and a launch link's ?backend=. Knows nothing of what the app shows.",
      "modules": {
        "src/platform": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "expo-toolkit": {
      "description": "Recipes stand on components, input and feedback; components stand on theme, and on input for a row that scrolls sideways; theme, feedback and input stand alone.",
      "rules": {
        "recipes": ["components", "input", "feedback"],
        "components": ["theme", "input"],
        "input": [],
        "feedback": [],
        "theme": [],
        "platform": []
      }
    }
  }
}
