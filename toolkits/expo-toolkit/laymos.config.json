{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "layers": {
    "theme": {
      "paths": ["src/theme"],
      "description": "Ledger's design tokens for Uniwind (theme.css), the Inter faces, the light/dark switch and cn(). Knows nothing above it.",
      "modules": {
        "src/theme": {
          "exposed": true
        }
      }
    },
    "feedback": {
      "paths": ["src/feedback"],
      "description": "What a gesture feels and sounds like: haptics through expo-haptics, short sounds through a preloaded expo-audio player pool.",
      "modules": {
        "src/feedback": {
          "exposed": true
        }
      }
    },
    "input": {
      "paths": ["src/input"],
      "description": "Touch input: a GestureSurface tracks every finger by id through one Gesture Handler manual gesture and feeds them to @kstackz/use-gesture's platform-free core; useGesture hears them with a core listener and may claim the touch. In development a script can touch a surface by hand. Knows nothing of what a gesture means.",
      "moduleGraphs": {
        "input": {
          "description": "input.tsx is the surface and the hook; feed turns Gesture Handler touch events into core samples; dev-touches lets a script hand in samples in development.",
          "path": "src/input",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "input.tsx": {},
            "feed.ts": {},
            "dev-touches.ts": {}
          },
          "rules": {
            "index.ts": ["input.tsx"],
            "input.tsx": ["feed.ts", "dev-touches.ts"]
          }
        }
      }
    },
    "components": {
      "paths": ["src/components"],
      "description": "Owned Panel UI copies, restyled through the theme's tokens. Exposed components are the package's ./components/*; parts/ is their private interior. glyph.tsx (an app's Hugeicons in the theme's colours) and portal-scope.tsx (a portal host inside the app's providers) are the toolkit's own.",
      "moduleGraphs": {
        "panel": {
          "description": "Panel UI as copied: each exposed component is a door; text, icons and the parts/ internals (portal, scrim, pressable, direction, keyboard and platform bridges) are what they share, each edge declared.",
          "path": "src/components",
          "modules": {
            "bottom-sheet.tsx": {
              "exposed": true
            },
            "button.tsx": {
              "exposed": true
            },
            "card.tsx": {
              "exposed": true
            },
            "dialog.tsx": {
              "exposed": true
            },
            "drawer.tsx": {
              "exposed": true
            },
            "empty-state.tsx": {
              "exposed": true
            },
            "field.tsx": {
              "exposed": true
            },
            "glyph.tsx": {
              "exposed": true
            },
            "icons.tsx": {
              "exposed": true
            },
            "input.tsx": {
              "exposed": true
            },
            "item.tsx": {
              "exposed": true
            },
            "label.tsx": {
              "exposed": true
            },
            "panel-ui-provider.tsx": {
              "exposed": true
            },
            "portal-scope.tsx": {
              "exposed": true
            },
            "separator.tsx": {
              "exposed": true
            },
            "spinner.tsx": {
              "exposed": true
            },
            "swipe.tsx": {
              "exposed": true
            },
            "switch.tsx": {
              "exposed": true
            },
            "tabs.tsx": {
              "exposed": true
            },
            "text.tsx": {
              "exposed": true
            },
            "toast.tsx": {
              "exposed": true
            },
            "typography.tsx": {
              "exposed": true
            },
            "parts/animated-pressable.tsx": {},
            "parts/focus-restoration-store.ts": {},
            "parts/haptics.ts": {},
            "parts/input-content-padding.ts": {},
            "parts/keyboard-avoider.tsx": {},
            "parts/modal-isolation-store.ts": {},
            "parts/native-host.tsx": {},
            "parts/native.ts": {},
            "parts/portal.tsx": {},
            "parts/scrim.tsx": {},
            "parts/toast-store.ts": {},
            "parts/use-back-handler.ts": {},
            "parts/use-direction.ts": {},
            "parts/use-keyboard-avoidance.ts": {}
          },
          "rules": {
            "bottom-sheet.tsx": [
              "icons.tsx",
              "parts/haptics.ts",
              "parts/native.ts",
              "parts/portal.tsx",
              "parts/scrim.tsx",
              "parts/use-back-handler.ts",
              "text.tsx"
            ],
            "button.tsx": [
              "icons.tsx",
              "parts/animated-pressable.tsx",
              "parts/native.ts",
              "spinner.tsx",
              "text.tsx"
            ],
            "card.tsx": ["text.tsx"],
            "dialog.tsx": [
              "parts/portal.tsx",
              "parts/scrim.tsx",
              "parts/use-back-handler.ts",
              "text.tsx"
            ],
            "drawer.tsx": [
              "icons.tsx",
              "parts/portal.tsx",
              "parts/scrim.tsx",
              "parts/use-back-handler.ts",
              "parts/use-direction.ts",
              "text.tsx"
            ],
            "empty-state.tsx": ["text.tsx"],
            "field.tsx": ["label.tsx", "separator.tsx", "text.tsx"],
            "glyph.tsx": ["icons.tsx"],
            "icons.tsx": ["parts/use-direction.ts"],
            "input.tsx": [
              "icons.tsx",
              "label.tsx",
              "parts/input-content-padding.ts",
              "parts/keyboard-avoider.tsx",
              "parts/use-keyboard-avoidance.ts",
              "text.tsx"
            ],
            "item.tsx": ["parts/animated-pressable.tsx", "text.tsx"],
            "label.tsx": ["text.tsx"],
            "panel-ui-provider.tsx": ["parts/portal.tsx", "toast.tsx"],
            "portal-scope.tsx": ["parts/portal.tsx"],
            "separator.tsx": ["text.tsx"],
            "swipe.tsx": [
              "icons.tsx",
              "parts/animated-pressable.tsx",
              "parts/haptics.ts",
              "parts/use-direction.ts",
              "text.tsx"
            ],
            "switch.tsx": [
              "field.tsx",
              "parts/haptics.ts",
              "parts/native.ts",
              "parts/use-direction.ts"
            ],
            "tabs.tsx": ["parts/use-direction.ts", "text.tsx"],
            "text.tsx": ["parts/use-direction.ts"],
            "toast.tsx": [
              "button.tsx",
              "icons.tsx",
              "parts/portal.tsx",
              "parts/toast-store.ts",
              "text.tsx"
            ],
            "typography.tsx": ["text.tsx"],
            "parts/keyboard-avoider.tsx": [
              "parts/use-keyboard-avoidance.ts",
              "text.tsx"
            ],
            "parts/native.ts": ["parts/native-host.tsx"],
            "parts/portal.tsx": [
              "parts/focus-restoration-store.ts",
              "parts/modal-isolation-store.ts"
            ]
          }
        }
      }
    },
    "patterns": {
      "paths": ["src/patterns"],
      "description": "Whole interactions built from components, input and feedback: the Thumb Lock's Thumb Picker, the Sidebar as a drawer with its edge swipe, and the Local Sign-In dialog; the sheet and the Key Bar are stubs. A pattern with parts is a module graph of its own.",
      "modules": {
        "src/patterns/sheet": {
          "exposed": true
        },
        "src/patterns/key-bar": {
          "exposed": true
        },
        "src/patterns/local-sign-in": {
          "exposed": true
        }
      },
      "moduleGraphs": {
        "thumb-picker": {
          "description": "thumb-picker.tsx binds use-gesture's Thumb Lock to the surface and runs a picking; picking walks the tree with no UI; menu draws the scrim, the lists and the shake; list draws one list's rows; motion holds the springs and reduced motion; choice is the tree's shape.",
          "path": "src/patterns/thumb-picker",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "thumb-picker.tsx": {},
            "picking.ts": {},
            "menu.tsx": {},
            "list.tsx": {},
            "motion.ts": {},
            "choice.ts": {}
          },
          "rules": {
            "index.ts": ["thumb-picker.tsx"],
            "thumb-picker.tsx": ["choice.ts", "menu.tsx", "picking.ts"],
            "picking.ts": ["choice.ts"],
            "menu.tsx": ["choice.ts", "list.tsx", "motion.ts"],
            "list.tsx": ["choice.ts", "motion.ts"]
          }
        },
        "sidebar": {
          "description": "sidebar.tsx holds whether it is open, draws the drawer and hears the edge; edge is the edge swipe as a core listener.",
          "path": "src/patterns/sidebar",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "sidebar.tsx": {},
            "edge.ts": {}
          },
          "rules": {
            "index.ts": ["sidebar.tsx"],
            "sidebar.tsx": ["edge.ts"]
          }
        }
      }
    }
  },
  "layerGraphs": {
    "expo-toolkit": {
      "description": "Patterns stand on components, input and feedback; components stand on theme; theme, feedback and input stand alone.",
      "rules": {
        "patterns": ["components", "input", "feedback"],
        "components": ["theme"],
        "input": [],
        "feedback": [],
        "theme": []
      }
    }
  }
}
