{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "std-toolkit/core": ["./src/core/index.ts"],
      "std-toolkit/eschema": ["./src/eschema/index.ts"],
      "std-toolkit/snapshot": ["./src/snapshot/index.ts"],
      "std-toolkit/sync": ["./src/sync/index.ts"],
      "std-toolkit/sync/paced": ["./src/sync/runtime/mutation-pacing/index.ts"],
      "std-toolkit/sync/platform/browser": [
        "./src/sync/platform/browser/index.ts"
      ],
      "std-toolkit/sync/leadership/in-memory": [
        "./src/sync/runtime/leadership/in-memory/index.ts"
      ],
      "std-toolkit/sync/leadership/web-locks": [
        "./src/sync/runtime/leadership/web-locks/index.ts"
      ],
      "std-toolkit/db": ["./src/db/index.ts"],
      "std-toolkit/db/dynamodb": ["./src/db/dynamodb/index.ts"],
      "std-toolkit/db/idb": ["./src/db/idb/index.ts"],
      "std-toolkit/db/memory": ["./src/db/memory/index.ts"],
      "std-toolkit/db/sqlite": ["./src/db/sqlite/index.ts"],
      "std-toolkit/db/sqlite/better-sqlite3": [
        "./src/db/sqlite/drivers/better-sqlite3/index.ts"
      ],
      "std-toolkit/db/sqlite/bun": ["./src/db/sqlite/drivers/bun/index.ts"],
      "std-toolkit/db/sqlite/durable-object": [
        "./src/db/sqlite/drivers/durable-object/index.ts"
      ],
      "std-toolkit/db/sqlite/node": ["./src/db/sqlite/drivers/node/index.ts"]
    },
    "rootDir": ".",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "laymos/**/*", "stories/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "src/db/sqlite/sql/adapters/bun",
    "src/db/sqlite/sql/adapters/__tests__/bun.bun.test.ts",
    "src/db/sqlite/sql/adapters/__tests__/compat.bun.test.ts",
    "src/db/sqlite/sql/adapters/__tests__/compat-read-better-sqlite3.ts",
    "src/db/sqlite/sql/adapters/__tests__/compat-seed-better-sqlite3.ts"
  ]
}
