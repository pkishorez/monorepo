{
  "name": "std-toolkit",
  "version": "0.0.2",
  "private": false,
  "description": "Single-table design toolkit — database-agnostic sync over single-table item collections, with schema evolution, DynamoDB/SQLite adapters, and TanStack DB integration",
  "keywords": [
    "dynamodb",
    "effect",
    "indexeddb",
    "schema",
    "single table design",
    "sqlite",
    "sync",
    "tanstack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "std-toolkit": "bin/std-toolkit.mjs"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./eschema": {
      "types": "./dist/eschema/index.d.ts",
      "default": "./dist/eschema/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "default": "./dist/snapshot/index.js"
    },
    "./dynamodb": {
      "types": "./dist/db/dynamodb/index.d.ts",
      "default": "./dist/db/dynamodb/index.js"
    },
    "./dynamodb/client": {
      "types": "./dist/db/dynamodb/clients/dynamodb-client/index.d.ts",
      "default": "./dist/db/dynamodb/clients/dynamodb-client/index.js"
    },
    "./idb": {
      "types": "./dist/db/idb/index.d.ts",
      "default": "./dist/db/idb/index.js"
    },
    "./sqlite": {
      "types": "./dist/db/sqlite/index.d.ts",
      "default": "./dist/db/sqlite/index.js"
    },
    "./sqlite/adapters/do": {
      "types": "./dist/db/sqlite/sql/adapters/durable-object/index.d.ts",
      "default": "./dist/db/sqlite/sql/adapters/durable-object/index.js"
    },
    "./sqlite/adapters/better-sqlite3": {
      "types": "./dist/db/sqlite/sql/adapters/better-sqlite3/index.d.ts",
      "default": "./dist/db/sqlite/sql/adapters/better-sqlite3/index.js"
    },
    "./sqlite/adapters/bun": {
      "types": "./dist/db/sqlite/sql/adapters/bun/index.d.ts",
      "default": "./dist/db/sqlite/sql/adapters/bun/index.js"
    },
    "./sqlite/adapters/node": {
      "types": "./dist/db/sqlite/sql/adapters/node/index.d.ts",
      "default": "./dist/db/sqlite/sql/adapters/node/index.js"
    },
    "./tanstack-sync": {
      "types": "./dist/tanstack-sync/index.d.ts",
      "default": "./dist/tanstack-sync/index.js"
    },
    "./tanstack-sync/paced": {
      "types": "./dist/tanstack-sync/runtime/mutation-pacing/index.d.ts",
      "default": "./dist/tanstack-sync/runtime/mutation-pacing/index.js"
    },
    "./tanstack-sync/offline-storage/idb": {
      "types": "./dist/tanstack-sync/persistence/indexed-db-storage/index.d.ts",
      "default": "./dist/tanstack-sync/persistence/indexed-db-storage/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dynamodb:generate": "bun scripts/dynamodb/generate.ts",
    "dynamodb:local": "docker run --rm -p 8090:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -sharedDb -inMemory",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "lint:tsc": "tsc",
    "sqlite:play": "bun src/db/sqlite/play.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pkishorez/effect-tracer": "workspace:*",
    "@standard-schema/spec": "catalog:",
    "aws4fetch": "catalog:",
    "idb": "catalog:",
    "jiti": "catalog:",
    "type-fest": "catalog:",
    "ulidx": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "fake-indexeddb": "catalog:",
    "laymos": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-db": ">=0.1.64",
    "effect": "^4.0.0-beta.102",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-db": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
