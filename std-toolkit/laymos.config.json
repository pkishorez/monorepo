{
  "$schema": "../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/core/__tests__",
    "src/db/__tests__",
    "src/db/dynamodb/__tests__",
    "src/db/dynamodb/domain/expression/__tests__",
    "src/db/dynamodb/play",
    "src/db/idb/__tests__",
    "src/db/sqlite/__tests__",
    "src/db/sqlite/services/__tests__",
    "src/db/sqlite/sql/adapters/__tests__",
    "src/db/sqlite/play.ts",
    "src/eschema/__tests__",
    "src/eschema/play.ts",
    "src/eschema/tutorial",
    "src/snapshot/__tests__",
    "src/tanstack-sync/__tests__",
    "src/tanstack-sync/cadence-sync/__tests__",
    "src/tanstack-sync/offline-storage/__tests__",
    "src/tanstack-sync/partitioned/__tests__",
    "src/tanstack-sync/partitioned/strategies/bidirectional/__tests__",
    "src/tanstack-sync/partitioned/strategies/new-to-old/__tests__",
    "src/tanstack-sync/source-of-truth/__tests__"
  ],
  "layers": {
    "eschema-barrel": {
      "paths": ["src/eschema/index.ts"],
      "description": "Public barrel"
    },
    "eschema-constructs": {
      "paths": [
        "src/eschema/eschema",
        "src/eschema/entity-eschema",
        "src/eschema/value-eschema"
      ],
      "description": "Public ESchema variants and their local builders"
    },
    "eschema-composition": {
      "paths": ["src/eschema/schema-composition"],
      "description": "Effect Schema composition"
    },
    "eschema-domain": {
      "paths": ["src/eschema/domain"],
      "description": "Evolution, field policy, runtimes, errors, and introspection"
    },
    "snapshot-barrel": {
      "paths": ["src/snapshot/index.ts"],
      "description": "Public barrel"
    },
    "snapshot-facade": {
      "paths": ["src/snapshot/snapshot"],
      "description": "Public Snapshot operation composition"
    },
    "snapshot-capture": {
      "paths": ["src/snapshot/capture"],
      "description": "ESchema and table contract capture"
    },
    "snapshot-domain": {
      "paths": ["src/snapshot/domain"],
      "description": "Snapshot models, errors, and canonical ordering"
    },
    "cli": {
      "paths": ["src/cli"],
      "description": "Command-line entrypoint and snapshot workflow"
    },
    "core-barrel": {
      "paths": ["src/core/index.ts"],
      "description": "Public barrel"
    },
    "core-impl": {
      "paths": [
        "src/core/broadcaster.ts",
        "src/core/error.ts",
        "src/core/schema.ts",
        "src/core/ulid.ts"
      ],
      "description": "Internal implementation"
    },
    "dynamodb-barrel": {
      "paths": ["src/db/dynamodb/index.ts"],
      "description": "Public barrel"
    },
    "dynamodb-orchestrators": {
      "paths": ["src/db/dynamodb/orchestrators"],
      "description": "Composition of table topology, entities, transactions, and snapshots"
    },
    "dynamodb-services": {
      "paths": ["src/db/dynamodb/services"],
      "description": "Runtime bindings and persistence capabilities"
    },
    "dynamodb-clients": {
      "paths": ["src/db/dynamodb/clients"],
      "description": "Generated API execution and AWS request signing"
    },
    "dynamodb-domain": {
      "paths": ["src/db/dynamodb/domain", "src/db/dynamodb/types"],
      "description": "Pure table identity, persistence, expressions, and attribute values"
    },
    "db-persistence-domain": {
      "paths": ["src/db/domain"],
      "description": "Shared persistence failures and entity registration"
    },
    "idb-barrel": {
      "paths": ["src/db/idb/index.ts"],
      "description": "Public barrel"
    },
    "idb-orchestrators": {
      "paths": ["src/db/idb/orchestrators"],
      "description": "Public table composition"
    },
    "idb-services": {
      "paths": ["src/db/idb/services"],
      "description": "Private database, table, and entity capabilities"
    },
    "idb-clients": {
      "paths": ["src/db/idb/clients"],
      "description": "Browser IndexedDB implementation and layer wiring"
    },
    "idb-domain": {
      "paths": ["src/db/idb/domain"],
      "description": "Pure IndexedDB persistence derivation"
    },
    "sqlite-barrel": {
      "paths": ["src/db/sqlite/index.ts"],
      "description": "Public barrel"
    },
    "sqlite-services": {
      "paths": ["src/db/sqlite/services"],
      "description": "Entity/command surface"
    },
    "sqlite-orchestrators": {
      "paths": ["src/db/sqlite/orchestrators"],
      "description": "Public table composition"
    },
    "sqlite-clients": {
      "paths": ["src/db/sqlite/clients"],
      "description": "Native SQLite client contract"
    },
    "sqlite-domain": {
      "paths": ["src/db/sqlite/domain"],
      "description": "Pure SQL and entity persistence derivation"
    },
    "sqlite-adapters": {
      "paths": ["src/db/sqlite/sql/adapters"],
      "description": "Runtime-specific SQLite bindings"
    },
    "sync-entrypoint": {
      "paths": [
        "src/tanstack-sync/index.ts",
        "src/tanstack-sync/create-std-sync.ts"
      ],
      "description": "Public API entrypoints"
    },
    "sync-partitioned": {
      "paths": ["src/tanstack-sync/partitioned"],
      "description": "Partitioned collection sync and shared strategy runtime"
    },
    "sync-single-item": {
      "paths": ["src/tanstack-sync/single-item"],
      "description": "Single-item sync, built on the partitioned runtime"
    },
    "sync-cadence": {
      "paths": ["src/tanstack-sync/cadence-sync"],
      "description": "Cadence scheduling shared by both strategies"
    },
    "sync-projection": {
      "paths": ["src/tanstack-sync/collection-projection"],
      "description": "Collection view / projector"
    },
    "sync-inspector": {
      "paths": ["src/tanstack-sync/inspector"],
      "description": "Devtools inspector collections and row types"
    },
    "sync-paced": {
      "paths": ["src/tanstack-sync/paced"],
      "description": "Pacing and coalescing infrastructure"
    },
    "sync-registry": {
      "paths": ["src/tanstack-sync/registry"],
      "description": "Tracker and registry"
    },
    "sync-source-of-truth": {
      "paths": ["src/tanstack-sync/source-of-truth"],
      "description": "Convergence engine and write-error types"
    },
    "sync-offline-storage": {
      "paths": ["src/tanstack-sync/offline-storage"],
      "description": "Internal grouped key-value storage and public adapters"
    },
    "sync-util": {
      "paths": ["src/tanstack-sync/util", "src/tanstack-sync/types.ts"],
      "description": "Shared types and utility helpers"
    }
  },
  "modules": {
    "src/cli": {},
    "src/core/broadcaster.ts": {},
    "src/core/error.ts": {},
    "src/core/index.ts": {},
    "src/core/schema.ts": { "shared": true },
    "src/core/ulid.ts": {},
    "src/db/dynamodb/clients/dynamodb-client": {},
    "src/db/dynamodb/domain/attribute-value": { "shared": true },
    "src/db/dynamodb/domain/client-error": {},
    "src/db/dynamodb/domain/dynamodb-error": {},
    "src/db/dynamodb/domain/entity-persistence": {},
    "src/db/dynamodb/domain/expression": {},
    "src/db/dynamodb/domain/table-identity": { "shared": true },
    "src/db/dynamodb/index.ts": {},
    "src/db/dynamodb/orchestrators/dynamo-table": {},
    "src/db/dynamodb/services/dynamo-entity": { "shared": true },
    "src/db/dynamodb/services/dynamo-single-entity": { "shared": true },
    "src/db/dynamodb/services/dynamo-table": {},
    "src/db/dynamodb/services/dynamodb": { "shared": true },
    "src/db/dynamodb/types": { "shared": true },
    "src/db/domain/entity-registry": { "shared": true },
    "src/db/domain/persistence-error": { "shared": true },
    "src/db/idb/clients/idb-client": {},
    "src/db/idb/domain/entity-persistence": {},
    "src/db/idb/domain/idb-error": {},
    "src/db/idb/index.ts": {},
    "src/db/idb/orchestrators/idb-table": {},
    "src/db/idb/services/idb-database": { "shared": true },
    "src/db/idb/services/idb-entity": { "shared": true },
    "src/db/idb/services/idb-single-entity": { "shared": true },
    "src/db/idb/services/idb-table": {},
    "src/db/sqlite/index.ts": {},
    "src/db/sqlite/clients/sqlite-client": {},
    "src/db/sqlite/domain/entity-persistence": {},
    "src/db/sqlite/domain/sql-statement": {},
    "src/db/sqlite/domain/sqlite-error": {},
    "src/db/sqlite/orchestrators/sqlite-table": {},
    "src/db/sqlite/services/sqlite-database": { "shared": true },
    "src/db/sqlite/services/sqlite-entity": { "shared": true },
    "src/db/sqlite/services/sqlite-single-entity": { "shared": true },
    "src/db/sqlite/services/sqlite-table": {},
    "src/db/sqlite/sql/adapters/better-sqlite3": {},
    "src/db/sqlite/sql/adapters/bun": {},
    "src/db/sqlite/sql/adapters/durable-object": {},
    "src/db/sqlite/sql/adapters/node": {},
    "src/eschema/domain/eschema-error": { "shared": true },
    "src/eschema/domain/introspection": { "shared": true },
    "src/eschema/domain/object-schema-runtime": {},
    "src/eschema/domain/schema-model": { "shared": true },
    "src/eschema/entity-eschema": {},
    "src/eschema/eschema": { "shared": true },
    "src/eschema/index.ts": {},
    "src/eschema/schema-composition": {},
    "src/eschema/value-eschema": {},
    "src/snapshot/capture/eschema-capture": { "shared": true },
    "src/snapshot/capture/table-capture": { "shared": true },
    "src/snapshot/domain": {},
    "src/snapshot/index.ts": {},
    "src/snapshot/snapshot": {},
    "src/tanstack-sync/cadence-sync": {},
    "src/tanstack-sync/collection-projection": {},
    "src/tanstack-sync/create-std-sync.ts": { "shared": true },
    "src/tanstack-sync/index.ts": {},
    "src/tanstack-sync/inspector": {},
    "src/tanstack-sync/offline-storage": {},
    "src/tanstack-sync/paced": {},
    "src/tanstack-sync/partitioned": {},
    "src/tanstack-sync/registry": {},
    "src/tanstack-sync/single-item": {},
    "src/tanstack-sync/source-of-truth": {},
    "src/tanstack-sync/types.ts": { "shared": true },
    "src/tanstack-sync/util": {}
  },
  "layerGraphs": {
    "eschema": {
      "description": "ESchema entrypoint, constructs, composition, and domain",
      "rules": {
        "eschema-barrel": [
          "eschema-constructs",
          "eschema-composition",
          "eschema-domain"
        ],
        "eschema-constructs": ["eschema-domain"],
        "eschema-composition": ["eschema-domain"]
      }
    },
    "snapshot": {
      "description": "Snapshot facade, capture, domain, and one-way ESchema integration",
      "rules": {
        "snapshot-barrel": ["snapshot-facade", "snapshot-domain"],
        "snapshot-facade": [
          "snapshot-capture",
          "snapshot-domain",
          "eschema-domain",
          "eschema-constructs"
        ],
        "snapshot-capture": ["snapshot-domain", "eschema-domain"],
        "snapshot-domain": []
      }
    },
    "core": {
      "description": "Core utilities and their schema dependency",
      "rules": {
        "core-barrel": ["core-impl"],
        "core-impl": ["eschema-barrel"]
      }
    },
    "cli": {
      "description": "Command-line access to semantic snapshots",
      "rules": {
        "cli": ["snapshot-barrel"]
      }
    },
    "dynamodb": {
      "description": "DynamoDB entrypoint, orchestration, runtime services, clients, and pure domain",
      "rules": {
        "dynamodb-barrel": [
          "dynamodb-orchestrators",
          "dynamodb-services",
          "dynamodb-clients",
          "dynamodb-domain"
        ],
        "dynamodb-orchestrators": [
          "dynamodb-services",
          "dynamodb-domain",
          "core-barrel",
          "snapshot-barrel"
        ],
        "dynamodb-services": [
          "dynamodb-clients",
          "dynamodb-domain",
          "db-persistence-domain",
          "core-barrel",
          "snapshot-barrel",
          "snapshot-capture"
        ],
        "dynamodb-clients": ["dynamodb-domain"],
        "dynamodb-domain": ["db-persistence-domain", "core-barrel"]
      }
    },
    "idb": {
      "description": "IndexedDB services, browser wiring, and storage internals",
      "rules": {
        "idb-barrel": ["idb-orchestrators", "idb-clients", "idb-services"],
        "idb-orchestrators": ["idb-services", "core-barrel"],
        "idb-services": [
          "idb-domain",
          "db-persistence-domain",
          "core-barrel",
          "snapshot-barrel",
          "snapshot-capture"
        ],
        "idb-clients": ["idb-services"],
        "idb-domain": ["db-persistence-domain", "core-barrel"]
      }
    },
    "sqlite": {
      "description": "SQLite services, SQL adapters, and storage internals",
      "rules": {
        "sqlite-barrel": ["sqlite-orchestrators", "sqlite-services"],
        "sqlite-orchestrators": ["sqlite-services", "core-barrel"],
        "sqlite-services": [
          "sqlite-clients",
          "sqlite-domain",
          "db-persistence-domain",
          "core-barrel",
          "snapshot-barrel",
          "snapshot-capture"
        ],
        "sqlite-clients": [],
        "sqlite-domain": ["db-persistence-domain", "core-barrel"],
        "sqlite-adapters": ["sqlite-clients", "sqlite-services"]
      }
    },
    "tanstack-sync": {
      "description": "TanStack sync entrypoints, strategies, convergence, and persistence",
      "rules": {
        "sync-entrypoint": [
          "sync-single-item",
          "sync-partitioned",
          "sync-cadence",
          "sync-inspector",
          "sync-offline-storage",
          "sync-paced",
          "sync-registry",
          "sync-util",
          "core-barrel"
        ],
        "sync-single-item": [
          "sync-partitioned",
          "sync-projection",
          "sync-inspector",
          "sync-paced",
          "sync-registry",
          "sync-source-of-truth",
          "sync-offline-storage",
          "sync-util",
          "core-barrel"
        ],
        "sync-partitioned": [
          "sync-cadence",
          "sync-projection",
          "sync-inspector",
          "sync-paced",
          "sync-registry",
          "sync-source-of-truth",
          "sync-offline-storage",
          "sync-util",
          "core-barrel"
        ],
        "sync-cadence": ["sync-source-of-truth", "sync-util", "core-barrel"],
        "sync-projection": ["sync-source-of-truth", "sync-util", "core-barrel"],
        "sync-registry": ["sync-source-of-truth", "core-barrel"],
        "sync-inspector": ["sync-offline-storage", "sync-util"],
        "sync-source-of-truth": ["sync-offline-storage", "core-barrel"],
        "sync-util": ["core-barrel"]
      }
    }
  }
}
