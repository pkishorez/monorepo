  "layerGraphs": {
    "std-table": {
      "description": "The logical table: public entrypoint, aggregate, entity surface, model, and port",
      "rules": {
        "db.public": ["std-table.table"],
        "std-table.table": ["std-table.entity"],
        "std-table.entity": [
          "core.public",
          "std-table.definition",
          "std-table.error",
          "std-table.key"
        ],
        "std-table.definition": ["std-table.snapshot"],
        "std-table.snapshot": ["eschema.public", "snapshot.capture"],
        "std-table.key": ["std-table.contract"],
        "std-table.error": ["std-table.contract"]
      }
    },
    "dynamodb": {
      "description": "DynamoDB adapter: public door down through store, topology, language, mapping, encoding, and connection",
      "rules": {
        "dynamodb.public": ["dynamodb.native", "dynamodb.table"],
        "dynamodb.native": [
          "core.public",
          "dynamodb.expression",
          "dynamodb.item-schema",
          "dynamodb.setup",
          "std-table.key"
        ],
        "dynamodb.table": [
          "dynamodb.client",
          "dynamodb.expression",
          "dynamodb.item-schema"
        ],
        "dynamodb.setup": ["dynamodb.client", "std-table.definition"],
        "dynamodb.expression": ["dynamodb.attribute-value"],
        "dynamodb.item-schema": [
          "dynamodb.attribute-value",
          "std-table.contract",
          "std-table.definition"
        ]
      }
    },
    "idb": {
      "description": "IndexedDB adapter: public door down through store, mapping, connection, and open-time upgrade",
      "rules": {
        "idb.public": ["idb.table"],
        "idb.table": ["idb.database", "idb.item-schema"],
        "idb.item-schema": ["std-table.contract", "std-table.definition"],
        "idb.database": ["idb.upgrade"],
        "idb.upgrade": ["std-table.definition"]
      }
    },
    "memory": {
      "description": "Memory adapter: public door over an in-memory store",
      "rules": {
        "memory.public": ["memory.table"],
        "memory.table": ["std-table.contract", "std-table.definition"]
      }
    },
    "sqlite": {
      "description": "SQLite adapter: public door down through store, topology, language, mapping, connection, and drivers",
      "rules": {
        "sqlite.public": ["sqlite.setup", "sqlite.table"],
        "sqlite.table": ["sqlite.database", "sqlite.statement"],
        "sqlite.setup": ["sqlite.database", "sqlite.statement"],
        "sqlite.statement": ["sqlite.item-schema"],
        "sqlite.item-schema": ["std-table.contract", "std-table.definition"],
        "sqlite.database": ["sqlite.item-schema"],
        "sqlite.drivers": ["sqlite.database"]
      }
    },
    "eschema": {
      "description": "ESchema entrypoint, constructs, composition, and domain",
      "rules": {
        "eschema.public": ["eschema.composition", "eschema.constructs"],
        "eschema.constructs": ["eschema.domain"],
        "eschema.composition": ["eschema.domain"]
      }
    },
    "snapshot": {
      "description": "Snapshot facade, capture, domain, and one-way ESchema integration",
      "rules": {
        "snapshot.public": ["snapshot.facade"],
        "snapshot.facade": ["eschema.constructs", "snapshot.capture"],
        "snapshot.capture": ["eschema.domain", "snapshot.domain"]
      }
    },
    "core": {
      "description": "Core utilities and their schema dependency",
      "rules": {
        "core.public": ["core.impl"],
        "core.impl": ["eschema.public"]
      }
    },
    "cli": {
      "description": "Command-line access to semantic snapshots",
      "rules": {
        "cli": ["snapshot.public"]
      }
    },
    "tanstack-sync": {
      "description": "Acyclic TanStack Sync domain, persistence, runtime, worker, lifecycle, composition, and facade layers",
      "rules": {
        "tanstack-sync.public": ["memory.public", "tanstack-sync.composition"],
        "tanstack-sync.composition": ["tanstack-sync.lifecycle"],
        "tanstack-sync.lifecycle": ["tanstack-sync.workers"],
        "tanstack-sync.workers": ["tanstack-sync.runtime"],
        "tanstack-sync.runtime": ["tanstack-sync.persistence"],
        "tanstack-sync.persistence": ["db.public", "tanstack-sync.domain"],
        "tanstack-sync.domain": ["core.public"]
      }
    }
  }
}
