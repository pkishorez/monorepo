          "snapshot.capture",
          "snapshot.restore"
        ],
        "snapshot.capture": ["eschema.domain", "snapshot.domain"],
        "snapshot.restore": ["snapshot.domain"]
      }
    },
    "core": {
      "description": "Core utilities and their schema dependency",
      "rules": {
        "core.public": ["core.impl"],
        "core.impl": ["eschema.public"]
      }
    },
    "cli": {
      "description": "Command-line access to semantic snapshots",
      "rules": {
        "cli.entry": ["cli.commands", "cli.errors"],
        "cli.commands": ["cli.contract-files"],
        "cli.errors": ["cli.contract-files"],
        "cli.contract-files": ["snapshot.public"]
      }
    },
    "sync": {
      "description": "Acyclic Sync domain, persistence, runtime, worker, lifecycle, composition, and facade layers",
      "rules": {
        "sync.public": ["memory.public", "sync.composition"],
        "sync.composition": ["sync.lifecycle"],
        "sync.lifecycle": ["sync.workers"],
        "sync.workers": ["sync.runtime"],
        "sync.runtime": ["sync.persistence"],
        "sync.persistence": ["db.public", "sync.domain"],
        "sync.domain": ["core.public"],
        "sync.platform": ["sync.public", "idb.public"]
      }
    }
  }
}
