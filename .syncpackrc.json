{
  "$schema": "./node_modules/syncpack/schema.json",
  "strict": true,
  "versionGroups": [
    {
      "label": "Unversioned workspace roots",
      "dependencyTypes": ["local"],
      "packages": ["public-monorepo", "docs", "kabuki-start"],
      "isIgnored": true
    },
    {
      "label": "Internal dependencies use workspace:* everywhere",
      "dependencies": [
        "@kestack/ai-toolkit",
        "@kestack/kabuki",
        "@kestack/auth-toolkit",
        "@kestack/connect",
        "@kestack/devtools",
        "@kestack/effect-tracer",
        "@kestack/devtools-kabuki",
        "laymos",
        "@kestack/use-gesture",
        "@kestack/use-keys",
        "@kestack/rpc-toolkit",
        "@kestack/std-toolkit",
        "use-effect-ts",
        "@kestack/web-platform"
      ],
      "dependencyTypes": ["prod", "dev", "peer"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "External dependencies use the default catalog",
      "dependencyTypes": ["prod", "dev"],
      "policy": "catalog"
    },
    {
      "label": "Effect peers accept any Effect 4 release",
      "dependencies": ["effect"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^4.0.0"
    },
    {
      "label": "Vite peers accept any Vite 8 release",
      "dependencies": ["vite"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^8.0.0"
    },
    {
      "label": "Vitest peers accept any Vitest 5 release",
      "dependencies": ["vitest"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^5.0.0"
    },
    {
      "label": "React peers accept any React 19 release",
      "dependencies": ["react", "react-dom"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^19.0.0"
    },
    {
      "label": "Playwright peers accept any Playwright release from the one tested",
      "dependencies": ["playwright-core"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^1.64.1"
    },
    {
      "label": "Synchronize remaining dependencies",
      "dependencyTypes": [
        "local",
        "overrides",
        "peer",
        "pnpmOverrides",
        "resolutions"
      ],
      "preferVersion": "highestSemver"
    }
  ],
  "semverGroups": [
    {
      "label": "Internal workspace protocols are enforced by version groups",
      "dependencies": [
        "@kestack/ai-toolkit",
        "@kestack/kabuki",
        "@kestack/auth-toolkit",
        "@kestack/connect",
        "@kestack/devtools",
        "@kestack/effect-tracer",
        "@kestack/devtools-kabuki",
        "laymos",
        "@kestack/use-gesture",
        "@kestack/use-keys",
        "@kestack/rpc-toolkit",
        "@kestack/std-toolkit",
        "use-effect-ts",
        "@kestack/web-platform"
      ],
      "dependencyTypes": ["prod", "dev", "peer"],
      "isIgnored": true
    },
    {
      "label": "Effect, Playwright, React, Vite, and Vitest peers use a caret range",
      "dependencies": [
        "effect",
        "playwright-core",
        "react",
        "react-dom",
        "vite",
        "vitest"
      ],
      "dependencyTypes": ["peer"],
      "range": "^"
    },
    {
      "label": "All registry dependencies, including peers, use exact versions",
      "range": ""
    }
  ],
  "updateGroups": [
    {
      "label": "Aliased Vite core updates stay aligned with vite-plus",
      "dependencyTypes": ["pnpmCatalog"],
      "dependencies": ["vite"],
      "isIgnored": true
    },
    {
      "label": "Aliased TypeScript 6 catalog updates are manual",
      "dependencyTypes": ["pnpmCatalog:typescript6"],
      "isIgnored": true
    },
    {
      "label": "OpenTelemetry's 0.x packages and api stay where its 2.x SDK accepts them: 0.300 and api 1.10 go with SDK 3",
      "dependencyTypes": ["pnpmCatalog"],
      "dependencies": [
        "@opentelemetry/api",
        "@opentelemetry/api-logs",
        "@opentelemetry/exporter-*",
        "@opentelemetry/sdk-logs"
      ],
      "target": "patch"
    },
    {
      "label": "OpenTelemetry's SDK stays on 2.x, the line @effect/opentelemetry accepts",
      "dependencyTypes": ["pnpmCatalog"],
      "dependencies": ["@opentelemetry/**"],
      "target": "minor"
    },
    {
      "label": "Syncpack ranks drizzle's branch builds (1.0.0-rc.5-<sha>) above its releases, so drizzle is updated by hand from its rc dist-tag",
      "dependencyTypes": ["pnpmCatalog"],
      "dependencies": ["drizzle-kit", "drizzle-orm"],
      "isIgnored": true
    },
    {
      "label": "Peer dependency updates are intentional",
      "dependencyTypes": ["peer"],
      "isIgnored": true
    }
  ]
}
