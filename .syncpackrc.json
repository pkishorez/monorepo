{
  "$schema": "./node_modules/syncpack/schema.json",
  "strict": true,
  "versionGroups": [
    {
      "label": "Unversioned workspace roots",
      "dependencyTypes": ["local"],
      "packages": ["public-monorepo", "docs", "@ledger/core", "@ledger/web"],
      "isIgnored": true
    },
    {
      "label": "Internal dependencies use workspace:* everywhere",
      "dependencies": [
        "@kstackz/ai-toolkit",
        "@kstackz/auth-toolkit",
        "@kstackz/devtools",
        "@kstackz/effect-tracer",
        "@kstackz/effect-webrtc",
        "laymos",
        "@kstackz/lotel",
        "@kstackz/use-gesture",
        "@kstackz/use-keys",
        "@kstackz/platform-toolkit",
        "@kstackz/rpc-toolkit",
        "@kstackz/std-toolkit",
        "@ledger/core",
        "use-effect-ts",
        "@kstackz/web-platform",
        "@devtools/ui"
      ],
      "dependencyTypes": ["prod", "dev", "peer"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "External dependencies use the default catalog",
      "dependencyTypes": ["prod", "dev"],
      "policy": "catalog"
    },
    {
      "label": "Effect peers accept any Effect 4 release",
      "dependencies": ["effect"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^4.0.0"
    },
    {
      "label": "Vite peers accept any Vite 8 release",
      "dependencies": ["vite"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^8.0.0"
    },
    {
      "label": "Vitest peers accept any Vitest 5 release",
      "dependencies": ["vitest"],
      "dependencyTypes": ["peer"],
      "pinVersion": "^5.0.0"
    },
    {
      "label": "Synchronize remaining dependencies",
      "dependencyTypes": [
        "local",
        "overrides",
        "peer",
        "pnpmOverrides",
        "resolutions"
      ],
      "preferVersion": "highestSemver"
    }
  ],
  "semverGroups": [
    {
      "label": "Internal workspace protocols are enforced by version groups",
      "dependencies": [
        "@kstackz/ai-toolkit",
        "@kstackz/auth-toolkit",
        "@kstackz/devtools",
        "@kstackz/effect-tracer",
        "@kstackz/effect-webrtc",
        "laymos",
        "@kstackz/lotel",
        "@kstackz/use-gesture",
        "@kstackz/use-keys",
        "@kstackz/platform-toolkit",
        "@kstackz/rpc-toolkit",
        "@kstackz/std-toolkit",
        "@ledger/core",
        "use-effect-ts",
        "@kstackz/web-platform",
        "@devtools/ui"
      ],
      "dependencyTypes": ["prod", "dev", "peer"],
      "isIgnored": true
    },
    {
      "label": "Effect, Vite, and Vitest peers use a caret range",
      "dependencies": ["effect", "vite", "vitest"],
      "dependencyTypes": ["peer"],
      "range": "^"
    },
    {
      "label": "All registry dependencies, including peers, use exact versions",
      "range": ""
    }
  ],
  "updateGroups": [
    {
      "label": "Aliased Vite core updates stay aligned with vite-plus",
      "dependencyTypes": ["pnpmCatalog"],
      "dependencies": ["vite"],
      "isIgnored": true
    },
    {
      "label": "Aliased TypeScript 6 catalog updates are manual",
      "dependencyTypes": ["pnpmCatalog:typescript6"],
      "isIgnored": true
    },
    {
      "label": "Peer dependency updates are intentional",
      "dependencyTypes": ["peer"],
      "isIgnored": true
    }
  ]
}
