{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts", "src/styles.css"],
  "fileModules": [
    "src/app.ts",
    "src/mark.tsx",
    "src/router.tsx",
    "src/stage.ts",
    "src/worker.ts",
    "src/routes/__root.tsx",
    "src/routes/offline.tsx"
  ],
  "rules": {
    "src/routes": ["src/screens", "src/app.ts"],
    "src/worker.ts": ["src/infra", "src/stage.ts"],
    "src/screens": ["src/app.ts", "src/mark.tsx"],
    "src/app.ts": ["src/mark.tsx", "src/stage.ts"],
    "src/screens/shell": [
      "src/screens/parts",
      "src/screens/sheets/add",
      "src/screens/sheets/accounts",
      "src/screens/sheets/palette"
    ],
    "src/screens/places/home": ["src/screens/parts"],
    "src/screens/places/entries": [
      "src/screens/parts",
      "src/screens/sheets/accounts"
    ],
    "src/screens/places/months": ["src/screens/parts"],
    "src/screens/sheets/add": ["src/screens/parts"],
    "src/screens/sheets/accounts": ["src/screens/parts"]
  }
}
