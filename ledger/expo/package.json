{
  "name": "@ledger/expo",
  "description": "Ledger on iOS and Android: an Expo Router app on the Expo Platform that talks to @ledger/web's Ledger API and never hosts a server.",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "start": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo start",
    "ios": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo start --ios",
    "android": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo start --android",
    "lint": "tsc --noEmit && pnpm lint:laymos",
    "lint:laymos": "laymos lint"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "catalog:",
    "@kstackz/auth-toolkit": "workspace:*",
    "@kstackz/expo-platform": "workspace:*",
    "@kstackz/platform-toolkit": "workspace:*",
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@ledger/core": "workspace:*",
    "@shopify/flash-list": "catalog:",
    "effect": "catalog:",
    "expo": "catalog:",
    "expo-auth-session": "catalog:",
    "expo-blur": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-linking": "catalog:",
    "expo-network": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-web-browser": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-worklets": "catalog:",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:"
  }
}
