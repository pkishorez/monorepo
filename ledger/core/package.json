{
  "name": "@ledger/core",
  "description": "Everything Ledger's web and Expo apps share: the API, the model, the Backend (handlers on services, each with a cloud and a device version), and the app: its link to the Backend, each user's Session, its cache, Commands and Places. Platform-free; each app hands it a platform from web-toolkit or expo-toolkit.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./api": "./src/api/index.ts",
    "./model": "./src/model/index.ts",
    "./backend": "./src/backend/backend.ts",
    "./backend/services/table": "./src/backend/services/table/index.ts",
    "./backend/services/*": "./src/backend/services/*.ts",
    "./app": "./src/app/ledger.ts",
    "./app/session": "./src/app/session/index.ts",
    "./app/settings": "./src/app/cache/settings/index.ts",
    "./app/commands": "./src/app/commands/index.ts",
    "./app/places": "./src/app/places/index.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit && tsc --noEmit -p tests && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@kstackz/auth-toolkit": "workspace:*",
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@kstackz/use-keys": "workspace:*",
    "@tanstack/react-db": "catalog:",
    "@xstate/effect": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
