{
  "name": "@devtools/ui",
  "version": "0.0.0",
  "description": "The UI only the DevTools show: the trace viewer, Laymos's architecture explorer, the monorepo map, the flow swimlane and the DevTools panel. Private: @kstackz/devtools bundles it.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./otel-trace-viewer": "./src/otel-trace-viewer/trace-viewer/index.ts",
    "./otel-trace-viewer/*": "./src/otel-trace-viewer/*/index.ts",
    "./laymos": "./src/laymos/analysis-explorer/index.ts",
    "./monoverse": "./src/monoverse/monoverse/index.ts",
    "./flow-swimlane": "./src/flow-swimlane/flow-swimlane/index.ts",
    "./devtools-panel": "./src/devtools-panel/index.ts"
  },
  "scripts": {
    "dev": "cosmos",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kstackz/effect-tracer": "workspace:*",
    "@kstackz/flow": "workspace:*",
    "@kstackz/lotel": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@kstackz/web-toolkit": "workspace:*",
    "@xyflow/react": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "use-effect-ts": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react-cosmos": "catalog:",
    "react-cosmos-plugin-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
