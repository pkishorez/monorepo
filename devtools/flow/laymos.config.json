{
  "$schema": "../laymos/schema.json",
  "sourceRoots": ["src"],
  "fileModules": ["src/index.ts"],
  "rules": {
    "src/index.ts": [
      "src/flow",
      "src/telemetry",
      "src/journal",
      "src/projection"
    ],
    "src/flow": ["src/telemetry", "src/journal"],
    "src/telemetry": ["src/client", "src/journal"],
    "src/rpc": ["src/journal"],
    "src/client": ["src/rpc"],
    "src/projection": ["src/journal"]
  }
}
