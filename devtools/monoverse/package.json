{
  "name": "@kestack/monoverse",
  "version": "0.0.0",
  "private": false,
  "description": "The folder rules a package's monoverse.json names, checked by oxlint as you write and by DevTools' Monoverse on every branch",
  "keywords": [
    "lint",
    "oxlint",
    "architecture",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "default": "./dist/oxlint/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist/",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "fmt": "vp fmt",
    "lint": "vp check && tsc --noEmit",
    "test": "vitest run src/tests"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
