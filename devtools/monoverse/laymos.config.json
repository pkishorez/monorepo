{
  "$schema": "../laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/analyze-monorepo/tests",
    "src/domain/package-graph/tests"
  ],
  "layers": {
    "public-api": {
      "paths": ["src/index.ts"],
      "description": "The package door: analyzeMonorepo and the analysis schemas",
      "modules": {
        "src/index.ts": {}
      }
    },
    "orchestrator": {
      "paths": ["src/analyze-monorepo"],
      "description": "Loads one Monorepo and derives its analysis",
      "modules": {
        "src/analyze-monorepo": { "exposed": true }
      }
    },
    "transport": {
      "paths": ["src/rpc"],
      "description": "The typed contract DevTools merges into its RPC",
      "modules": {
        "src/rpc": { "exposed": true }
      }
    },
    "services": {
      "paths": ["src/services"],
      "description": "Reads pnpm workspace files and package manifests",
      "modules": {
        "src/services/monorepo": { "exposed": true },
        "src/services/package": { "shared": true }
      }
    },
    "domain": {
      "paths": ["src/domain"],
      "description": "The analysis schemas and the pure Package graph; no I/O",
      "modules": {
        "src/domain/schema": { "shared": true, "exposed": true },
        "src/domain/package-graph": { "exposed": true }
      }
    }
  },
  "layerGraphs": {
    "architecture": {
      "rules": {
        "public-api": ["orchestrator", "transport", "domain"],
        "orchestrator": ["services", "domain"],
        "transport": ["domain"],
        "services": ["domain"],
        "domain": []
      }
    }
  }
}
