{
  "name": "@kestack/devtools-kabuki",
  "version": "0.0.16",
  "private": true,
  "description": "Kabuki apps in DevTools: the Inspector, a panel that reads and moves a running app through one Kabuki Session's nine calls, answered in the page or through the DevTools Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "devtools/devtools-kabuki"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "default": "./dist/devtools.js"
    },
    "./inspector/sources.css": "./dist/actor-inspector/view/sources.css"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json && mkdir -p dist/actor-inspector/view && cp src/actor-inspector/view/sources.css dist/actor-inspector/view/",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "fmt": "vp fmt",
    "lint": "vp check src package.json tsconfig.json tsconfig.build.json monoverse.json && tsc --noEmit && monoverse lint",
    "test": "vp test src",
    "test:watch": "vp test src --watch"
  },
  "dependencies": {
    "lucide-react": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@kestack/kabuki": "workspace:*",
    "@kestack/monoverse": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@kestack/kabuki": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "effect": "^4.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
