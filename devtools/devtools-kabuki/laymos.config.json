{
  "$schema": "../laymos/schema.json",
  "sourceRoots": ["src"],

  "rules": {
    "src/session": ["src/api"],
    "src/inspector": ["src/api", "src/session"],
    "src/inspector/actor-inspector": ["src/inspector/kabuki-session"],
