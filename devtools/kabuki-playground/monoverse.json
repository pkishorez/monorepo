{
  "$schema": "../monoverse/schema.json",
  "sourceRoots": ["src"],
  "ignore": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
  "preset": "kabuki",
  "restrictions": [
    {
      "from": "src/**/logic/**",
      "to": "react",
      "reason": "logic/ is pure and imports no React; components go in view/."
    },
    {
      "from": "src/services/**",
      "to": "react",
      "reason": "A service runs outside React; only a View draws."
    }
  ]
}
