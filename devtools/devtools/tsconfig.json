{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "src/cli/**/*",
    "src/rpc/**/*",
    "src/server/**/*",
    "scripts/**/*",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
