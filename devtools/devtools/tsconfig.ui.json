{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true
  },
  "include": ["src/app/**/*"],
  "exclude": [
    "node_modules",
    "src/app/**/server/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
