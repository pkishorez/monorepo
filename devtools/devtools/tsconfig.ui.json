{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/browser.tsx",
    "src/browser-app/**/*",
    "src/browser-globals.d.ts",
    "src/client/**/*",
    "src/rpc/**/*",
    "src/ui/**/*",
    "src/views/**/*"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
