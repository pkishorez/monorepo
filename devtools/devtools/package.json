{
  "name": "@kestack/devtools",
  "version": "0.0.17",
  "private": false,
  "description": "Local DevTools server and app: Lotel for telemetry, Monoverse for monorepo architecture, and Kabuki for live Kabuki apps",
  "keywords": [
    "devtools",
    "effect",
    "rpc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "devtools": "dist/cli/main.mjs"
  },
  "files": [
    "dist/cli",
    "dist/ui",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vp pack && vp build",
    "build:watch": "vp pack --watch",
    "cosmos": "cosmos",
    "dev": "vp run -F '@kestack/devtools^...' build && portless run --force tsx scripts/dev.mts",
    "lint": "vp check && tsc --noEmit && tsc -p tsconfig.ui.json --noEmit && monoverse lint",
    "test": "vitest run && tsx scripts/package-smoke.mts"
  },
  "dependencies": {
    "@kestack/monoverse": "workspace:*",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@kestack/ai-toolkit-v2": "workspace:*",
    "@kestack/devtools-kabuki": "workspace:*",
    "@kestack/effect-tracer": "workspace:*",
    "@kestack/kabuki": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@kestack/use-gesture": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "effect": "catalog:",
    "env-paths": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-cosmos": "catalog:",
    "react-cosmos-plugin-vite": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:typescript6",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
