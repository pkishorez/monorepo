{
  "name": "@kestack/devtools",
  "version": "0.0.12",
  "private": false,
  "description": "Local DevTools server for telemetry and architecture analysis, with Client Commands for reading it back",
  "keywords": [
    "devtools",
    "effect",
    "rpc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./lotel": {
      "types": "./dist/lotel/index.d.ts",
      "default": "./dist/lotel/index.js"
    },
    "./lotel/rpc": {
      "types": "./dist/lotel/rpc/index.d.ts",
      "default": "./dist/lotel/rpc/index.js"
    },
    "./lotel/telemetry": {
      "types": "./dist/lotel/telemetry-schema/index.d.ts",
      "default": "./dist/lotel/telemetry-schema/index.js"
    }
  },
  "bin": {
    "devtools": "dist/server/main.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json && vp build",
    "build:watch": "vp pack --watch",
    "cosmos": "cosmos",
    "dev": "vp run -F '@kestack/devtools^...' build && portless run --force tsx scripts/dev.mts",
    "lint": "vp check && tsc --noEmit && tsc -p tsconfig.ui.json --noEmit && laymos lint",
    "test": "vitest run && tsx scripts/package-smoke.mts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@kestack/std-toolkit": "workspace:*",
    "effect": "catalog:",
    "env-paths": "catalog:",
    "laymos": "workspace:*",
    "typescript": "catalog:typescript6",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@kestack/effect-tracer": "workspace:*",
    "@kestack/use-gesture": "workspace:*",
    "@kestack/use-keys": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-cosmos": "catalog:",
    "react-cosmos-plugin-vite": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "react-resizable-panels": "catalog:",
    "remark-gfm": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "use-effect-ts": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zustand": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
