{
  "name": "@kstackz/devtools",
  "version": "0.0.0",
  "private": false,
  "description": "Local DevTools server for telemetry and architecture analysis, with Client Commands for reading it back",
  "keywords": [
    "devtools",
    "effect",
    "rpc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc/index.ts"
  },
  "bin": {
    "devtools": "dist/server/main.mjs"
  },
  "files": [
    "dist",
    "skills",
    "src/rpc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vp pack && vp build",
    "build:watch": "vp pack --watch",
    "dev": "vp run -F '@kstackz/devtools^...' build && portless run --force tsx scripts/dev.mts",
    "snapshot:dev": "tsx scripts/snapshot.mts",
    "flow:demo": "tsx scripts/test.ts",
    "lint": "vp check && tsc --noEmit && tsc -p tsconfig.ui.json --noEmit && laymos lint",
    "test": "vitest run && tsx scripts/package-smoke.mts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@kstackz/flow": "workspace:*",
    "@kstackz/lotel": "workspace:*",
    "effect": "catalog:",
    "env-paths": "catalog:",
    "laymos": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "typescript": "catalog:typescript6",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@devtools/ui": "workspace:*",
    "@kstackz/effect-tracer": "workspace:*",
    "@kstackz/web-toolkit": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@xyflow/react": "catalog:",
    "playwright-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "use-effect-ts": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "playwright-core": "1.63.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
