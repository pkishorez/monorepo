{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "stripInternal": true
  },
  "include": ["src/lotel/**/*"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
