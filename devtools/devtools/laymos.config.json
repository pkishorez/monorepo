{
  "$schema": "../laymos/schema.json",
  "sourceRoots": ["src"],
  "fileModules": [
    "src/cli/main.ts",
    "src/app/start.tsx",
    "src/app/actor.ts",
    "src/app/view.tsx",
    "src/app/pages/home.ts",
    "src/app/pages/lotel.tsx",
    "src/app/pages/monoverse.tsx",
    "src/app/pages/kabuki.tsx"
  ],
  "ignoredPaths": ["src/app/cosmos.decorator.tsx"],
  "rules": {
    "src/app/actor.ts": [
      "src/app/pages/home.ts",
      "src/app/pages/kabuki.tsx",
      "src/app/pages/lotel.tsx",
      "src/app/pages/monoverse.tsx"
    ],
    "src/app/kabuki/actor-inspector": ["src/app/kabuki/sessions"],
    "src/app/lotel/feed": [
      "src/app/lotel/preferences",
      "src/app/lotel/telemetry",
      "src/app/lotel/trace-model"
    ],
    "src/app/lotel/server": ["src/app/lotel/contract"],
    "src/app/lotel/server/ingest": ["src/app/lotel/server/telemetry-store"],
    "src/app/lotel/server/rpc": ["src/app/lotel/server/telemetry-store"],
    "src/app/lotel/telemetry": [
      "src/app/lotel/contract",
      "src/app/lotel/trace-model"
    ],
    "src/app/lotel/trace": [
      "src/app/lotel/telemetry",
      "src/app/lotel/trace-model"
    ],
    "src/app/lotel/trace-model": ["src/app/lotel/contract"],
    "src/app/lotel/trace/ui/span-inspection": ["src/app/lotel/trace/ui/status"],
    "src/app/monoverse/client": ["src/app/monoverse/contract"],
    "src/app/monoverse/file-viewer": [
      "src/app/monoverse/contract",
      "src/app/monoverse/services/monorepo",
      "src/app/monoverse/ui"
    ],
    "src/app/monoverse/folder-viewer": [
      "src/app/monoverse/contract",
      "src/app/monoverse/file-viewer",
      "src/app/monoverse/model",
      "src/app/monoverse/ui"
    ],
    "src/app/monoverse/git-controls": [
      "src/app/monoverse/contract",
      "src/app/monoverse/model",
      "src/app/monoverse/tree",
      "src/app/monoverse/ui"
    ],
    "src/app/monoverse/monorepo": [
      "src/app/monoverse/contract",
      "src/app/monoverse/model",
      "src/app/monoverse/package",
      "src/app/monoverse/tree"
    ],
    "src/app/monoverse/package": [
      "src/app/monoverse/contract",
      "src/app/monoverse/model",
      "src/app/monoverse/services/monorepo",
      "src/app/monoverse/tree",
      "src/app/monoverse/ui"
    ],
    "src/app/monoverse/picker": [
      "src/app/monoverse/client",
      "src/app/monoverse/contract"
    ],
    "src/app/monoverse/picker/ui": ["src/app/monoverse/picker/steps"],
    "src/app/monoverse/server": [
      "src/app/monoverse/contract",
      "src/app/monoverse/model"
    ],
    "src/app/monoverse/server/changes": [
      "src/app/monoverse/server/git",
      "src/app/monoverse/server/snapshot"
    ],
    "src/app/monoverse/server/config": ["src/app/monoverse/server/snapshot"],
    "src/app/monoverse/server/file-graph": [
      "src/app/monoverse/server/snapshot"
    ],
    "src/app/monoverse/server/files": ["src/app/monoverse/server/snapshot"],
    "src/app/monoverse/server/snapshot": ["src/app/monoverse/server/git"],
    "src/app/monoverse/server/workspace": ["src/app/monoverse/server/snapshot"],
    "src/app/monoverse/server/workspace/monorepo": [
      "src/app/monoverse/server/workspace/package",
      "src/app/monoverse/server/workspace/package-graph"
    ],
    "src/app/monoverse/server/workspace/package": [
      "src/app/monoverse/server/workspace/package-graph"
    ],
    "src/app/monoverse/services/monorepo": [
      "src/app/monoverse/client",
      "src/app/monoverse/contract",
      "src/app/monoverse/model"
    ],
    "src/app/monoverse/tree": [
      "src/app/monoverse/contract",
      "src/app/monoverse/model"
    ],
    "src/app/monoverse/tree/outline": [
      "src/app/monoverse/tree/canvas",
      "src/app/monoverse/tree/lenses",
      "src/app/monoverse/tree/selection-bar"
    ],
    "src/app/monoverse/ui": ["src/app/monoverse/model"],
    "src/app/pages/kabuki.tsx": ["src/app/kabuki"],
    "src/app/pages/lotel.tsx": ["src/app/lotel"],
    "src/app/pages/monoverse.tsx": ["src/app/monoverse"],
    "src/app/start.tsx": [
      "src/app/actor.ts",
      "src/app/kabuki",
      "src/app/lotel",
      "src/app/monoverse",
      "src/app/view.tsx"
    ],
    "src/app/view.tsx": [
      "src/app/actor.ts",
      "src/app/pages/kabuki.tsx",
      "src/app/pages/lotel.tsx",
      "src/app/pages/monoverse.tsx"
    ],
    "src/cli/main.ts": ["src/cli/serve"],
    "src/cli/serve": [
      "src/app/kabuki/server",
      "src/app/lotel/server",
      "src/app/monoverse/server"
    ]
  }
}
