{
  "$schema": "../laymos/schema.json",
  "sourceRoots": ["src"],
  "fileModules": [
    "src/browser.tsx",
    "src/server/main.ts",
    "src/server/handlers.ts",
    "src/cli/skills.ts",
    "src/cli/text-format.ts",
    "src/ui/lotel/collections.ts"
  ],
  "rules": {
    "src/browser.tsx": ["src/browser-app"],
    "src/server/main.ts": [
      "src/server/local-devtools-server",
      "src/cli/traces",
      "src/cli/skills.ts"
    ],
    "src/cli/client-command": ["src/rpc"],
    "src/browser-app": [
      "src/client/devtools-rpc",
      "src/ui/monoverse/monoverse",
      "src/ui/lotel/lotel"
    ],
    "src/ui": ["src/client", "src/rpc"],
    "src/ui/monoverse": [
      "src/ui/laymos/project-workspace",
      "src/ui/git-changes",
      "src/ui/project-selection"
    ],
    "src/ui/lotel/lotel": [
      "src/ui/lotel/viewer",
      "src/ui/lotel/collections.ts"
    ],
    "src/ui/lotel/viewer": ["src/ui/lotel/collections.ts"],
    "src/client": ["src/rpc"],
    "src/server": ["src/rpc"],
    "src/server/local-devtools-server": [
      "src/server/handlers.ts",
      "src/server/project-registry"
    ],
    "src/server/handlers.ts": [
      "src/server/analyze-laymos-project",
      "src/server/analyze-monorepo",
      "src/server/get-laymos-files",
      "src/server/get-laymos-stories",
      "src/server/get-laymos-story-reports",
      "src/server/get-monorepo-file",
      "src/server/git-changes",
      "src/server/run-laymos-stories"
    ],
    "src/server/project-registry": ["src/server/resolve-worktrees"],
    "src/server/analyze-monorepo/monorepo": [
      "src/server/analyze-monorepo/package",
      "src/server/analyze-monorepo/package-graph"
    ],
    "src/server/analyze-monorepo/package": [
      "src/server/analyze-monorepo/package-graph"
    ],
    "src/cli/traces": ["src/cli/client-command", "src/cli/text-format.ts"],
    "src/ui/laymos": ["src/ui/git-changes"]
  }
}
