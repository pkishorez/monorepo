{
  "$schema": "../laymos/schema.json",
  "sourceRoots": ["src"],
  "fileModules": [
    "src/browser.tsx",
    "src/server/main.ts",
    "src/server/handlers.ts",
    "src/cli/skills.ts",
    "src/browser-app/ui/lotel/collections.ts",
    "src/browser-app/ui/monoverse/monorepo-explorer/analysis.ts"
  ],
  "rules": {
    "src/browser.tsx": ["src/browser-app"],
    "src/browser-app": ["src/rpc"],
    "src/browser-app/ui": ["src/browser-app/devtools-rpc"],
    "src/cli/client-command": ["src/rpc"],
    "src/cli/traces": ["src/cli/client-command", "src/lotel/telemetry-schema"],
    "src/server/main.ts": [
      "src/server/local-devtools-server",
      "src/cli/traces",
      "src/cli/skills.ts"
    ],
    "src/server/local-devtools-server": [
      "src/server/handlers.ts",
      "src/server/project-registry",
      "src/lotel",
      "src/rpc"
    ],
    "src/server/handlers.ts": [
      "src/server/laymos",
      "src/server/monoverse",
      "src/server/git-changes",
      "src/rpc/laymos",
      "src/rpc/git",
      "src/rpc/monoverse"
    ],
    "src/server/monoverse/analyze-monorepo/monorepo": [
      "src/server/monoverse/analyze-monorepo/package",
      "src/server/monoverse/analyze-monorepo/package-graph"
    ],
    "src/server/monoverse/analyze-monorepo/package": [
      "src/server/monoverse/analyze-monorepo/package-graph"
    ],
    "src/rpc": ["src/lotel/rpc"],
    "src/browser-app/ui/monoverse": [
      "src/browser-app/ui/laymos",
      "src/browser-app/ui/git-changes"
    ],
    "src/browser-app/ui/laymos": ["src/browser-app/ui/git-changes"],
    "src/browser-app/ui/lotel/viewer": [
      "src/browser-app/ui/lotel/collections.ts",
      "src/browser-app/ui/lotel/trace-viewer"
    ],
    "src/browser-app/ui/lotel/collections.ts": ["src/lotel/telemetry-schema"],
    "src/browser-app/ui/lotel/trace-viewer/trace-dock": [
      "src/browser-app/ui/lotel/trace-viewer/waterfall-view",
      "src/browser-app/ui/lotel/trace-viewer/trace-presentation"
    ],
    "src/browser-app/ui/lotel/trace-viewer/trace-list": [
      "src/browser-app/ui/lotel/trace-viewer/waterfall-view",
      "src/browser-app/ui/lotel/trace-viewer/trace-presentation"
    ],
    "src/browser-app/ui/lotel/trace-viewer/waterfall-view": [
      "src/browser-app/ui/lotel/trace-viewer/trace-presentation"
    ],
    "src/browser-app/ui/lotel/trace-viewer/trace-normalization": [
      "src/lotel/telemetry-schema"
    ],
    "src/browser-app/ui/laymos/analysis-explorer": [
      "src/browser-app/ui/laymos/laymo",
      "src/browser-app/ui/laymos/file-list",
      "src/browser-app/ui/laymos/preferences",
      "src/browser-app/ui/laymos/project-changes"
    ],
    "src/browser-app/ui/laymos/analysis-explorer/stories-canvas": [
      "src/browser-app/ui/laymos/canvas-space",
      "src/browser-app/ui/lotel/trace-viewer"
    ],
    "src/browser-app/ui/laymos/laymo": [
      "src/browser-app/ui/laymos/canvas-space",
      "src/browser-app/ui/laymos/project-changes"
    ],
    "src/browser-app/ui/laymos/canvas-space": [
      "src/browser-app/ui/laymos/preferences"
    ],
    "src/browser-app/ui/laymos/file-list": [
      "src/browser-app/ui/laymos/preferences"
    ],
    "*": [
      "src/browser-app/ui/lotel/trace-viewer/trace-model",
      "src/browser-app/ui/monoverse/monorepo-explorer/analysis.ts",
      "src/lotel/telemetry-schema"
    ],
    "src/server/laymos": ["src/rpc/laymos"],
    "src/server/git-changes": ["src/rpc/git"],
    "src/server/monoverse": ["src/rpc/monoverse"],
    "src/server/project-registry": ["src/rpc/project-registry"]
  },
  "ignoredPaths": [
    "src/browser-app/ui/cosmos.decorator.tsx",
    "src/browser-app/ui/lotel/trace-viewer/trace-viewer.fixture.tsx",
    "src/browser-app/ui/monoverse/monorepo-explorer/monoverse.fixture.tsx",
    "src/browser-app/ui/laymos/analysis-explorer/fixtures",
    "src/browser-app/ui/laymos/analysis-explorer/stories-canvas/fixtures",
    "src/browser-app/ui/laymos/file-list/fixtures",
    "src/browser-app/ui/laymos/laymo/fixtures"
  ]
}
