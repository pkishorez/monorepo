{
  "$schema": "../laymos/schema.json",
  "sourceRoots": ["src"],
  "fileModules": [
    "src/browser.tsx",
    "src/server/main.ts",
    "src/server/handlers.ts",
    "src/cli/skills.ts",
    "src/cli/text-format.ts",
    "src/ui/lotel/collections.ts",
    "src/ui/monoverse/monoverse/monorepo-explorer/analysis.ts"
  ],
  "rules": {
    "src/browser.tsx": ["src/browser-app"],
    "src/server/main.ts": [
      "src/server/local-devtools-server",
      "src/cli/traces",
      "src/cli/skills.ts"
    ],
    "src/cli/client-command": ["src/rpc"],
    "src/browser-app": [
      "src/client/devtools-rpc",
      "src/ui/monoverse/monoverse",
      "src/ui/lotel/lotel"
    ],
    "src/ui": ["src/client", "src/rpc"],
    "src/ui/monoverse": [
      "src/ui/laymos/project-workspace",
      "src/ui/git-changes",
      "src/ui/project-selection"
    ],
    "src/ui/lotel/lotel": [
      "src/ui/lotel/viewer",
      "src/ui/lotel/collections.ts"
    ],
    "src/ui/lotel/viewer": [
      "src/ui/lotel/collections.ts",
      "src/ui/lotel/trace-viewer"
    ],
    "src/client": ["src/rpc"],
    "src/server": ["src/rpc"],
    "src/server/local-devtools-server": [
      "src/server/handlers.ts",
      "src/server/project-registry",
      "src/lotel"
    ],
    "src/server/handlers.ts": [
      "src/server/analyze-laymos-project",
      "src/server/analyze-monorepo",
      "src/server/get-laymos-files",
      "src/server/get-laymos-stories",
      "src/server/get-laymos-story-reports",
      "src/server/get-monorepo-file",
      "src/server/git-changes",
      "src/server/run-laymos-stories"
    ],
    "src/server/project-registry": ["src/server/resolve-worktrees"],
    "src/server/analyze-monorepo/monorepo": [
      "src/server/analyze-monorepo/package",
      "src/server/analyze-monorepo/package-graph"
    ],
    "src/server/analyze-monorepo/package": [
      "src/server/analyze-monorepo/package-graph"
    ],
    "src/cli/traces": [
      "src/cli/client-command",
      "src/cli/text-format.ts",
      "src/lotel/telemetry-schema"
    ],
    "src/ui/laymos": ["src/ui/git-changes"],
    "src/ui/lotel/trace-viewer/trace-dock": [
      "src/ui/lotel/trace-viewer/waterfall-view",
      "src/ui/lotel/trace-viewer/trace-presentation"
    ],
    "src/ui/lotel/trace-viewer/trace-list": [
      "src/ui/lotel/trace-viewer/waterfall-view",
      "src/ui/lotel/trace-viewer/trace-presentation"
    ],
    "src/ui/lotel/trace-viewer/waterfall-view": [
      "src/ui/lotel/trace-viewer/trace-presentation"
    ],
    "src/ui/lotel/trace-viewer/trace-normalization": [
      "src/lotel/telemetry-schema"
    ],
    "src/ui/laymos/project-workspace/analysis-explorer": [
      "src/ui/laymos/laymo",
      "src/ui/laymos/file-list",
      "src/ui/laymos/preferences",
      "src/ui/laymos/project-changes"
    ],
    "src/ui/laymos/project-workspace/analysis-explorer/stories-canvas": [
      "src/ui/laymos/canvas-space",
      "src/ui/lotel/trace-viewer"
    ],
    "src/ui/laymos/laymo": [
      "src/ui/laymos/canvas-space",
      "src/ui/laymos/project-changes"
    ],
    "src/ui/laymos/canvas-space": ["src/ui/laymos/preferences"],
    "src/ui/laymos/file-list": ["src/ui/laymos/preferences"],
    "src/ui/monoverse/monoverse/monorepo-explorer": [
      "src/ui/laymos/laymo",
      "src/ui/laymos/file-list"
    ],
    "src/ui/monoverse/monoverse/monorepo-explorer/package-cards": [
      "src/ui/laymos/project-changes"
    ],
    "src/ui/lotel/collections.ts": ["src/lotel/telemetry-schema"],
    "*": [
      "src/ui/lotel/trace-viewer/trace-model",
      "src/ui/monoverse/monoverse/monorepo-explorer/analysis.ts",
      "src/lotel/telemetry-schema"
    ],
    "src/rpc": ["src/lotel/rpc"]
  },
  "ignoredPaths": [
    "src/ui/cosmos.decorator.tsx",
    "src/ui/lotel/trace-viewer/trace-viewer.fixture.tsx",
    "src/ui/monoverse/monoverse/monorepo-explorer/monoverse.fixture.tsx",
    "src/ui/laymos/project-workspace/analysis-explorer/fixtures",
    "src/ui/laymos/project-workspace/analysis-explorer/stories-canvas/fixtures",
    "src/ui/laymos/file-list/fixtures",
    "src/ui/laymos/laymo/fixtures"
  ]
}
