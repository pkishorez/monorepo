{
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/shared/generated.ts"],
  "layers": {
    "app": {
      "paths": ["src"],
      "docsPath": "docs/app.md",
      "modules": {
        "src/feature": {
          "exposed": true
        },
        "src/shared": {
          "shared": true,
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "core": {
      "docsPath": "docs/architecture.md",
      "rules": {
        "app": []
      }
    }
  }
}
