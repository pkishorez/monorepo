{
  "sourceRoots": ["src"],
  "layers": {
    "app": {
      "paths": ["src/app"],
      "modules": {
        "src/app": {
          "exposed": true
        }
      }
    },
    "domain": {
      "paths": ["src/domain"],
      "modules": {
        "src/domain": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "architecture": {
      "rules": {
        "app": ["domain"]
      }
    },
    "reverse": {
      "rules": {
        "domain": ["app"]
      }
    }
  }
}
