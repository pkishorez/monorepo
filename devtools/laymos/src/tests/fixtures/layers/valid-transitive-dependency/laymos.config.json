{
  "sourceRoots": ["src"],
  "layers": {
    "application": {
      "paths": ["src/application"],
      "modules": {
        "src/application": {
          "exposed": true
        }
      }
    },
    "domain": {
      "paths": ["src/domain"],
      "modules": {
        "src/domain": {
          "exposed": true
        }
      }
    },
    "infrastructure": {
      "paths": ["src/infrastructure"],
      "modules": {
        "src/infrastructure": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "application": {
      "rules": {
        "application": ["domain"]
      }
    },
    "foundation": {
      "rules": {
        "domain": ["infrastructure"]
      }
    }
  }
}
