{
  "sourceRoots": ["src"],
  "layers": {
    "app": {
      "paths": ["src/app", "src/app/admin"],
      "modules": {
        "src/app": {
          "exposed": true
        }
      }
    },
    "domain": {
      "paths": ["src/domain"],
      "modules": {
        "src/domain": {
          "exposed": true
        }
      }
    },
    "infrastructure": {
      "paths": ["src/domain/model"]
    }
  },
  "layerGraphs": {}
}
