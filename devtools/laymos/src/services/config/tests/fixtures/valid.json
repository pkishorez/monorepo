{
  "$schema": "https://unpkg.com/laymos/schema.json",
  "sourceRoots": ["src"],
  "layers": {
    "app": {
      "paths": ["src/app"],
      "description": "Application",
      "modules": {
        "src/app": {
          "exposed": true
        }
      }
    },
    "domain": {
      "paths": ["src/domain"],
      "modules": {
        "src/domain": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "architecture": {
      "description": "Core layering",
      "rules": {
        "app": ["domain"]
      }
    }
  }
}
