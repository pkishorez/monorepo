{
  "name": "laymos",
  "version": "0.0.1",
  "private": false,
  "description": "Queries the direct and transitive file dependencies of a file or folder.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "laymos": "bin/laymos.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "tsx src/cli/cli.ts",
    "fmt": "vp fmt",
    "lint": "vp check && tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-resolver": "catalog:",
    "yoctocolors": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:typescript6",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.101"
  },
  "publishConfig": {
    "access": "public"
  }
}
