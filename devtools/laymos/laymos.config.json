{
  "$schema": "./schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/tests"],
  "layers": {
    "public-api": {
      "paths": ["src/index.ts"],
      "modules": {
        "src/index.ts": {}
      }
    },
    "contract": {
      "paths": ["src/architecture-analysis-schema", "src/change-set-schema"],
      "modules": {
        "src/architecture-analysis-schema": { "exposed": true },
        "src/change-set-schema": { "exposed": true }
      }
    },
    "cli": {
      "paths": ["src/cli"],
      "modules": {
        "src/cli": {}
      }
    },
    "orchestrator": {
      "paths": ["src/orchestrator"],
      "moduleGraphs": {
        "project-orchestration": {
          "description": "Loads a project once and derives every view of it.",
          "path": "src/orchestrator",
          "modules": {
            "load-project": {},
            "analyze-project": { "exposed": true },
            "inspect": { "exposed": true },
            "load-module-source": { "exposed": true },
            "load-changes": { "exposed": true },
            "run-stories": { "exposed": true }
          },
          "rules": {
            "analyze-project": ["load-project"],
            "inspect": ["analyze-project", "load-project"],
            "load-module-source": ["load-project"]
          }
        }
      }
    },
    "domain": {
      "paths": ["src/domain"],
      "modules": {
        "src/domain/file-graph": { "shared": true, "exposed": true },
        "src/domain/project-config": { "shared": true, "exposed": true }
      },
      "moduleGraphs": {
        "architecture-analysis": {
          "description": "Derives the complete Layer and Module analysis of one project.",
          "path": "src/domain/architecture-analysis",
          "modules": {
            "index.ts": { "exposed": true },
            "architecture-analysis.ts": {},
            "layer-rules.ts": {},
            "layers": {},
            "modules": { "exposed": true }
          },
          "rules": {
            "index.ts": ["architecture-analysis.ts"],
            "architecture-analysis.ts": ["layer-rules.ts", "layers", "modules"],
            "modules": ["layers"]
          }
        }
      }
    },
    "services": {
      "paths": ["src/services"],
      "modules": {
        "src/services/config": { "exposed": true },
        "src/services/file-cruiser": { "exposed": true },
        "src/services/git": { "exposed": true }
      }
    },
    "story": {
      "paths": ["src/story"],
      "moduleGraphs": {
        "stories": {
          "description": "Defines Stories and the contract their runs report.",
          "path": "src/story",
          "modules": {
            "index.ts": { "exposed": true },
            "schema": { "exposed": true },
            "story.ts": {}
          },
          "rules": {
            "index.ts": ["story.ts"],
            "story.ts": ["schema"]
          }
        }
      }
    }
  },
  "layerGraphs": {
    "architecture": {
      "rules": {
        "public-api": ["orchestrator", "contract", "story"],
        "contract": [],
        "cli": ["orchestrator", "story"],
        "orchestrator": ["services", "contract", "story"],
        "domain": ["contract"],
        "services": ["domain", "contract"],
        "story": []
      }
    }
  }
}
