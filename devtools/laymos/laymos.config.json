{
  "$schema": "./schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/tests"],
  "rules": {
    "src/cli": [
      "src/orchestrator",
      "src/story",
      "src/skills-command",
      "src/services/config",
      "src/services/file-cruiser",
      "src/domain/architecture-analysis",
      "src/architecture-analysis-schema"
    ],
    "src/orchestrator": [
      "src/services",
      "src/domain",
      "src/architecture-analysis-schema",
      "src/change-set-schema",
      "src/story"
    ],
    "src/orchestrator/analyze-project": ["src/orchestrator/load-project"],
    "src/orchestrator/inspect": [
      "src/orchestrator/analyze-project",
      "src/orchestrator/load-project"
    ],
    "src/orchestrator/load-files": ["src/orchestrator/load-project"],
    "src/domain": ["src/architecture-analysis-schema"],
    "src/domain/architecture-analysis": [
      "src/domain/file-graph",
      "src/domain/import-law",
      "src/domain/module-tree"
    ],
    "src/domain/import-law": [
      "src/domain/module-tree",
      "src/domain/project-config"
    ],
    "src/services": ["src/domain", "src/change-set-schema"],
    "src/story/story-tree": ["src/story/schema"]
  }
}
