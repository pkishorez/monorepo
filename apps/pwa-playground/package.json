{
  "name": "pwa-playground",
  "description": "Test bed that dogfoods pwa-toolkit: one TanStack Start page per PWA scenario, published at pwa.kishore.app.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "portless run --force alchemy dev",
    "build": "vp build",
    "preview": "vp preview",
    "icons": "node scripts/icons.ts",
    "lint": "tsc --noEmit && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "deploy:prod": "ALLOW_DEPLOY=true alchemy deploy --stage prod"
  },
  "dependencies": {
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "effect": "catalog:",
    "kui-toolkit": "workspace:*",
    "pwa-toolkit": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "laymos": "workspace:*",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
