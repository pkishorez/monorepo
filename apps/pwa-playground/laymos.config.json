{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/routeTree.gen.ts",
    "src/globals.d.ts",
    "src/styles.css"
  ],
  "layers": {
    "entry": {
      "paths": ["src/router.tsx", "src/sw.ts"],
      "description": "Host entries: the TanStack router and the service worker",
      "modules": {
        "src/router.tsx": {},
        "src/sw.ts": {}
      }
    },
    "routes": {
      "paths": [
        "src/routes/__root.tsx",
        "src/routes/api",
        "src/routes/auth-sim.tsx",
        "src/routes/data.tsx",
        "src/routes/gestures.tsx",
        "src/routes/index.tsx",
        "src/routes/install.tsx",
        "src/routes/motion.tsx",
        "src/routes/offline.tsx",
        "src/routes/rpc.tsx",
        "src/routes/runtime-cache.tsx",
        "src/routes/status.tsx",
        "src/routes/update.tsx"
      ],
      "description": "One page per PWA scenario, plus the API endpoints they call",
      "modules": {
        "src/routes/__root.tsx": {},
        "src/routes/api": {},
        "src/routes/auth-sim.tsx": {},
        "src/routes/data.tsx": {},
        "src/routes/gestures.tsx": {},
        "src/routes/index.tsx": {},
        "src/routes/install.tsx": {},
        "src/routes/motion.tsx": {},
        "src/routes/offline.tsx": {},
        "src/routes/rpc.tsx": {},
        "src/routes/runtime-cache.tsx": {},
        "src/routes/status.tsx": {},
        "src/routes/update.tsx": {}
      }
    },
    "gesture-lab": {
      "paths": ["src/routes/-gestures"],
      "description": "The Gesture Lab: one Case at a time of kui's GestureProvider, nested GestureZones and useGesture, with every finger drawn over the screen and a log of who heard what",
      "modules": {
        "src/routes/-gestures": {
          "exposed": true
        }
      }
    },
    "motion-course": {
      "paths": ["src/routes/-motion"],
      "description": "Motion 101: Framer Motion's gesture ideas as lessons with live demos and code, ending with real screens",
      "modules": {
        "src/routes/-motion": {
          "exposed": true
        }
      }
    },
    "infra": {
      "paths": ["src/infra"],
      "description": "Deployable resources, composed by alchemy.run.ts",
      "modules": {
        "src/infra": {}
      }
    },
    "components": {
      "paths": ["src/components"],
      "description": "App header, scenario nav, scenario page layout, status strip and theme toggle",
      "modules": {
        "src/components": {
          "exposed": true
        }
      }
    },
    "rpc": {
      "paths": ["src/rpc"],
      "description": "The Worker RPC group shared by the worker and the tab",
      "modules": {
        "src/rpc": {
          "exposed": true
        }
      }
    },
    "lib": {
      "paths": ["src/lib"],
      "description": "Build info, scenario list and transition order, worker snapshot, Runtime Cache rules, API helpers",
      "modules": {
        "src/lib/build.ts": {
          "exposed": true
        },
        "src/lib/meta.ts": {
          "shared": true,
          "exposed": true
        },
        "src/lib/scenarios.ts": {
          "exposed": true
        },
        "src/lib/strategies.ts": {
          "exposed": true
        },
        "src/lib/served.ts": {
          "exposed": true
        },
        "src/lib/data.ts": {
          "exposed": true
        },
        "src/lib/workers.ts": {
          "exposed": true
        },
        "src/lib/theme.ts": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "pwa-playground": {
      "description": "Entries over routes over components over lib; the Gesture Lab sits under its route; the router reads the scenario order from lib; the worker and the rpc page share the rpc group",
      "rules": {
        "entry": ["rpc", "lib"],
        "routes": ["gesture-lab", "motion-course", "components", "lib", "rpc"],
        "infra": [],
        "components": ["lib"],
        "rpc": [],
        "gesture-lab": [],
        "motion-course": []
      }
    }
  }
}
