{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [
    "src/routeTree.gen.ts",
    "src/globals.d.ts",
    "src/styles.css"
  ],
  "layers": {
    "entry": {
      "paths": ["src/router.tsx", "src/sw.ts"],
      "description": "Host entries: the TanStack router and the service worker",
      "modules": {
        "src/router.tsx": {},
        "src/sw.ts": {}
      }
    },
    "routes": {
      "paths": [
        "src/routes/__root.tsx",
        "src/routes/api",
        "src/routes/auth-sim.tsx",
        "src/routes/data.tsx",
        "src/routes/gestures.index.tsx",
        "src/routes/gestures.lab.tsx",
        "src/routes/gestures.page-turn.tsx",
        "src/routes/gestures.pull-to-refresh.tsx",
        "src/routes/gestures.sidebar.tsx",
        "src/routes/gestures.swipe-lab.tsx",
        "src/routes/gestures.swipe.tsx",
        "src/routes/gestures.zones.tsx",
        "src/routes/index.tsx",
        "src/routes/install.tsx",
        "src/routes/motion.tsx",
        "src/routes/offline.tsx",
        "src/routes/rpc.tsx",
        "src/routes/runtime-cache.tsx",
        "src/routes/status.tsx",
        "src/routes/update.tsx"
      ],
      "description": "One page per playground, the home page, the full-screen benches, and the API endpoints they call",
      "modules": {
        "src/routes/__root.tsx": {},
        "src/routes/api": {},
        "src/routes/auth-sim.tsx": {},
        "src/routes/data.tsx": {},
        "src/routes/gestures.index.tsx": {},
        "src/routes/gestures.lab.tsx": {},
        "src/routes/gestures.page-turn.tsx": {},
        "src/routes/gestures.pull-to-refresh.tsx": {},
        "src/routes/gestures.sidebar.tsx": {},
        "src/routes/gestures.swipe-lab.tsx": {},
        "src/routes/gestures.swipe.tsx": {},
        "src/routes/gestures.zones.tsx": {},
        "src/routes/index.tsx": {},
        "src/routes/install.tsx": {},
        "src/routes/motion.tsx": {},
        "src/routes/offline.tsx": {},
        "src/routes/rpc.tsx": {},
        "src/routes/runtime-cache.tsx": {},
        "src/routes/status.tsx": {},
        "src/routes/update.tsx": {}
      }
    },
    "gesture-demos": {
      "paths": ["src/routes/-demos"],
      "description": "The gesture playgrounds' live demos: a sidebar, pull to refresh, a swipe card and nested zones, each with its controls, live values and the code its options describe",
      "modules": {
        "src/routes/-demos": {
          "exposed": true
        }
      }
    },
    "gesture-lab": {
      "paths": ["src/routes/-gestures"],
      "description": "The Gesture Lab's bench: a Case picker, zones drawn in their colors, every finger over the screen and a log of who heard what, run with the core's own Cases or any other set",
      "modules": {
        "src/routes/-gestures": {
          "exposed": true
        }
      }
    },
    "swipe-lab": {
      "paths": ["src/routes/-swipe"],
      "description": "The Swipe Lab: useSwipe's Cases on the Gesture Lab's bench, each Swipe shown with its state, offset and speed against its rule, and how it ended",
      "modules": {
        "src/routes/-swipe": {
          "exposed": true
        }
      }
    },
    "motion-course": {
      "paths": ["src/routes/-motion"],
      "description": "Motion 101: Framer Motion's gesture ideas as lessons with live demos and code, ending with real screens",
      "modules": {
        "src/routes/-motion": {
          "exposed": true
        }
      }
    },
    "page-turn": {
      "paths": ["src/page-turn"],
      "description": "Page Turns: pages that declare their neighbours, a Turn Surface that follows the finger with a Placeholder Page beside it, and the loads and route transitions behind them",
      "modules": {
        "src/page-turn": {
          "exposed": true
        }
      }
    },
    "shell": {
      "paths": ["src/shell"],
      "description": "The app frame and its gestures: one Gesture Provider and zone, the edge-swipe menu, swipe paging and pull to refresh",
      "modules": {
        "src/shell": {
          "exposed": true
        }
      }
    },
    "infra": {
      "paths": ["src/infra"],
      "description": "Deployable resources, composed by alchemy.run.ts",
      "modules": {
        "src/infra": {}
      }
    },
    "components": {
      "paths": ["src/components"],
      "description": "The playground kit: page, playground, stage, controls, live values, code, notes, state track, theme toggle",
      "modules": {
        "src/components": {
          "exposed": true
        }
      }
    },
    "rpc": {
      "paths": ["src/rpc"],
      "description": "The Worker RPC group shared by the worker and the tab",
      "modules": {
        "src/rpc": {
          "exposed": true
        }
      }
    },
    "lib": {
      "paths": ["src/lib"],
      "description": "Build info, the chapter registry and reading order, search-param parsing, worker snapshot, Runtime Cache rules, API helpers, the simulated load for Page Turns",
      "modules": {
        "src/lib/build.ts": {
          "exposed": true
        },
        "src/lib/meta.ts": {
          "shared": true,
          "exposed": true
        },
        "src/lib/strategies.ts": {
          "exposed": true
        },
        "src/lib/served.ts": {
          "exposed": true
        },
        "src/lib/data.ts": {
          "exposed": true
        },
        "src/lib/workers.ts": {
          "exposed": true
        },
        "src/lib/theme.ts": {
          "exposed": true
        },
        "src/lib/chapters.ts": {
          "exposed": true
        },
        "src/lib/search.ts": {
          "exposed": true
        },
        "src/lib/simulated-load.ts": {
          "exposed": true
        },
        "src/lib/page-turn.ts": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "pwa-playground": {
      "description": "Entries over routes over shell over components over lib; the demos, labs and course sit under their routes, the Swipe Lab on the Gesture Lab's bench; the router, shell, pages and page kit share Page Turns; the worker and the rpc page share the rpc group",
      "rules": {
        "entry": ["rpc", "lib", "components"],
        "routes": [
          "gesture-demos",
          "gesture-lab",
          "swipe-lab",
          "motion-course",
          "shell",
          "components",
          "lib",
          "rpc"
        ],
        "gesture-demos": ["components", "lib"],
        "shell": ["components", "lib"],
        "infra": [],
        "components": ["lib"],
        "rpc": [],
        "gesture-lab": [],
        "motion-course": [],
        "swipe-lab": ["gesture-lab"],
        "page-turn": [],
        "lib": ["page-turn"]
      }
    }
  }
}
