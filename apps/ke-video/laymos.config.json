{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/web/client/styles.css"],
  "fileModules": [
    "src/video/library/schema.ts",
    "src/web/client/app.tsx",
    "src/web/server/loaders.server.ts"
  ],
  "rules": {
    "src/cli": ["src/video/library", "src/video/worker"],
    "src/video/worker": ["src/video/library"],
    "src/video/pipeline": ["src/video/library"],
    "src/web/server": ["src/web/shared"],
    "src/web/shared/pages": [
      "src/web/shared/api",
      "src/video/library/schema.ts"
    ],
    "src/web/shared/api": ["src/video/library/schema.ts"],
    "src/web/client/app.tsx": ["src/web/client/views", "src/web/shared"],
    "src/web/client/views": [
      "src/web/shared",
      "src/web/client/format",
      "src/web/client/touch",
      "src/web/client/keep",
      "src/video/library/schema.ts"
    ],
    "src/web/client/views/list": ["src/web/client/views/parts"],
    "src/web/client/views/video": ["src/web/client/views/parts"],
    "src/web/client/format": ["src/video/library/schema.ts"],
    "src/web/client/keep": ["src/video/library/schema.ts"]
  }
}
