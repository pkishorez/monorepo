{
  "name": "@kestack/connect-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Connects a computer to the cloud so its User reaches it from anywhere: ke-connect signs in, opens a Cloudflare tunnel, reports its Heartbeat and runs the Plugins Connect Cloud enables",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ke-connect-v2": "bin/ke-connect.mjs"
  },
  "exports": {
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./link": {
      "types": "./dist/http/link/contract/index.d.ts",
      "default": "./dist/http/link/contract/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "dev": "vp run --filter '@kestack/connect-v2^...' build && tsx src/dev.ts",
    "dev:real": "vp run --filter '@kestack/connect-v2^...' build && KE_CONNECT_CLOUD=$(portless get connect-v2.kishore) KE_DEVTOOLS=${KE_DEVTOOLS:-http://127.0.0.1:14400} tsx src/dev-real.ts serve dev",
    "fmt": "vp fmt",
    "lint": "vp check && tsc --noEmit && node ../../../devtools/monoverse/src/cli/main.ts lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kestack/auth-toolkit": "workspace:*",
    "@kestack/connect-v2-cloud": "workspace:*",
    "@kestack/devtools-kabuki": "workspace:*",
    "@kestack/kabuki": "workspace:*",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "cloudflared": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@kestack/monoverse": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
