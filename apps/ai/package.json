{
  "name": "ai",
  "version": "0.0.0",
  "description": "The local app for running Claude Code and Codex sessions in project folders, on an ai-toolkit server, at ai.kishore.computer.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp run --filter 'ai^...' build && portless run --force vp dev",
    "build": "vp build",
    "lint": "tsc --noEmit && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@kestack/ai-toolkit": "workspace:*",
    "@kestack/kabuki": "workspace:*",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "@tanstack/db": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "laymos": "workspace:*",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
