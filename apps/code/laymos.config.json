{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/styles.css", "src/env.d.ts"],
  "fileModules": [
    "src/app.tsx",
    "src/pages.ts",
    "src/document.tsx",
    "src/keys.ts",
    "src/deploy/machines-api/worker.server.ts"
  ],
  "rules": {
    "src/app.tsx": [
      "src/shell",
      "src/pages.ts",
      "src/layer/services",
      "src/sign-in",
      "src/document.tsx"
    ],
    "src/pages.ts": ["src/shell"],
    "src/document.tsx": ["src/ui/theme"],
    "src/layer/services": [
      "src/layer/capabilities",
      "src/layer/machine-health",
      "src/keys.ts"
    ],
    "src/sign-in": ["src/ui"],
    "src/ui/session-status": ["src/ui/running-dot"],
    "src/ui/picker": ["src/keys.ts"],
    "src/ui/confirm": ["src/keys.ts"],
    "src/shell": [
      "src/layer/capabilities",
      "src/layer/machine-health",
      "src/sign-in",
      "src/ui",
      "src/keys.ts"
    ],
    "src/shell/actors": [
      "src/shell/places",
      "src/shell/refusal",
      "src/shell/replica",
      "src/shell/connection"
    ],
    "src/shell/pages": [
      "src/shell/places",
      "src/shell/refusal",
      "src/shell/replica",
      "src/shell/connection",
      "src/shell/actors/dictation"
    ],
    "src/shell/pages/project/model-picker": ["src/shell/pages/project/catalog"],
    "src/shell/pages/project/capabilities": ["src/shell/pages/project/catalog"],
    "src/shell/pages/project/session": [
      "src/shell/pages/project/capabilities",
      "src/shell/pages/project/catalog",
      "src/shell/pages/project/draft",
      "src/shell/pages/project/model-picker"
    ]
  }
}
