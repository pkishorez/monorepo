{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/styles.css", "src/env.d.ts"],
  "fileModules": [
    "src/start.tsx",
    "src/app/app.ts",
    "src/app/account/account.ts",
    "src/app/account/frame/commands.ts",
    "src/app/account/frame/store.ts",
    "src/app/account/frame/header/voice/voice.ts",
    "src/app/account/pages/project/store.ts",
    "src/app/account/pages/settings/cards/store.ts",
    "src/app/account/pages/settings/cards/card/agents/store.ts"
  ],
  "rules": {
    "src/start.tsx": ["src/app", "src/ui/page/devtools", "src/ui/page/theme"],
    "src/app": ["src/ui"],
    "src/app/storage/local": ["src/app/storage/database"],
    "src/app/storage/cache": ["src/app/storage/database"],
    "src/app/account": ["src/app/app.ts", "src/app/storage", "src/app/sign-in"],
    "src/app/account/connection": ["src/app/account/account.ts"],
    "src/app/account/frame": [
      "src/app/account/account.ts",
      "src/app/account/connection"
    ],
    "src/app/account/frame/sidebar": [
      "src/app/account/frame/commands.ts",
      "src/app/account/frame/store.ts"
    ],
    "src/app/account/frame/header": ["src/app/account/frame/pickers"],
    "src/app/account/frame/pickers": [
      "src/app/account/frame/commands.ts",
      "src/app/account/frame/store.ts"
    ],
    "src/app/account/frame/header/voice/dictation": [
      "src/app/account/frame/header/voice/recorder",
      "src/app/account/frame/header/voice/voice.ts"
    ],
    "src/app/account/frame/header/voice/microphone": [
      "src/app/account/frame/header/voice/recorder"
    ],
    "src/app/account/connection/records": ["src/app/account/connection/link"],
    "src/app/account/connection/link/health": [
      "src/app/account/connection/link/reach"
    ],
    "src/app/account/pages": [
      "src/app/account/account.ts",
      "src/app/account/connection",
      "src/app/account/frame/commands.ts",
      "src/app/account/frame/header/voice"
    ],
    "src/app/account/pages/project/draft": [
      "src/app/account/pages/project/store.ts"
    ],
    "src/app/account/pages/project/session": [
      "src/app/account/pages/project/draft"
    ],
    "src/app/account/pages/project/session/transcript": [
      "src/app/account/pages/project/session/scroller",
      "src/app/account/pages/project/session/panels/details"
    ],
    "src/app/account/pages/project/session/transcript/tool": [
      "src/app/account/pages/project/session/transcript/words",
      "src/app/account/pages/project/session/transcript/turns/rows"
    ],
    "src/app/account/pages/settings/cards/card": [
      "src/app/account/pages/settings/cards/store.ts"
    ],
    "src/app/account/pages/settings/cards/card/agents/card": [
      "src/app/account/pages/settings/cards/card/agents/store.ts"
    ]
  },
  "exceptions": [
    {
      "from": "src/ui/controls/picker",
      "to": "src/app/account/frame/commands.ts",
      "because": "the Picker binds the app's own keyboard Actions (picker.*), defined with every other Action in the frame's keys, which imports nothing back"
    },
    {
      "from": "src/ui/controls/notice",
      "to": "src/app/account/frame/commands.ts",
      "because": "Confirm, in the notices, binds the app's own keyboard Actions, defined with every other Action in the frame's keys, which imports nothing back"
    }
  ]
}
