{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/styles.css", "src/env.d.ts"],
  "fileModules": [
    "src/app.tsx",
    "src/document.tsx",
    "src/keys.ts",
    "src/apis/machines/worker.server.ts"
  ],
  "rules": {
    "src/app.tsx": ["src/shell", "src/document.tsx"],
    "src/document.tsx": ["src/ui/theme"],
    "src/shell": [
      "src/places",
      "src/replica",
      "src/refusal",
      "src/ui",
      "src/keys.ts"
    ],
    "src/ui/session-status": ["src/ui/running-dot"],
    "src/ui/picker": ["src/keys.ts"],
    "src/ui/confirm": ["src/keys.ts"],
    "src/shell/connection": ["src/shell/machines"],
    "src/shell/header": ["src/shell/connection"],
    "src/shell/home": ["src/shell/connection", "src/shell/machines"],
    "src/shell/sidebar": ["src/shell/connection"],
    "src/shell/settings": [
      "src/shell/connection",
      "src/shell/machines",
      "src/shell/sign-in",
      "src/shell/device-state"
    ],
    "src/shell/dictation": ["src/shell/recorder"],
    "src/shell/microphone-picker": [
      "src/shell/device-state",
      "src/shell/recorder"
    ],
    "src/shell/machine": [
      "src/shell/connection",
      "src/shell/machines",
      "src/shell/device-state",
      "src/shell/dictation"
    ],
    "src/shell/machine/project/model-picker": [
      "src/shell/machine/project/catalog"
    ],
    "src/shell/machine/project/session": [
      "src/shell/machine/project/catalog",
      "src/shell/machine/project/draft",
      "src/shell/machine/project/model-picker"
    ]
  }
}
