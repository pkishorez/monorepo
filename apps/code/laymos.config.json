{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/styles.css", "src/env.d.ts"],
  "fileModules": ["src/app.tsx", "src/keys.ts"],
  "rules": {
    "src/app.tsx": [
      "src/shell",
      "src/layer/services",
      "src/sign-in",
      "src/ui/theme"
    ],
    "src/layer/services": ["src/layer/capabilities", "src/keys.ts"],
    "src/sign-in": ["src/ui"],
    "src/ui/session-status": ["src/ui/running-dot"],
    "src/ui/picker": ["src/keys.ts"],
    "src/ui/confirm": ["src/keys.ts"],
    "src/shell": [
      "src/layer/capabilities",
      "src/sign-in",
      "src/ui",
      "src/keys.ts"
    ],
    "src/shell/actors": [
      "src/shell/routes",
      "src/shell/refusal",
      "src/shell/replica",
      "src/shell/connection",
      "src/shell/moves"
    ],
    "src/shell/moves": ["src/shell/refusal"],
    "src/shell/pages": [
      "src/shell/routes",
      "src/shell/refusal",
      "src/shell/replica",
      "src/shell/connection",
      "src/shell/actors/dictation"
    ],
    "src/shell/actors/sidebar/settled-list": ["src/shell/actors/sidebar/swipe"],
    "src/shell/pages/project/capabilities": ["src/shell/pages/project/catalog"],
    "src/shell/pages/project/session": ["src/shell/pages/project/draft"],
    "src/shell/pages/project/draft": [
      "src/shell/pages/project/capabilities",
      "src/shell/pages/project/catalog"
    ]
  }
}
