{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/styles.css", "src/env.d.ts"],
  "fileModules": ["src/app.tsx", "src/keys.ts"],
  "rules": {
    "src/app.tsx": ["src/shell", "src/layer/services", "src/ui/theme"],
    "src/layer/services": ["src/layer/capabilities", "src/keys.ts"],
    "src/ui/session-status": ["src/ui/running-dot"],
    "src/ui/status-word": ["src/ui/time"],
    "src/ui/picker": ["src/keys.ts"],
    "src/ui/confirm": ["src/keys.ts"],
    "src/shell": ["src/layer/capabilities", "src/ui", "src/keys.ts"],
    "src/shell/actors": ["src/shell/routes", "src/shell/machines"],
    "src/shell/actors/sidebar": ["src/shell/actors/moves"],
    "src/shell/actors/pickers/session-actions": ["src/shell/actors/moves"],
    "src/shell/pages": ["src/shell/routes", "src/shell/machines"],
    "src/shell/actors/sidebar/settled-list": [
      "src/shell/actors/sidebar/swipe",
      "src/shell/actors/sidebar/arrive"
    ],
    "src/shell/pages/project/session": ["src/shell/pages/project/draft"],
    "src/shell/pages/settings/general": [
      "src/shell/actors/pickers/microphone-picker"
    ],
    "src/shell/actors/pickers/project-picker": ["src/shell/pages/project"],
    "src/shell/pages/project/starter": [
      "src/shell/pages/project/capabilities",
      "src/shell/pages/project/draft"
    ],
    "src/shell/pages/settings/machines/harness-accounts/card": [
      "src/shell/pages/settings/machines/harness-accounts/capabilities"
    ],
    "src/shell/pages/project/draft": [
      "src/shell/pages/project/capabilities",
      "src/shell/actors/dictation"
    ]
  }
}
