{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/styles.css", "src/env.d.ts"],
  "fileModules": ["src/app.tsx", "src/document.tsx", "src/keys.ts"],
  "rules": {
    "src/app.tsx": ["src/shell", "src/document.tsx"],
    "src/document.tsx": ["src/ui/theme"],
    "src/shell": [
      "src/places",
      "src/replica",
      "src/refusal",
      "src/ui",
      "src/keys.ts"
    ],
    "src/ui/session-status": ["src/ui/running-dot"],
    "src/ui/picker": ["src/keys.ts"],
    "src/ui/confirm": ["src/keys.ts"],
    "src/shell/header": ["src/shell/connection"],
    "src/shell/settings/shortcuts": ["src/shell/device-state"],
    "src/shell/project": ["src/shell/connection"],
    "src/shell/project/model-picker": ["src/shell/project/catalog"],
    "src/shell/project/session": [
      "src/shell/device-state",
      "src/shell/project/catalog",
      "src/shell/project/composer",
      "src/shell/project/model-picker"
    ]
  }
}
