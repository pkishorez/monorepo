{
  "name": "code",
  "version": "0.0.0",
  "description": "The local app for running Claude Code and Codex sessions in project folders, on an ai-toolkit server, at code.kishore.computer.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp run --filter 'code^...' build && CONNECT_URL=$(portless get connect.kishore) portless run --force alchemy dev",
    "build": "vp build",
    "lint": "tsc --noEmit && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "test": "vitest run",
    "draw:install": "node scripts/draw-install.ts",
    "deploy": "alchemy deploy",
    "deploy:prod": "ALLOW_DEPLOY=true alchemy deploy --stage prod"
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@kestack/auth-toolkit": "workspace:*",
    "@kestack/connect": "workspace:*",
    "@kestack/kabuki": "workspace:*",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@kestack/use-keys": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "@tanstack/db": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "laymos": "workspace:*",
    "miniflare": "catalog:",
    "playwright-core": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
