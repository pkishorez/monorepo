{
  "name": "code",
  "version": "0.0.0",
  "description": "The app for running Claude Code and Codex sessions in project folders on any of your Machines, through Connect, at code.kishore.app.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp run --filter 'code^...' build && node scripts/dev.ts",
    "dev:real": "KESTACK_AUTH=real pnpm run dev",
    "build": "vp build",
    "lint": "tsc --noEmit && pnpm lint:laymos && pnpm tree",
    "lint:laymos": "laymos lint",
    "test": "vitest run",
    "size": "node scripts/size.ts",
    "tree": "node scripts/tree.ts",
    "draw:install": "node scripts/draw-install.ts",
    "deploy": "alchemy deploy",
    "deploy:prod": "ALLOW_DEPLOY=true alchemy deploy --stage prod"
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@kestack/auth-toolkit": "workspace:*",
    "@kestack/connect": "workspace:*",
    "@kestack/devtools-kabuki": "workspace:*",
    "@kestack/kabuki": "workspace:*",
    "@kestack/rpc-toolkit": "workspace:*",
    "@kestack/std-toolkit": "workspace:*",
    "@kestack/use-keys": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "@tanstack/db": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "laymos": "workspace:*",
    "miniflare": "catalog:",
    "playwright-core": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
