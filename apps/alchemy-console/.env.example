# Read by alchemy.run.ts for a personal stage (pnpm dev). Deployed stages
# (prod, dev, pr<N>) are set by CI and ignore these.

# Who may use Console: emails, comma-separated.
CONSOLE_INVITES=kishore.iiitn@gmail.com

# Leave empty for Local mode: sign in as anyone, asking no Auth Worker.
# Set to https://auth.kishore.computer to sign in with Google behind portless.
CONSOLE_AUTH_URL=

# The Vault key goes in .env.vault-local, not here: CONSOLE_VAULT_KEY=<32 random
# bytes, base64>, e.g. from `openssl rand -base64 32`.

# The GitHub App goes in .env.github-dev: the alchemy-console-dev App's
# GH_APP_ID, GH_APP_SLUG, GH_APP_PRIVATE_KEY (newlines written \n),
# GH_APP_WEBHOOK_SECRET, GH_APP_CLIENT_ID and GH_APP_CLIENT_SECRET.
