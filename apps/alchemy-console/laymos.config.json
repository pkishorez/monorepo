{
  "$schema": "./node_modules/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts"],
  "layers": {
    "client-auth": {
      "paths": ["src/client/auth"],
      "description": "Connects login and sessions to the shared auth service.",
      "modules": {
        "src/client/auth": {
          "exposed": true
        }
      }
    },
    "shared-rpc-definitions": {
      "paths": ["src/shared/rpc/greeting"],
      "description": "Defines the greeting protocol.",
      "modules": {
        "src/shared/rpc/greeting": {
          "exposed": true
        }
      }
    },
    "shared-rpc-handlers": {
      "paths": ["src/shared/rpc/greeting-handlers"],
      "description": "Answers greeting requests.",
      "modules": {
        "src/shared/rpc/greeting-handlers": {
          "exposed": true
        }
      }
    },
    "client-rpc": {
      "paths": ["src/client/rpc"],
      "description": "Connects the browser to RPC.",
      "modules": {
        "src/client/rpc": {
          "exposed": true
        }
      }
    },
    "route-runtime": {
      "paths": ["src/routes/internal"],
      "description": "Owns the session connection lifetime.",
      "modules": {
        "src/routes/internal/rpc-provider.tsx": {
          "exposed": true
        }
      }
    },
    "routes": {
      "paths": ["src/routes/__root.tsx", "src/routes/page.tsx"],
      "description": "Renders the document and greeting page.",
      "modules": {
        "src/routes/__root.tsx": {
          "exposed": true
        },
        "src/routes/page.tsx": {
          "exposed": true
        }
      }
    },
    "web-entry": {
      "paths": ["src/router.tsx"],
      "description": "Creates the router.",
      "modules": {
        "src/router.tsx": {}
      }
    },
    "server-entry": {
      "paths": ["src/server.ts"],
      "description": "Hosts TanStack Start and dispatches RPC requests.",
      "modules": {
        "src/server.ts": {}
      }
    },
    "rpc-entry": {
      "paths": ["src/server/entry.ts"],
      "description": "Provides D1 SQLite and hosts HTTP RPC.",
      "modules": {
        "src/server/entry.ts": {
          "exposed": true
        }
      }
    },
    "contracts": {
      "paths": ["src/shared/contracts"],
      "description": "Defines application storage and state-store records.",
      "modules": {
        "src/shared/contracts/app-table": {
          "exposed": true,
          "shared": true
        },
        "src/shared/contracts/alchemy-state-store": {
          "exposed": true
        }
      }
    },
    "server-operations": {
      "paths": ["src/server/operations/state-stores"],
      "description": "Manages user-owned connections and masks credentials.",
      "modules": {
        "src/server/operations/state-stores": {
          "exposed": true
        }
      }
    },
    "server-rpc-definitions": {
      "paths": ["src/server/rpc/state-stores"],
      "description": "Defines authenticated state-store calls and safe responses.",
      "modules": {
        "src/server/rpc/state-stores": {
          "exposed": true
        }
      }
    },
    "server-rpc-handlers": {
      "paths": ["src/server/rpc/state-store-handlers"],
      "description": "Connects state-store calls to server operations.",
      "modules": {
        "src/server/rpc/state-store-handlers": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "application": {
      "description": "Web and Worker entries compose HTTP RPC and D1 storage.",
      "rules": {
        "web-entry": ["routes"],
        "routes": ["route-runtime", "client-auth"],
        "route-runtime": ["client-rpc"],
        "client-rpc": ["shared-rpc-definitions", "server-rpc-definitions"],
        "shared-rpc-handlers": ["shared-rpc-definitions"],
        "rpc-entry": [
          "shared-rpc-handlers",
          "contracts",
          "server-rpc-handlers"
        ],
        "server-entry": ["rpc-entry"],
        "server-operations": ["contracts"],
        "server-rpc-handlers": ["server-rpc-definitions", "server-operations"]
      }
    }
  }
}
