{
  "$schema": "./node_modules/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts"],
  "fileModules": [
    "src/server.ts",
    "src/router.tsx",
    "src/routes/__root.tsx",
    "src/routes/page.tsx",
    "src/routes/settings/page.tsx",
    "src/routes/stores/page.tsx",
    "src/routes/stores/$storeId/page.tsx"
  ],
  "rules": {
    "*": ["src/server/storage/table"],
    "src/shared/contracts/deletion": ["src/shared/contracts/credentials"],
    "src/shared/contracts/resources": ["src/shared/contracts/targets"],
    "src/shared/api": ["src/shared/rpc"],
    "src/shared/rpc": ["src/shared/contracts"],
    "src/server.ts": ["src/server/host"],
    "src/server/host": [
      "src/server/handlers",
      "src/server/telemetry",
      "src/server/storage/table",
      "src/shared/api"
    ],
    "src/server/handlers": ["src/shared/api", "src/server/workflows"],
    "src/server/workflows": [
      "src/server/services",
      "src/server/providers",
      "src/server/storage",
      "src/shared/contracts"
    ],
    "src/server/workflows/stores/stores": [
      "src/server/workflows/stores/access",
      "src/server/workflows/stores/management",
      "src/server/workflows/stores/explorer",
      "src/server/workflows/stores/deletion"
    ],
    "src/server/services": ["src/server/providers", "src/shared/contracts"],
    "src/server/services/deletion/deletion": [
      "src/server/services/deletion/engine"
    ],
    "src/server/services/deletion/engine": [
      "src/server/services/deletion/review",
      "src/server/services/deletion/selection",
      "src/server/services/deletion/forget"
    ],
    "src/server/services/deletion/review": [
      "src/server/services/deletion/selection"
    ],
    "src/server/providers": ["src/shared/contracts"],
    "src/server/providers/providers": [
      "src/server/providers/cloudflare",
      "src/server/providers/aws"
    ],
    "src/client/features": [
      "src/client/session",
      "src/client/providers",
      "src/client/connections/rpc",
      "src/shared/contracts"
    ],
    "src/client/features/settings": [
      "src/client/features/query-feedback",
      "src/client/features/credentials"
    ],
    "src/client/features/auth-boundary": [
      "src/client/features/brand",
      "src/client/connections/auth"
    ],
    "src/client/features/console": [
      "src/client/features/brand",
      "src/client/features/credentials",
      "src/client/features/query-feedback"
    ],
    "src/client/features/console/workspace": [
      "src/client/features/console/stores",
      "src/client/features/console/explorer",
      "src/client/features/console/resources",
      "src/client/features/console/deletion",
      "src/client/features/console/state-view",
      "src/client/features/console/queries"
    ],
    "src/client/features/console/stores": [
      "src/client/features/console/explorer",
      "src/client/features/console/queries"
    ],
    "src/client/features/console/explorer": [
      "src/client/features/console/state-view",
      "src/client/features/console/queries"
    ],
    "src/client/features/console/resources": [
      "src/client/features/console/state-view",
      "src/client/features/console/queries"
    ],
    "src/client/features/console/deletion": [
      "src/client/features/console/queries"
    ],
    "src/client/providers/credential-forms": [
      "src/client/providers/cloudflare",
      "src/client/providers/aws"
    ],
    "src/client/session": ["src/client/connections"],
    "src/client/connections": ["src/shared/api", "src/client/telemetry"],
    "src/routes": ["src/client/features"]
  }
}
