{
  "$schema": "./node_modules/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts"],
  "layers": {
    "shared-contracts": {
      "paths": ["src/shared/contracts"],
      "description": "Defines browser-safe inputs, views and failures without storage or runtime implementations.",
      "modules": {
        "src/shared/contracts/credentials": { "shared": true, "exposed": true },
        "src/shared/contracts/stores": { "exposed": true },
        "src/shared/contracts/targets": { "shared": true, "exposed": true },
        "src/shared/contracts/resources": { "exposed": true },
        "src/shared/contracts/deletion": { "exposed": true }
      }
    },
    "shared-rpc": {
      "paths": ["src/shared/rpc"],
      "description": "Declares capability-specific procedures over browser-safe schemas.",
      "modules": {
        "src/shared/rpc/credentials": { "exposed": true },
        "src/shared/rpc/stores": { "exposed": true },
        "src/shared/rpc/explorer": { "exposed": true },
        "src/shared/rpc/deletion": { "exposed": true }
      }
    },
    "shared-api": {
      "paths": ["src/shared/api"],
      "description": "Composes the Console API and applies its inherited authentication policy once.",
      "modules": {
        "src/shared/api/console-api": { "exposed": true }
      }
    },
    "server-entry": {
      "paths": ["src/server.ts"],
      "description": "Dispatches Worker requests to RPC or the web framework.",
      "modules": {
        "src/server.ts": {}
      }
    },
    "server-host": {
      "paths": ["src/server/host"],
      "description": "Builds database, HTTP, authentication and telemetry providers and hosts the RPC handlers.",
      "modules": {
        "src/server/host/rpc-host": { "exposed": true }
      }
    },
    "server-handlers": {
      "paths": ["src/server/handlers"],
      "description": "Binds the authenticated API to the user-scoped workflows.",
      "modules": {
        "src/server/handlers/console-handlers": { "exposed": true }
      }
    },
    "server-workflows": {
      "paths": ["src/server/workflows"],
      "description": "Owns user-scoped sequencing and failure policy over storage, providers and services.",
      "modules": {
        "src/server/workflows/credentials": { "exposed": true }
      },
      "moduleGraphs": {
        "stores": {
          "path": "src/server/workflows/stores",
          "description": "Authorizes a user's store operations: management, browsing and stage deletion behind one door.",
          "modules": {
            "stores": { "exposed": true },
            "access": {},
            "management": {},
            "explorer": {},
            "deletion": {}
          },
          "rules": {
            "stores": ["access", "management", "explorer", "deletion"]
          }
        }
      }
    },
    "server-services": {
      "paths": ["src/server/services"],
      "description": "Reads Alchemy state or runs Alchemy deletions; services never see storage or each other.",
      "modules": {
        "src/server/services/alchemy-state": { "exposed": true }
      },
      "moduleGraphs": {
        "deletion": {
          "path": "src/server/services/deletion",
          "description": "Selects credentials, reviews every resource and executes native Alchemy plans.",
          "modules": {
            "deletion": { "exposed": true },
            "engine": {},
            "selection": {},
            "review": {},
            "forget": {}
          },
          "rules": {
            "deletion": ["engine"],
            "engine": ["review", "selection", "forget"],
            "review": ["selection"]
          }
        }
      }
    },
    "server-providers": {
      "paths": ["src/server/providers"],
      "description": "Owns what one cloud provider knows: verifying credentials, locating, checking and deleting its resources.",
      "moduleGraphs": {
        "providers": {
          "path": "src/server/providers",
          "description": "One door returns a provider by kind; providers never see each other.",
          "modules": {
            "providers": { "exposed": true },
            "cloudflare": {},
            "aws": {}
          },
          "rules": {
            "providers": ["cloudflare", "aws"]
          }
        }
      }
    },
    "server-storage": {
      "paths": ["src/server/storage"],
      "description": "Owns the console table and its entities consumed by workflows and the host.",
      "modules": {
        "src/server/storage/table": { "shared": true, "exposed": true },
        "src/server/storage/stores": { "exposed": true },
        "src/server/storage/credentials": { "exposed": true }
      }
    },
    "server-telemetry": {
      "paths": ["src/server/telemetry"],
      "description": "Configures development telemetry for the Worker runtime.",
      "modules": {
        "src/server/telemetry": { "exposed": true }
      }
    },
    "client-features": {
      "paths": ["src/client/features"],
      "description": "Owns the brand, authentication UI, credential settings and the store console with private functional boundaries.",
      "modules": {
        "src/client/features/query-feedback": { "shared": true },
        "src/client/features/credentials": { "shared": true },
        "src/client/features/settings": { "exposed": true },
        "src/client/features/brand": { "shared": true, "exposed": true },
        "src/client/features/auth-boundary": { "exposed": true }
      },
      "moduleGraphs": {
        "console": {
          "path": "src/client/features/console",
          "description": "Composes store management, exploration and deletion through one workspace door.",
          "modules": {
            "workspace": { "exposed": true },
            "stores": {},
            "explorer": {},
            "resources": {},
            "deletion": {},
            "state-view": {},
            "queries": {}
          },
          "rules": {
            "workspace": [
              "stores",
              "explorer",
              "resources",
              "deletion",
              "state-view",
              "queries"
            ],
            "stores": ["explorer", "queries"],
            "explorer": ["state-view", "queries"],
            "resources": ["state-view", "queries"],
            "deletion": ["queries"]
          }
        }
      }
    },
    "client-providers": {
      "paths": ["src/client/providers"],
      "description": "Provider-specific credential forms and identity formatting; pure UI with no session.",
      "moduleGraphs": {
        "credential-forms": {
          "path": "src/client/providers",
          "description": "One door renders a provider's credential fields; providers never see each other.",
          "modules": {
            "credential-forms": { "exposed": true },
            "cloudflare": {},
            "aws": {}
          },
          "rules": {
            "credential-forms": ["cloudflare", "aws"]
          }
        }
      }
    },
    "client-session": {
      "paths": ["src/client/session"],
      "description": "Owns the RPC connection lifetime, private React context, query/action hooks and user-facing error text for a signed-in session.",
      "modules": {
        "src/client/session/rpc-session": { "exposed": true }
      }
    },
    "client-connections": {
      "paths": ["src/client/connections"],
      "description": "Connects to authentication and typed RPC; each connection is independent of its peer.",
      "modules": {
        "src/client/connections/auth": { "exposed": true },
        "src/client/connections/rpc": { "exposed": true }
      }
    },
    "client-telemetry": {
      "paths": ["src/client/telemetry"],
      "description": "Configures development telemetry for the browser runtime.",
      "modules": {
        "src/client/telemetry": { "exposed": true }
      }
    },
    "web-entry": {
      "paths": ["src/router.tsx"],
      "description": "Creates the framework router over the generated route tree.",
      "modules": {
        "src/router.tsx": {}
      }
    },
    "routes": {
      "paths": ["src/routes"],
      "description": "Owns URLs, document composition and navigation while mounting independent client features.",
      "modules": {
        "src/routes/__root.tsx": { "exposed": true },
        "src/routes/page.tsx": { "exposed": true },
        "src/routes/settings/page.tsx": { "exposed": true },
        "src/routes/stores/page.tsx": { "exposed": true },
        "src/routes/stores/$storeId/page.tsx": { "exposed": true }
      }
    }
  },
  "layerGraphs": {
    "shared": {
      "description": "The common language: RPC protocols depend on pure contracts. Neither can reach a runtime.",
      "rules": {
        "shared-api": ["shared-rpc"],
        "shared-rpc": ["shared-contracts"],
        "shared-contracts": []
      }
    },
    "server": {
      "description": "A request enters the host, reaches a handler and runs a workflow over providers, services and storage.",
      "rules": {
        "server-entry": ["server-host"],
        "server-host": ["server-handlers", "server-telemetry"],
        "server-handlers": ["shared-api", "server-workflows"],
        "server-workflows": [
          "server-services",
          "server-providers",
          "server-storage",
          "shared-contracts"
        ],
        "server-services": ["server-providers", "shared-contracts"],
        "server-providers": ["shared-contracts"],
        "server-storage": [],
        "server-telemetry": []
      }
    },
    "client": {
      "description": "Features use a session whose connections speak shared protocols, and provider forms that know nothing above them.",
      "rules": {
        "client-features": ["client-session", "client-providers"],
        "client-providers": [],
        "client-session": ["client-connections"],
        "client-connections": ["shared-api", "client-telemetry"],
        "client-telemetry": []
      }
    },
    "routes": {
      "description": "The router starts pages; pages bind URLs and navigation to client features.",
      "rules": {
        "web-entry": ["routes"],
        "routes": ["client-features"]
      }
    }
  }
}
