{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/env.d.ts", "src/client/styles.css"],
  "fileModules": [
    "src/client/app.tsx",
    "src/client/document.tsx",
    "src/server/worker.ts",
    "src/server/loaders.server.ts"
  ],
  "rules": {
    "src/client/add-credential": [
      "src/shared/contracts/credential",
      "src/shared/pages"
    ],
    "src/client/app.tsx": [
      "src/client/console",
      "src/client/document.tsx",
      "src/shared/pages"
    ],
    "src/client/connect-github": [
      "src/shared/contracts/github",
      "src/shared/pages"
    ],
    "src/client/console": [
      "src/client/pages",
      "src/shared/pages",
      "src/shared/contracts/console-api",
      "src/shared/contracts/local-session",
      "src/shared/contracts/member"
    ],
    "src/client/pages": ["src/shared/pages", "src/client/connect-github"],
    "src/client/pages/settings": [
      "src/client/add-credential",
      "src/shared/contracts/credential",
      "src/shared/contracts/github"
    ],
    "src/runner": [
      "src/shared/contracts/run",
      "src/shared/contracts/runner-api"
    ],
    "src/server/host": [
      "src/server/user-space",
      "src/shared/contracts/member",
      "src/server/connection-index"
    ],
    "src/server/host/github": ["src/server/host/visitor"],
    "src/server/host/runner": ["src/server/run-token"],
    "src/server/host/visitor": ["src/shared/contracts/local-session"],
    "src/server/loaders.server.ts": [
      "src/server/host",
      "src/server/user-space",
      "src/shared/pages",
      "src/shared/contracts/console-api"
    ],
    "src/server/user-space": [
      "src/shared/contracts/console-api",
      "src/shared/contracts/member",
      "src/server/connection-index",
      "src/server/runner-container",
      "src/shared/contracts/runner-api"
    ],
    "src/server/user-space/services/github": ["src/shared/contracts/github"],
    "src/server/user-space/services/providers": [
      "src/shared/contracts/credential"
    ],
    "src/server/user-space/services/runner-host": ["src/server/run-token"],
    "src/server/user-space/services/storage": [
      "src/shared/contracts/credential",
      "src/shared/contracts/github",
      "src/shared/contracts/run"
    ],
    "src/server/user-space/workflows/connections": [
      "src/server/user-space/services/github",
      "src/server/user-space/services/storage",
      "src/shared/contracts/github"
    ],
    "src/server/user-space/workflows/credentials": [
      "src/server/user-space/services/providers",
      "src/server/user-space/services/storage",
      "src/server/user-space/services/vault",
      "src/shared/contracts/credential"
    ],
    "src/server/user-space/workflows/github-events": [
      "src/server/user-space/workflows/connections"
    ],
    "src/server/user-space/workflows/repositories": [
      "src/server/user-space/services/github",
      "src/server/user-space/services/storage",
      "src/shared/contracts/github"
    ],
    "src/server/user-space/workflows/run-lifecycle": [
      "src/server/user-space/services/github",
      "src/server/user-space/services/runner-host",
      "src/server/user-space/services/storage",
      "src/server/user-space/workflows/credentials",
      "src/shared/contracts/run"
    ],
    "src/server/user-space/workflows/session": [
      "src/server/user-space/services/storage"
    ],
    "src/server/worker.ts": [
      "src/server/host",
      "src/server/user-space",
      "src/server/runner-container"
    ],
    "src/shared/contracts/console-api": [
      "src/shared/contracts/credential",
      "src/shared/contracts/member",
      "src/shared/contracts/github"
    ],
    "src/shared/contracts/console-api/runs": ["src/shared/contracts/run"],
    "src/shared/contracts/runner-api": ["src/shared/contracts/run"],
    "src/shared/pages": [
      "src/shared/contracts/console-api",
      "src/shared/contracts/credential",
      "src/shared/contracts/member",
      "src/shared/contracts/github"
    ],
    "src/shared/pages/console": [
      "src/shared/pages/capabilities",
      "src/shared/pages/settings",
      "src/shared/pages/welcome"
    ],
    "src/shared/pages/welcome": ["src/shared/pages/capabilities"]
  }
}
