{
  "name": "alchemy-console",
  "description": "Web console for browsing Alchemy state stores and deleting stacks, stages and resources with user-owned provider credentials.",
  "version": "0.0.0",
  "dependencies": {
    "@distilled.cloud/aws": "catalog:",
    "@distilled.cloud/cloudflare": "catalog:",
    "@kstackz/effect-tracer": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "alchemy": "catalog:",
    "@kstackz/auth-toolkit": "workspace:*",
    "effect": "catalog:",
    "@kstackz/ui-toolkit": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@kstackz/use-gesture": "workspace:*",
    "use-effect-ts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "laymos": "workspace:*",
    "miniflare": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "private": true,
  "scripts": {
    "build": "vp build",
    "dev": "portless run --force alchemy dev",
    "dev:force": "alchemy state unsafe nuke --backend local --yes && pnpm dev",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts tests",
    "test:worker": "node tests/worker-runtime.mjs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./deletion-engine": "./src/server/services/deletion/engine/index.ts",
    "./providers": "./src/server/providers/providers/index.ts"
  }
}
