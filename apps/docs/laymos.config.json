{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/client/styles.css"],
  "fileModules": ["src/client/app.tsx", "src/client/document.tsx"],
  "rules": {
    "src/client": ["src/shared"],
    "src/client/app.tsx": [
      "src/client/pages",
      "src/client/components",
      "src/client/document.tsx"
    ],
    "src/client/document.tsx": ["src/client/components"],
    "src/client/pages": [
      "src/client/components",
      "src/client/demos",
      "src/client/docs"
    ],
    "src/client/demos/opening-an-app/screens": [
      "src/client/demos/opening-an-app/story"
    ],
    "src/shared/pages": ["src/shared/content"]
  }
}
