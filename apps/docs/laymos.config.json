{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts", "src/styles", "src/types.d.ts"],
  "layers": {
    "entry": {
      "paths": ["src/router.tsx", "src/start.ts", "src/server.ts"],
      "description": "Host entries \u2014 TanStack Start server, router, worker forwarding",
      "modules": {
        "src/router.tsx": {},
        "src/start.ts": {},
        "src/server.ts": {}
      }
    },
    "routes": {
      "paths": ["src/routes"],
      "description": "Route surface \u2014 pages and API handlers",
      "modules": {
        "src/routes": {}
      }
    },
    "infra": {
      "paths": ["src/infra"],
      "description": "Deployable resources \u2014 each worker defined separately, composed by alchemy.run.ts",
      "modules": {
        "src/infra": {}
      }
    },
    "components": {
      "paths": ["src/components"],
      "description": "Presentation shared across routes",
      "modules": {
        "src/components/mdx.tsx": {
          "exposed": true
        },
        "src/components/home-header.tsx": {
          "shared": true,
          "exposed": true
        },
        "src/components/not-found.tsx": {
          "exposed": true
        },
        "src/components/status-badge.tsx": {
          "shared": true,
          "exposed": true
        },
        "src/components/eschema-playground.tsx": {
          "shared": true,
          "exposed": true
        }
      }
    },
    "lib": {
      "paths": ["src/lib"],
      "description": "Content sources and shared layout data",
      "modules": {
        "src/lib/source.ts": {
          "exposed": true
        },
        "src/lib/blog.ts": {
          "shared": true,
          "exposed": true
        },
        "src/lib/blog-data.ts": {
          "exposed": true
        },
        "src/lib/shared.ts": {
          "shared": true,
          "exposed": true
        },
        "src/lib/layout.shared.tsx": {
          "exposed": true
        }
      }
    },
    "bank-app": {
      "paths": ["src/demos/bank/app"],
      "description": "Std Bank demo \u2014 the page: the Transfer draft, live queries, and the store catalog over the client and the UI",
      "moduleGraphs": {
        "bank-app": {
          "description": "Owns one path from user intent through the Transfer draft to rendering.",
          "path": "src/demos/bank/app",
          "modules": {
            "draft": {},
            "bank-page": {
              "exposed": true
            }
          },
          "rules": {
            "bank-page": ["draft"]
          }
        }
      }
    },
    "bank-ui": {
      "paths": ["src/demos/bank/ui"],
      "description": "Std Bank demo \u2014 one dumb component: every fact as a prop, every act as a callback",
      "modules": {
        "src/demos/bank/ui": {
          "exposed": true
        }
      }
    },
    "bank-client": {
      "paths": ["src/demos/bank/client"],
      "description": "Std Bank demo \u2014 the browser bank: one runtime per store over the RPC api",
      "moduleGraphs": {
        "bank-client": {
          "description": "Connects to a bank, syncs its collections, sends transfers, and exposes one runtime per store.",
          "path": "src/demos/bank/client",
          "modules": {
            "live-value.ts": {},
            "api": {},
            "diagnostics": {},
            "sync": {},
            "transfers": {},
            "admin": {},
            "stores": {},
            "bank": {
              "exposed": true
            }
          },
          "rules": {
            "diagnostics": ["live-value.ts"],
            "sync": ["api", "diagnostics"],
            "transfers": ["api", "sync", "diagnostics", "live-value.ts"],
            "admin": ["api", "sync", "diagnostics"],
            "stores": ["api"],
            "bank": [
              "api",
              "diagnostics",
              "sync",
              "transfers",
              "admin",
              "stores",
              "live-value.ts"
            ]
          }
        }
      }
    },
    "bank-server": {
      "paths": ["src/demos/bank/server"],
      "description": "Std Bank demo \u2014 the bank as a service layer over any StdTable, and as a web handler",
      "modules": {
        "src/demos/bank/server": {
          "exposed": true
        }
      }
    },
    "bank-rpc": {
      "paths": ["src/demos/bank/rpc"],
      "description": "Std Bank demo \u2014 the wire: a contract naming two RPC groups, mutation handlers, and subscription handlers",
      "moduleGraphs": {
        "bank-rpc": {
          "description": "Moves the Bank functionality across a boundary without caring which boundary.",
          "path": "src/demos/bank/rpc",
          "modules": {
            "contract": {
              "exposed": true
            },
            "mutations": {
              "exposed": true
            },
            "subscriptions": {
              "exposed": true
            }
          },
          "rules": {
            "mutations": ["contract"],
            "subscriptions": ["contract"]
          }
        }
      }
    },
    "bank-std-table": {
      "paths": ["src/demos/bank/std-table"],
      "description": "Std Bank demo \u2014 the single-table design and its entity bindings",
      "moduleGraphs": {
        "std-table": {
          "description": "Binds the domain to one StdTable: the topology and one entity per record kind.",
          "path": "src/demos/bank/std-table",
          "modules": {
            "table": {
              "exposed": true
            },
            "entities/account": {
              "exposed": true
            },
            "entities/transfer": {
              "exposed": true
            }
          },
          "rules": {
            "entities/account": ["table"],
            "entities/transfer": ["table"]
          }
        }
      }
    },
    "bank-contract": {
      "paths": ["src/demos/bank/contract"],
      "description": "Std Bank demo \u2014 schemas, name rules, domain refusals",
      "modules": {
        "src/demos/bank/contract/account": {
          "exposed": true
        },
        "src/demos/bank/contract/transfer": {
          "exposed": true
        },
        "src/demos/bank/contract/name": {
          "exposed": true
        },
        "src/demos/bank/contract/refusal": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "docs-site": {
      "description": "Docs app: entries over routes over components over lib",
      "rules": {
        "entry": ["components"],
        "routes": ["components", "lib", "bank-app"],
        "infra": ["bank-server", "bank-rpc", "bank-std-table"],
        "components": ["lib"]
      }
    },
    "std-bank": {
      "description": "Std Bank demo: app over client over server over rpc over table over the contract, with the UI beside them",
      "rules": {
        "bank-app": ["bank-client", "bank-ui", "bank-contract"],
        "bank-client": [
          "bank-server",
          "bank-rpc",
          "bank-std-table",
          "bank-contract"
        ],
        "bank-server": ["bank-rpc", "bank-std-table", "bank-contract"],
        "bank-rpc": ["bank-std-table", "bank-contract"],
        "bank-std-table": ["bank-contract"],
        "bank-ui": ["bank-contract"]
      }
    }
  }
}
