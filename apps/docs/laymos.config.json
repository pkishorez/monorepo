{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/client/styles.css"],
  "fileModules": ["src/client/app.tsx"],
  "rules": {
    "src/client": ["src/shared"],
    "src/client/app.tsx": ["src/client/pages", "src/client/components"],
    "src/client/pages": [
      "src/client/components",
      "src/client/demos",
      "src/client/docs",
      "src/client/field"
    ],
    "src/client/demos/opening-an-app/screens": [
      "src/client/demos/opening-an-app/story"
    ],
    "src/shared/pages": ["src/shared/content"],
    "src/client/docs": ["src/client/components"],
    "src/client/demos/todos": ["src/client/demos/stage"],
    "src/client/demos/opening-an-app": ["src/client/demos/stage"],
    "src/client/field/shapes/stack": ["src/client/field/shapes/pen"],
    "src/client/field/shapes/kabuki": ["src/client/field/shapes/pen"]
  }
}
