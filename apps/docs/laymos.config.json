{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts", "src/styles", "src/types.d.ts"],
  "fileModules": [
    "src/router.tsx",
    "src/start.ts",
    "src/server.ts",
    "src/components/not-found.tsx",
    "src/lib/theme.tsx",
    "src/lib/demos.tsx"
  ],
  "rules": {
    "src/router.tsx": ["src/components"],
    "src/routes": ["src/lib", "src/demos/effect-oak"],
    "src/demos/effect-oak/canvas-art": ["src/demos/effect-oak/frame-canvas"],
    "src/demos/effect-oak/generative-art": [
      "src/demos/effect-oak/frame-canvas"
    ],
    "src/demos/effect-oak/api-cache": [
      "src/demos/effect-oak/async-data",
      "src/demos/effect-oak/blog-server"
    ],
    "src/demos/effect-oak/api-cache-query": [
      "src/demos/effect-oak/async-data",
      "src/demos/effect-oak/blog-server"
    ],
    "src/demos/effect-oak/charting": ["src/demos/effect-oak/async-data"],
    "src/demos/effect-oak/query-sync/param": [
      "src/demos/effect-oak/query-sync/url"
    ],
    "src/demos/effect-oak/map/places": ["src/demos/effect-oak/map/world"],
    "src/demos/effect-oak/map/finder": ["src/demos/effect-oak/map/world"],
    "src/demos/effect-oak/map/viewport": ["src/demos/effect-oak/map/world"],
    "src/demos/effect-oak/shopping-cart/products": [
      "src/demos/effect-oak/shopping-cart/basket",
      "src/demos/effect-oak/shopping-cart/shop-server"
    ],
    "src/demos/effect-oak/shopping-cart/checkout": [
      "src/demos/effect-oak/shopping-cart/basket",
      "src/demos/effect-oak/shopping-cart/shop-server"
    ],
    "src/demos/effect-oak/shopping-cart/cart-page": [
      "src/demos/effect-oak/shopping-cart/basket"
    ],
    "src/demos/effect-oak/shopping-cart/shop-server": [
      "src/demos/effect-oak/shopping-cart/basket"
    ],
    "src/demos/effect-oak/kanban/board-store": [
      "src/demos/effect-oak/kanban/columns"
    ],
    "src/demos/effect-oak/auth/logged-out": [
      "src/demos/effect-oak/auth/auth-server",
      "src/demos/effect-oak/auth/session"
    ],
    "src/demos/effect-oak/auth/logged-in": [
      "src/demos/effect-oak/auth/session"
    ],
    "src/demos/effect-oak/auth/auth-server": [
      "src/demos/effect-oak/auth/session"
    ],
    "src/demos/effect-oak/routing": ["src/demos/effect-oak/location"],
    "src/demos/effect-oak/route-transitions": ["src/demos/effect-oak/location"],
    "src/demos/effect-oak/view-transitions": ["src/demos/effect-oak/location"],
    "src/demos/effect-oak/personal-blog": ["src/demos/effect-oak/location"],
    "src/demos/effect-oak/routing/people": [
      "src/demos/effect-oak/routing/route"
    ],
    "src/demos/effect-oak/routing/files": [
      "src/demos/effect-oak/routing/route"
    ],
    "src/demos/effect-oak/embedding/widget": [
      "src/demos/effect-oak/embedding/port"
    ],
    "src/demos/effect-oak/web-components/fields": [
      "src/demos/effect-oak/web-components/elements"
    ]
  }
}
