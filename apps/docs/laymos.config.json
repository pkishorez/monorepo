{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts", "src/styles", "src/types.d.ts"],
  "fileModules": [
    "src/router.tsx",
    "src/start.ts",
    "src/server.ts",
    "src/components/not-found.tsx",
    "src/lib/theme.tsx"
  ],
  "rules": {
    "src/router.tsx": ["src/components"],
    "src/routes": ["src/lib", "src/demos"],
    "src/demos/opening-an-app/screens": ["src/demos/opening-an-app/story"],
    "src/demos/kabuki-routing/app": [
      "src/demos/kabuki-routing/routes",
      "src/demos/kabuki-routing/parts"
    ],
    "src/demos/kabuki-routing/app/sign-in": [
      "src/demos/kabuki-routing/app/capabilities"
    ]
  }
}
