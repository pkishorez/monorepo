{
  "name": "docs",
  "description": "The docs for every ke stack package, a kabuki start app published at docs.kishore.app.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp run --filter 'docs^...' build && portless run --force vp dev",
    "build": "vp build",
    "lint": "tsc --noEmit && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "test": "vitest run",
    "deploy:prod": "ALLOW_DEPLOY=true alchemy deploy --stage prod"
  },
  "dependencies": {
    "@kestack/devtools-kabuki": "workspace:*",
    "@kestack/kabuki": "workspace:*",
    "@kestack/web-platform": "workspace:*",
    "effect": "catalog:",
    "lenis": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/aws": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@mdx-js/rollup": "catalog:",
    "@shikijs/rehype": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "laymos": "workspace:*",
    "remark-gfm": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
