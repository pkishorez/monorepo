{
  "$schema": "./node_modules/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/routeTree.gen.ts"],
  "layers": {
    "engine": {
      "paths": ["src/engine"],
      "description": "Turns microphone audio and timed button presses into a transcript, and text back into speech; knows nothing about React or the page.",
      "moduleGraphs": {
        "engine": {
          "path": "src/engine",
          "description": "A session drives the microphone and the transcriber and folds words and injections into a transcript; speech models plug in under models. The synthesizer reads text aloud through Kokoro in a worker of its own.",
          "modules": {
            "transcript": {
              "exposed": true
            },
            "speech-protocol": {},
            "speech-worker": {
              "exposed": true
            },
            "transcriber": {},
            "microphone": {},
            "session": {
              "exposed": true
            },
            "models": {
              "exposed": true
            },
            "downloads": {},
            "synthesis-protocol": {},
            "synthesis-worker": {
              "exposed": true
            },
            "synthesizer": {
              "exposed": true
            }
          },
          "rules": {
            "session": ["microphone", "transcriber", "transcript"],
            "transcriber": ["speech-protocol", "transcript"],
            "speech-worker": ["speech-protocol", "models"],
            "speech-protocol": ["transcript"],
            "models": ["transcript", "downloads"],
            "synthesis-worker": ["synthesis-protocol", "downloads"],
            "synthesizer": ["synthesis-protocol"]
          }
        }
      }
    },
    "worker-entry": {
      "paths": ["src/speech.worker.ts", "src/speech-synthesis.worker.ts"],
      "description": "Starts the speech and synthesis worker programs inside Web Workers.",
      "modules": {
        "src/speech.worker.ts": {},
        "src/speech-synthesis.worker.ts": {}
      }
    },
    "client-features": {
      "paths": ["src/client/features"],
      "description": "The studio UI: model gate, recording controls, the settling transcript and reading it aloud, over the engine.",
      "moduleGraphs": {
        "studio": {
          "path": "src/client/features/studio",
          "description": "The workspace gates on a loaded model, then runs sessions and renders their transcript.",
          "modules": {
            "workspace": {
              "exposed": true
            },
            "engine-runtime": {},
            "model-gate": {},
            "transcript-view": {},
            "context-buttons": {},
            "debug-panel": {},
            "read-aloud": {}
          },
          "rules": {
            "workspace": [
              "engine-runtime",
              "model-gate",
              "transcript-view",
              "context-buttons",
              "debug-panel"
            ],
            "engine-runtime": ["context-buttons"],
            "transcript-view": ["context-buttons", "read-aloud"],
            "debug-panel": ["context-buttons"]
          }
        }
      }
    },
    "server-entry": {
      "paths": ["src/server.ts"],
      "description": "Serves the page from the Worker.",
      "modules": {
        "src/server.ts": {}
      }
    },
    "web-entry": {
      "paths": ["src/router.tsx"],
      "description": "Creates the framework router over the generated route tree.",
      "modules": {
        "src/router.tsx": {}
      }
    },
    "routes": {
      "paths": ["src/routes"],
      "description": "Owns URLs and document composition while mounting the studio.",
      "modules": {
        "src/routes/__root.tsx": {
          "exposed": true
        },
        "src/routes/page.tsx": {
          "exposed": true
        }
      }
    }
  },
  "layerGraphs": {
    "engine": {
      "description": "The worker host starts the engine's worker program; the engine depends on nothing above it.",
      "rules": {
        "worker-entry": ["engine"],
        "engine": []
      }
    },
    "web": {
      "description": "The router starts pages; pages mount the studio; the studio drives the engine.",
      "rules": {
        "web-entry": ["routes"],
        "routes": ["client-features"],
        "client-features": ["engine"],
        "server-entry": []
      }
    }
  }
}
