{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "storiesPath": "stories",
  "ignoredPaths": ["src/styles.css"],
  "fileModules": [
    "src/routes.ts",
    "src/app.tsx",
    "src/document.tsx",
    "src/loaders.server.ts",
    "src/layer.server.ts"
  ],
  "rules": {
    "src/app.tsx": ["src/pages", "src/shell", "src/routes.ts"],
    "src/document.tsx": ["src/theme"],
    "src/loaders.server.ts": ["src/backend", "src/session", "src/routes.ts"],
    "src/layer.server.ts": ["src/backend"],
    "src/pages": ["src/parts", "src/session", "src/routes.ts"],
    "src/shell": ["src/parts", "src/theme", "src/routes.ts"],
    "src/parts": ["src/routes.ts"]
  }
}
