{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/client/styles.css", "src/env.d.ts"],
  "fileModules": [
    "src/client/app.tsx",
    "src/client/document.tsx",
    "src/server/loaders.server.ts"
  ],
  "rules": {
    "src/shared/pages": [
      "src/apis/access",
      "src/apis/hello-http",
      "src/apis/hello-rpc",
      "src/apis/pocket",
      "src/replicas/pocket"
    ],
    "src/apis/hello-http": ["src/apis/access"],
    "src/apis/hello-rpc": ["src/apis/access"],
    "src/server/loaders.server.ts": ["src/shared/pages"],
    "src/client/app.tsx": [
      "src/apis/hello-http",
      "src/apis/hello-rpc",
      "src/apis/pocket",
      "src/shared/pages",
      "src/client/document.tsx",
      "src/client/views"
    ],
    "src/client/document.tsx": ["src/client/components"],
    "src/client/views": [
      "src/apis/access",
      "src/apis/hello-http",
      "src/apis/hello-rpc",
      "src/shared/pages",
      "src/client/components"
    ],
    "src/client/components": ["src/shared/pages"],
    "src/infra": ["src/apis/pocket/storage"],
    "src/apis/pocket/contract": ["src/apis/pocket/domain"],
    "src/apis/pocket/storage": ["src/apis/pocket/domain"],
    "src/apis/pocket/ledger": [
      "src/apis/pocket/contract",
      "src/apis/pocket/domain",
      "src/apis/pocket/storage"
    ],
    "src/apis/pocket/client": [
      "src/apis/pocket/contract",
      "src/apis/pocket/domain"
    ],
    "src/shared/pages/replica": ["src/shared/pages/metadata"],
    "src/replicas/pocket/definition": ["src/apis/pocket"],
    "src/replicas/pocket/build": [
      "src/apis/pocket",
      "src/replicas/pocket/definition"
    ],
    "src/replicas/pocket/actions": [
      "src/apis/pocket",
      "src/replicas/pocket/definition"
    ]
  }
}
