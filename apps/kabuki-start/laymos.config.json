{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/client/styles.css"],
  "fileModules": [
    "src/client/app.tsx",
    "src/client/document.tsx",
    "src/server/loaders.server.ts"
  ],
  "rules": {
    "src/client": ["src/shared"],
    "src/client/app.tsx": [
      "src/client/pages",
      "src/client/components",
      "src/client/document.tsx"
    ],
    "src/client/document.tsx": ["src/client/components"],
    "src/client/pages": ["src/client/components"],
    "src/server": ["src/shared"],
    "src/server/loaders.server.ts": ["src/server/backend"],
    "src/shared/pages": ["src/shared/data"]
  }
}
