{
  "name": "voice-anchors",
  "description": "Browser-only speech-to-text demo where button presses inject context at the exact moment they were spoken, transcribed on WebGPU with no server.",
  "version": "0.0.0",
  "dependencies": {
    "@effect/platform-browser": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "kui-toolkit": "workspace:*",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "use-effect-ts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "laymos": "workspace:*",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "private": true,
  "scripts": {
    "build": "vp build",
    "dev": "portless run --force alchemy dev",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts tests"
  },
  "sideEffects": false,
  "type": "module"
}
