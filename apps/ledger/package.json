{
  "name": "ledger",
  "description": "Ledger, published at kstack.kishore.app: one app that writes down the money you spend and earn and shows where it goes, run by keys on a desktop and by gestures on a phone. The pages, the Worker serving its API, the infra and the PWA, deployed in one go.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "portless run --force alchemy dev",
    "build": "vp build",
    "preview": "vp preview",
    "lint": "tsc --noEmit && pnpm lint:laymos && pnpm lint:colors",
    "lint:colors": "node scripts/colors.ts",
    "lint:laymos": "laymos lint",
    "deploy:prod": "ALLOW_DEPLOY=true alchemy deploy --stage prod",
    "brand": "node scripts/brand.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@kstackz/auth-toolkit": "workspace:*",
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@kstackz/use-gesture": "workspace:*",
    "@kstackz/use-keys": "workspace:*",
    "@kstackz/web-platform": "workspace:*",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "effect": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "laymos": "workspace:*",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
