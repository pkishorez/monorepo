{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": [],
  "fileModules": ["src/cloud/deploy/worker.server.ts"],
  "rules": {
    "src/cloud/client": ["src/cloud/contract"],
    "src/cloud/serve": ["src/cloud/contract", "src/cloud/origins"],
    "src/cloud/serve/registry": ["src/cloud/serve/storage"],
    "src/cloud/deploy": ["src/cloud/serve"],
    "src/machine": [
      "src/cloud/contract",
      "src/cloud/client",
      "src/cloud/origins"
    ],
    "src/machine/actor-heartbeat": ["src/machine/capabilities"],
    "src/code/api": ["src/cloud/contract", "src/cloud/client"],
    "src/code/api/contract": ["src/code/api/records"],
    "src/code/api/client": ["src/code/api/contract", "src/code/api/records"],
    "src/code/engine": ["src/code/api/records"],
    "src/code/engine/actor-code": [
      "src/code/engine/capabilities",
      "src/code/engine/engine-raw"
    ],
    "src/code/engine/services": ["src/code/engine/capabilities"],
    "src/code/read": [
      "src/code/api/contract",
      "src/code/api/records",
      "src/code/engine"
    ],
    "src/cli/serve": ["src/machine", "src/code"],
    "src/cli/dev": ["src/cli/serve"]
  }
}
