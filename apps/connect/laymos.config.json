{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/connection/tests/fixtures"],
  "fileModules": [],
  "rules": {
    "*": ["src/cloud/contract"],
    "src/cloud/worker/registry": ["src/cloud/worker/storage"],
    "src/connection": ["src/cloud/contract", "src/cloud/client"],
    "src/connection/actor-connection/actor-online": [
      "src/connection/actor-connection/capabilities"
    ],
    "src/connection/actor-connection/actor-online/actor-tunnel": [
      "src/connection/actor-connection/actor-online/capabilities"
    ],
    "src/connection/actor-connection/actor-plugins": [
      "src/connection/actor-connection/capabilities"
    ],
    "src/plugins/code/api": ["src/plugins/code/records", "src/cloud/contract"],
    "src/plugins/code/api/client": ["src/plugins/code/api/contract"],
    "src/plugins/code/engine": ["src/plugins/code/records"],
    "src/plugins/code/engine/actor-code": [
      "src/plugins/code/engine/capabilities",
      "src/plugins/code/engine/engine-raw"
    ],
    "src/plugins/code/engine/actor-code/checks": [
      "src/plugins/code/engine/actor-code/actor-session"
    ],
    "src/plugins/code/engine/services": ["src/plugins/code/engine/capabilities"]
  }
}
