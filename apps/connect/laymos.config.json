{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "ignoredPaths": ["src/connection/cli/tests/fixtures"],
  "fileModules": [],
  "rules": {
    "src/cloud": ["src/heartbeat"],
    "src/cloud/client": ["src/cloud/app-api"],
    "src/cloud/worker": ["src/cloud/app-api", "src/connection/link"],
    "src/cloud/worker/app": ["src/cloud/worker/store"],
    "src/cloud/worker/heartbeat": ["src/cloud/worker/store"],
    "src/connection/cli": ["src/heartbeat", "src/connection/link"],
    "src/connection/cli/actor-identity/actor-connection": [
