    ],
    "src/connection/cli/actor-identity/services/control": [
      "src/connection/cli/actor-identity/capabilities"
    ],
    "src/connection/plugins/code/api": [
      "src/connection/link",
      "src/connection/plugins/code/records"
    ],
    "src/connection/plugins/code/serve": [
      "src/connection/plugins/code/api",
      "src/connection/plugins/code/engine",
      "src/connection/plugins/code/records"
    ],
    "src/connection/plugins/code/api/client": [
      "src/connection/plugins/code/api/contract"
    ],
    "src/connection/plugins/code/engine": [
      "src/connection/plugins/code/records"
    ],
    "src/connection/plugins/code/engine/actor-code": [
      "src/connection/plugins/code/engine/capabilities",
      "src/connection/plugins/code/engine/engine-raw"
    ],
    "src/connection/plugins/code/engine/actor-code/checks": [
      "src/connection/plugins/code/engine/actor-code/actor-session"
    ],
    "src/connection/plugins/code/engine/services": [
      "src/connection/plugins/code/engine/capabilities"
    ]
  }
