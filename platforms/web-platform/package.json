{
  "name": "@kstackz/web-platform",
  "version": "0.0.0",
  "private": false,
  "description": "The Web Platform: a web app from one config, as a PWA on TanStack Start with its Theme, its APIs on a cloud or a device Backend, several Accounts with one Session each, the screens before sign-in, and the server; plus the components, input, forms and Recipes to build screens with.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "platforms/web-platform"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/shadow-dom": "./src/components/lib/shadow-dom.tsx",
    "#lib/*": "./src/components/lib/*.ts",
    "#hooks/*": "./src/components/hooks/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/*.css": "./dist/theme/css/*.css",
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./components/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./components/viewers/*": {
      "types": "./dist/components/viewers/*/index.d.ts",
      "default": "./dist/components/viewers/*/index.js"
    },
    "./components/hooks/*": {
      "types": "./dist/components/hooks/*.d.ts",
      "default": "./dist/components/hooks/*.js"
    },
    "./components/utils": {
      "types": "./dist/components/lib/utils.d.ts",
      "default": "./dist/components/lib/utils.js"
    },
    "./components/lucide": {
      "types": "./dist/components/lib/lucide.d.ts",
      "default": "./dist/components/lib/lucide.js"
    },
    "./components/motion": {
      "types": "./dist/components/lib/motion.d.ts",
      "default": "./dist/components/lib/motion.js"
    },
    "./components/scroll-styles": {
      "types": "./dist/components/lib/scrollStyles.d.ts",
      "default": "./dist/components/lib/scrollStyles.js"
    },
    "./components/shadow-dom": {
      "types": "./dist/components/lib/shadow-dom.d.ts",
      "default": "./dist/components/lib/shadow-dom.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./recipes/*": {
      "types": "./dist/recipes/*/index.d.ts",
      "default": "./dist/recipes/*/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/server": {
      "types": "./dist/client/server.d.ts",
      "default": "./dist/client/server.js"
    },
    "./pwa": {
      "types": "./dist/pwa/index.d.ts",
      "default": "./dist/pwa/index.js"
    },
    "./pwa/vite": {
      "types": "./dist/pwa/vite/index.d.ts",
      "default": "./dist/pwa/vite/index.js"
    },
    "./pwa/splash": {
      "types": "./dist/pwa/splash/index.d.ts",
      "default": "./dist/pwa/splash/index.js"
    },
    "./pwa/worker": {
      "types": "./dist/pwa/worker/index.d.ts",
      "default": "./dist/pwa/worker/index.js"
    },
    "./pwa/client": {
      "types": "./dist/pwa/client/index.d.ts",
      "default": "./dist/pwa/client/index.js"
    },
    "./pwa/extras": {
      "types": "./dist/pwa/extras/index.d.ts",
      "default": "./dist/pwa/extras/index.js"
    },
    "./pwa/rpc/worker": {
      "types": "./dist/pwa/rpc/worker/index.d.ts",
      "default": "./dist/pwa/rpc/worker/index.js"
    },
    "./pwa/rpc/client": {
      "types": "./dist/pwa/rpc/client/index.d.ts",
      "default": "./dist/pwa/rpc/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "addcomp": "./scripts/addcomp.sh",
    "build": "vp pack && cp -R src/theme/css dist/theme/",
    "dev": "cosmos",
    "fmt": "vp fmt",
    "lint": "vp check && tsc --noEmit && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@shadcn/react": "catalog:",
    "@shikijs/langs": "catalog:",
    "@shikijs/themes": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@uiw/codemirror-theme-xcode": "catalog:",
    "@uiw/react-codemirror": "catalog:",
    "@uiw/react-json-view": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-day-picker": "catalog:",
    "react-markdown": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "remark-gfm": "catalog:",
    "shadcn": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@kstackz/auth-toolkit": "workspace:*",
    "@kstackz/platform-toolkit": "workspace:*",
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@kstackz/use-gesture": "workspace:*",
    "@kstackz/use-keys": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "react": "catalog:",
    "react-cosmos": "catalog:",
    "react-cosmos-plugin-vite": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:typescript6",
    "use-effect-ts": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@kstackz/auth-toolkit": "workspace:*",
    "@kstackz/platform-toolkit": "workspace:*",
    "@kstackz/rpc-toolkit": "workspace:*",
    "@kstackz/std-toolkit": "workspace:*",
    "@kstackz/use-gesture": "workspace:*",
    "@kstackz/use-keys": "workspace:*",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "effect": "^4.0.0",
    "laymos": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "use-effect-ts": "workspace:*",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@kstackz/use-keys": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "laymos": {
      "optional": true
    },
    "use-effect-ts": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
