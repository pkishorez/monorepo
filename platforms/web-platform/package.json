{
  "name": "@kestack/web-platform",
  "version": "0.0.6",
  "private": false,
  "description": "The way to build a kestack app on Kabuki Start in one go: its UI, its PWA, Recipes for whole features, and the app's Document and deploy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "platforms/web-platform"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "imports": {
    "#components/*": "./src/ui/components/*.tsx",
    "#kit/shadow-dom": "./src/ui/components/kit/shadow-dom.tsx",
    "#kit/*": "./src/ui/components/kit/*.ts",
    "#hooks/*": "./src/ui/components/hooks/*.ts"
  },
  "exports": {
    "./ui/theme": {
      "types": "./dist/ui/theme/index.d.ts",
      "default": "./dist/ui/theme/index.js"
    },
    "./ui/theme/*.css": "./dist/ui/theme/css/*.css",
    "./ui/components/utils": {
      "types": "./dist/ui/components/kit/class-names.d.ts",
      "default": "./dist/ui/components/kit/class-names.js"
    },
    "./ui/components/scroll-styles": {
      "types": "./dist/ui/components/kit/scroll-styles.d.ts",
      "default": "./dist/ui/components/kit/scroll-styles.js"
    },
    "./ui/components/shadow-dom": {
      "types": "./dist/ui/components/kit/shadow-dom.d.ts",
      "default": "./dist/ui/components/kit/shadow-dom.js"
    },
    "./ui/components/hooks/*": {
      "types": "./dist/ui/components/hooks/*.d.ts",
      "default": "./dist/ui/components/hooks/*.js"
    },
    "./ui/components/*": {
      "types": "./dist/ui/components/*.d.ts",
      "default": "./dist/ui/components/*.js"
    },
    "./ui/viewers/*": {
      "types": "./dist/ui/viewers/*/index.d.ts",
      "default": "./dist/ui/viewers/*/index.js"
    },
    "./ui/form": {
      "types": "./dist/ui/form/index.d.ts",
      "default": "./dist/ui/form/index.js"
    },
    "./ui/input": {
      "types": "./dist/ui/input/index.d.ts",
      "default": "./dist/ui/input/index.js"
    },
    "./pwa": {
      "types": "./dist/pwa/prompts/index.d.ts",
      "default": "./dist/pwa/prompts/index.js"
    },
    "./pwa/splash": {
      "types": "./dist/pwa/prompts/splash/index.d.ts",
      "default": "./dist/pwa/prompts/splash/index.js"
    },
    "./pwa/vite": {
      "types": "./dist/pwa/engine/vite/index.d.ts",
      "default": "./dist/pwa/engine/vite/index.js"
    },
    "./pwa/worker": {
      "types": "./dist/pwa/engine/worker/index.d.ts",
      "default": "./dist/pwa/engine/worker/index.js"
    },
    "./pwa/rpc/worker": {
      "types": "./dist/pwa/engine/worker/rpc/index.d.ts",
      "default": "./dist/pwa/engine/worker/rpc/index.js"
    },
    "./pwa/rpc/client": {
      "types": "./dist/pwa/engine/page/rpc/index.d.ts",
      "default": "./dist/pwa/engine/page/rpc/index.js"
    },
    "./recipes/*": {
      "types": "./dist/recipes/*/index.d.ts",
      "default": "./dist/recipes/*/index.js"
    },
    "./app/document": {
      "types": "./dist/app/document/index.d.ts",
      "default": "./dist/app/document/index.js"
    },
    "./app/vite": {
      "types": "./dist/app/vite/index.d.ts",
      "default": "./dist/app/vite/index.js"
    },
    "./app/alchemy": {
      "types": "./dist/app/alchemy/index.d.ts",
      "default": "./dist/app/alchemy/index.js"
    }
  },
  "scripts": {
    "addcomp": "./scripts/addcomp.sh",
    "build": "vp pack && cp -R src/ui/theme/css dist/ui/theme/",
    "dev": "cosmos",
    "fmt": "vp fmt",
    "lint": "vp check && tsc --noEmit && pnpm lint:laymos",
    "lint:laymos": "laymos lint",
    "test": "vitest run",
    "stories": "laymos stories"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@shadcn/react": "catalog:",
    "@shikijs/langs": "catalog:",
    "@shikijs/themes": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@uiw/codemirror-theme-xcode": "catalog:",
    "@uiw/react-codemirror": "catalog:",
    "@uiw/react-json-view": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-day-picker": "catalog:",
    "react-markdown": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "remark-gfm": "catalog:",
    "shadcn": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@kestack/auth-toolkit": "workspace:*",
    "@kestack/kabuki": "workspace:*",
    "@kestack/use-gesture": "workspace:*",
    "@kestack/use-keys": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "laymos": "workspace:*",
    "react": "catalog:",
    "react-cosmos": "catalog:",
    "react-cosmos-plugin-vite": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:typescript6",
    "use-effect-ts": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@kestack/auth-toolkit": "workspace:*",
    "@kestack/use-gesture": "workspace:*",
    "@kestack/use-keys": "workspace:*",
    "effect": "^4.0.0",
    "@kestack/kabuki": "workspace:*",
    "laymos": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "use-effect-ts": "workspace:*",
    "vite": "^8.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.84"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "@kestack/use-keys": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "@kestack/kabuki": {
      "optional": true
    },
    "laymos": {
      "optional": true
    },
    "use-effect-ts": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    }
  }
}
