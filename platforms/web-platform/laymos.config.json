      }
    },
    "server": {
      "paths": ["src/server"],
      "description": "A web app's server: one fetch handler for its pages and its /rpc API, which the app answers itself, and the stages alchemy deploys it to. Plain Request and Response, so it runs on Cloudflare as anywhere.",
      "moduleGraphs": {
        "server": {
          "description": "index.ts is the door; serve answers each API on the cloud Backend over worker, which routes the rest to the pages; stage names where each stage deploys.",
          "path": "src/server",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "worker": {},
            "stage": {},
            "serve": {}
          },
          "rules": {
            "index.ts": ["serve", "worker", "stage"],
            "serve": ["worker"]
          }
        }
      }
    },
    "app": {
      "paths": ["src/app"],
      "description": "The Web Platform's door: createApp turns one config into a web app, the browser as its Host, the Theme, the PWA, the Gate's screens and the named sign-in dialog, on the Platform Toolkit.",
      "moduleGraphs": {
        "app": {
          "description": "index.ts is the door; app.tsx assembles the app over host.ts.",
          "path": "src/app",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "app.tsx": {},
            "host.ts": {}
          },
          "rules": {
            "index.ts": ["app.tsx", "host.ts"],
            "app.tsx": ["host.ts"]
          }
        }
      }
    }
  },
  "layerGraphs": {
    "web-platform": {
      "description": "Bottom to top: the Theme, feedback and input; components; forms and recipes on components; the client on them; the PWA plugs into the client; the app door over the client, the PWA and the recipes; the server stands alone.",
