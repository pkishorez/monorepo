          "exposed": true
        },
        "src/pwa/browser/subscription-ref.ts": {
          "exposed": true
        }
      }
    },
    "pwa-vite": {
      "paths": ["src/pwa/vite"],
      "description": "PWA: The pwa() Vite plugin: manifest, Precache list, Build ID, worker build, headers.",
      "moduleGraphs": {
        "vite": {
          "description": "pwa() wires three Vite plugins: build runs the production pipeline, client-module serves the Build ID it leaves to pages, dev serves the dev worker; build and dev share Precache selection and the worker bundle.",
          "path": "src/pwa/vite",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "vite.ts": {},
            "build": {},
            "client-module": {},
            "dev": {},
            "precache": {},
            "worker-bundle": {}
          },
          "rules": {
            "index.ts": ["vite.ts"],
            "vite.ts": ["build", "client-module", "dev"],
            "build": ["precache", "worker-bundle"],
            "client-module": ["build"],
            "dev": ["worker-bundle"]
          }
        }
      }
    },
    "pwa-worker": {
      "paths": ["src/pwa/worker"],
      "description": "PWA: Service worker runtime: lifecycle, Precache, requests (pages and Strategies), commands, messages.",
      "modules": {
        "src/pwa/worker": {
          "exposed": true
        }
      }
    },
    "pwa-client": {
      "paths": ["src/pwa/client"],
      "description": "PWA: Client-side Effect service for the core: registration, the one status stream, the activate command, Runtime Cache clearing.",
      "modules": {
        "src/pwa/client": {
          "exposed": true
        }
      }
    },
    "pwa-react": {
      "paths": ["src/pwa/react"],
      "description": "PWA: React bindings over the client service, pwaHead(), and the ready-made Update Prompt.",
      "modules": {
        "src/pwa/react": {
          "exposed": true
        }
      }
    },
    "pwa-extras": {
      "paths": ["src/pwa/extras"],
      "description": "PWA: Optional page features the core never needs: Install Prompt, online state, display mode, storage persistence. Each holds its service, hook and UI.",
      "moduleGraphs": {
        "extras": {
          "description": "Standalone extras behind one door; each builds its own page-wide service on first use.",
          "path": "src/pwa/extras",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "install": {},
            "online": {},
            "display-mode": {},
            "storage": {},
            "lazy-service": {}
          },
          "rules": {
            "index.ts": ["install", "online", "display-mode", "storage"],
            "install": ["display-mode", "lazy-service"],
            "online": ["lazy-service"],
            "display-mode": ["lazy-service"],
            "storage": ["lazy-service"]
          }
        }
      }
    },
    "pwa-rpc": {
      "paths": ["src/pwa/rpc"],
      "description": "PWA: Worker RPC: Effect RPC between the Worker Server and each Tab Client.",
      "moduleGraphs": {
        "rpc": {
          "description": "Worker Server and RPC client sharing one Build ID handshake.",
          "path": "src/pwa/rpc",
          "modules": {
            "worker": {
              "exposed": true
            },
            "client": {
              "exposed": true
            },
            "handshake": {}
          },
          "rules": {
            "worker": ["handshake"],
            "client": ["handshake"]
          }
        }
      }
