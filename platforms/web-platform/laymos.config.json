    "client": {
      "paths": ["src/client"],
      "description": "The opinionated way in on TanStack Start: the root document with its plugins, and the Theme read on the server.",
      "moduleGraphs": {
        "client": {
          "description": "index.ts is the door; server.ts the server-only door; root is the root document and its plugins; theme reads the Theme's cookie on the server.",
          "path": "src/client",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "root": {},
            "theme": {},
            "server.ts": {
              "exposed": true
            }
          },
          "rules": {
            "index.ts": ["root", "theme"],
            "root": [],
            "server.ts": ["theme"]
          }
        }
      }
    },
    "pwa-shared": {
      "paths": ["src/pwa/shared"],
      "description": "PWA: The words of the problem: Build ID, cache names, manifest, Strategy rules, config, commands. Pure; no I/O.",
      "modules": {
        "src/pwa/shared/build": {
          "shared": true,
          "exposed": true
