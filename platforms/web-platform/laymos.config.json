{
  "$schema": "../../devtools/laymos/schema.json",
  "sourceRoots": ["src"],
  "layers": {
    "theme": {
      "paths": ["src/theme"],
      "description": "The Theme: design tokens and CSS, the light/dark choice kept in a cookie, the script that sets it before paint, and the Status Bar Surface. Knows nothing above it.",
      "modules": {
        "src/theme": {
          "exposed": true
        }
      }
    },
    "feedback": {
      "paths": ["src/feedback"],
      "description": "What an action sounds like: short tones the browser makes as they play, the web's twin of expo-platform's haptics.",
      "modules": {
        "src/feedback": {
          "exposed": true
        }
      }
    },
    "input-device": {
      "paths": ["src/input/device"],
      "description": "What the device can be driven by, keyboard or touch or both: marked on <html> before the first paint, and live as useDevice.",
      "modules": {
        "src/input/device": {
          "exposed": true
        }
      }
    },
    "input-gesture-zones": {
      "paths": ["src/input/gesture/zones"],
      "description": "Web zones \u2014 the browser as the touch source: a GestureProvider feeds the core every touch and pen pointer on the page and holds the browser back on each zone, leaving Native Scrolls their touches; GestureZones are DOM elements; useGesture hands each enabled listener every finger as motion values. It never says what a Gesture means.",
      "moduleGraphs": {
        "zones": {
          "description": "touch-input listens to the page, holds the browser back on each zone and says how zones nest in the DOM; zone runs the core's provider over it and puts it together for React with motion values. Whether a release clicks is the browser's call unless a listener prevents it",
          "path": "src/input/gesture/zones",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "zone": {},
            "touch-input": {}
          },
          "rules": {
            "index.ts": ["zone"],
            "zone": ["touch-input"]
          }
        }
      }
    },
    "input-gesture-recognizers": {
      "paths": ["src/input/gesture/recognizers"],
      "description": "Web recognizers \u2014 one generic meaning read from a Gesture, such as a Swipe: Possible, then Tracking with live motion values for feedback, then a Commit or a Cancel, decided by the core's rules. They never know about each other.",
      "moduleGraphs": {
        "recognizers": {
          "description": "Each Recognizer reads Pointers from useGesture on its own.",
          "path": "src/input/gesture/recognizers",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "swipe": {}
          },
          "rules": {
            "index.ts": ["swipe"]
          }
        }
      }
    },
    "input-gesture-patterns": {
      "paths": ["src/input/gesture/patterns"],
      "description": "Web patterns \u2014 purpose-built touch behaviours an app uses as they are, built from Recognizers, giving exactly the motion values their UI needs and settling themselves.",
      "moduleGraphs": {
        "patterns": {
          "description": "Each Pattern stands alone on the Recognizers.",
          "path": "src/input/gesture/patterns",
          "modules": {
            "index.ts": {
              "exposed": true
            },
            "sidebar": {},
            "pull-to-refresh": {}
          },
          "rules": {
            "index.ts": ["sidebar", "pull-to-refresh"]
          }
        }
      }
    },
    "input-gesture-entry": {
      "paths": ["src/input/gesture/index.ts"],
      "description": "Gestures' door: the provider, zone and useGesture, the Recognizers and the Patterns, for apps in a browser.",
      "modules": {
        "src/input/gesture/index.ts": {
          "exposed": true
        }
      }
    },
    "input": {
      "paths": ["src/input/index.ts"],
      "description": "How a person drives the app: the device and gestures, behind one door, the package's ./input.",
      "modules": {
        "src/input/index.ts": {
          "exposed": true
        }
      }
    },
    "components-lib": {
      "paths": ["src/components/lib"],
      "description": "Utilities the components share: cn, the icons, motion, scroll styles, and the shadow DOM host.",
      "modules": {
        "src/components/lib/lucide.ts": {
          "exposed": true
        },
        "src/components/lib/motion.ts": {
          "exposed": true
