        }
      }
    },
    "recipes": {
      "paths": ["src/recipes"],
      "description": "Whole interactions, ready to use, the same on the web as their twins in expo-platform: the Frame with its Sidebar, the Thumb Picker, the Swipe Row, the keys of a Binding, the Local Sign-In, the Account Switcher, the screens before an Account is open. parts are what recipes share and never expose. A recipe knows nothing of sign-in.",
      "modules": {
        "src/recipes/account-switcher": {
          "exposed": true
        },
        "src/recipes/frame": {
          "exposed": true
