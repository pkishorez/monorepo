{
  "name": "@kstackz/expo-platform",
  "version": "0.0.0",
  "private": false,
  "description": "UI, theme and haptics for native apps built with Expo: owned Panel UI components on Uniwind, styled with web-platform's tokens.",
  "keywords": [
    "expo",
    "react-native",
    "uniwind",
    "panel-ui",
    "haptics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkishorez/monorepo",
    "directory": "platforms/expo-platform"
  },
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "src/"
  ],
  "exports": {
    "./theme": "./src/theme/index.ts",
    "./theme.css": "./src/theme/theme.css",
    "./feedback": "./src/feedback/index.ts",
    "./input": "./src/input/index.ts",
    "./components/parts/*": null,
    "./components/*": "./src/components/*.tsx",
    "./recipes/*": "./src/recipes/*/index.ts"
  },
  "scripts": {
    "add-panelui": "node scripts/add-panelui.mjs",
    "fmt": "vp fmt",
    "lint": "vp check && pnpm lint:tsc && laymos lint",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react-native": "catalog:",
    "@kstackz/use-gesture": "workspace:*",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "peerDependencies": {
    "expo-blur": "57.0.3",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.2"
  },
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "expo": "catalog:",
    "expo-blur": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "laymos": "workspace:*",
    "panelui-cli": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-worklets": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "uniwind": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
